<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    BYH / Ivory Jade

    The palette is intentionally semantic. Windows and controls consume brush
    keys rather than raw colors so a future theme can replace this dictionary
    without rewriting every view.
  -->
  <Styles.Resources>
    <ResourceDictionary>
      <!-- Foundations -->
      <Color x:Key="ByhColorBackground">#FFFFF7EE</Color>
      <Color x:Key="ByhColorSurface">#FFFFFDF8</Color>
      <Color x:Key="ByhColorSurfaceSecondary">#FFF6F1E6</Color>
      <Color x:Key="ByhColorSurfaceSelected">#FFEEF3DE</Color>

      <!-- Brand -->
      <Color x:Key="ByhColorPrimary">#FF667731</Color>
      <Color x:Key="ByhColorPrimaryHover">#FF4C5721</Color>
      <Color x:Key="ByhColorPrimarySoft">#FFDDE8B9</Color>
      <Color x:Key="ByhColorJadeAccent">#FF8FAE5A</Color>
      <Color x:Key="ByhColorAccent">#FF6B4B2A</Color>
      <Color x:Key="ByhColorAccentHover">#FF513317</Color>
      <Color x:Key="ByhColorAccentSoft">#FFF0DDC7</Color>
      <Color x:Key="ByhColorGold">#FFD5A86A</Color>

      <!-- Typography -->
      <Color x:Key="ByhColorTextPrimary">#FF4A301E</Color>
      <Color x:Key="ByhColorTextSecondary">#FF7A5B43</Color>
      <Color x:Key="ByhColorTextPlaceholder">#FFA28772</Color>
      <Color x:Key="ByhColorTextOnPrimary">#FFFFFFFF</Color>

      <!-- Structure -->
      <Color x:Key="ByhColorBorder">#FFEAD8B8</Color>
      <Color x:Key="ByhColorBorderSubtle">#FFF0E4D3</Color>
      <Color x:Key="ByhColorDisabled">#FFDCD2C4</Color>

      <!-- Feedback -->
      <Color x:Key="ByhColorSuccess">#FF667731</Color>
      <Color x:Key="ByhColorSuccessSoft">#FFEDF2DC</Color>
      <Color x:Key="ByhColorWarning">#FFA76524</Color>
      <Color x:Key="ByhColorWarningSoft">#FFF7E7CF</Color>
      <Color x:Key="ByhColorError">#FFA44E3F</Color>
      <Color x:Key="ByhColorErrorSoft">#FFF5DEDA</Color>
      <Color x:Key="ByhColorInfo">#FF55737A</Color>
      <Color x:Key="ByhColorInfoSoft">#FFDFEAEC</Color>
      <!-- R54 v2: pink for entry-tag (annotation) badges — distinct from the
           olive custom-tab badges, the gold auto-group badge, and every
           semantic feedback color. A muted rose so it reads as "label/annotation"
           without clashing with the warm ivory palette. -->
      <Color x:Key="ByhColorPink">#FFC26B8A</Color>
      <Color x:Key="ByhColorPinkSoft">#FFF6E0E8</Color>
      <!-- REQ-019: focus color tuned to the jade reference (#8FAE5A) so the
           focus ring harmonizes with the refreshed ivory/champagne palette. -->
      <Color x:Key="ByhColorFocus">#FF8FAE5A</Color>

      <!-- Keep Fluent controls (checkboxes, toggles, progress) on-brand.
           REQ-019 keys the ramp directly to the reference's champagne pair:
           #E8C89A for the lit face and #D5A86A for its shaded edge. The light
           stops approach Cream, while dark stops retain enough bronze depth
           for pressed states and controls rendered on pale surfaces. -->
      <Color x:Key="SystemAccentColor">#FFE8C89A</Color>
      <Color x:Key="SystemAccentColorLight1">#FFF3DCBA</Color>
      <Color x:Key="SystemAccentColorLight2">#FFFFF0D8</Color>
      <Color x:Key="SystemAccentColorLight3">#FFFFF8EC</Color>
      <Color x:Key="SystemAccentColorDark1">#FFD5A86A</Color>
      <Color x:Key="SystemAccentColorDark2">#FFB77B37</Color>
      <Color x:Key="SystemAccentColorDark3">#FF8C5A28</Color>

      <!-- Public semantic brushes -->
      <SolidColorBrush x:Key="ByhBackgroundBrush" Color="{StaticResource ByhColorBackground}" />
      <SolidColorBrush x:Key="ByhSurfaceBrush" Color="{StaticResource ByhColorSurface}" />
      <SolidColorBrush x:Key="ByhSurfaceSecondaryBrush" Color="{StaticResource ByhColorSurfaceSecondary}" />
      <SolidColorBrush x:Key="ByhSurfaceSelectedBrush" Color="{StaticResource ByhColorSurfaceSelected}" />
      <SolidColorBrush x:Key="ByhPrimaryBrush" Color="{StaticResource ByhColorPrimary}" />
      <SolidColorBrush x:Key="ByhPrimaryHoverBrush" Color="{StaticResource ByhColorPrimaryHover}" />
      <SolidColorBrush x:Key="ByhPrimarySoftBrush" Color="{StaticResource ByhColorPrimarySoft}" />
      <SolidColorBrush x:Key="ByhJadeAccentBrush" Color="{StaticResource ByhColorJadeAccent}" />
      <SolidColorBrush x:Key="ByhAccentBrush" Color="{StaticResource ByhColorAccent}" />
      <SolidColorBrush x:Key="ByhAccentHoverBrush" Color="{StaticResource ByhColorAccentHover}" />
      <SolidColorBrush x:Key="ByhAccentSoftBrush" Color="{StaticResource ByhColorAccentSoft}" />
      <SolidColorBrush x:Key="ByhGoldBrush" Color="{StaticResource ByhColorGold}" />
      <SolidColorBrush x:Key="ByhTextPrimaryBrush" Color="{StaticResource ByhColorTextPrimary}" />
      <SolidColorBrush x:Key="ByhTextSecondaryBrush" Color="{StaticResource ByhColorTextSecondary}" />
      <SolidColorBrush x:Key="ByhTextPlaceholderBrush" Color="{StaticResource ByhColorTextPlaceholder}" />
      <SolidColorBrush x:Key="ByhTextOnPrimaryBrush" Color="{StaticResource ByhColorTextOnPrimary}" />
      <SolidColorBrush x:Key="ByhBorderBrush" Color="{StaticResource ByhColorBorder}" />
      <SolidColorBrush x:Key="ByhBorderSubtleBrush" Color="{StaticResource ByhColorBorderSubtle}" />
      <SolidColorBrush x:Key="ByhDisabledBrush" Color="{StaticResource ByhColorDisabled}" />
      <SolidColorBrush x:Key="ByhSuccessBrush" Color="{StaticResource ByhColorSuccess}" />
      <SolidColorBrush x:Key="ByhSuccessSoftBrush" Color="{StaticResource ByhColorSuccessSoft}" />
      <SolidColorBrush x:Key="ByhWarningBrush" Color="{StaticResource ByhColorWarning}" />
      <SolidColorBrush x:Key="ByhWarningSoftBrush" Color="{StaticResource ByhColorWarningSoft}" />
      <SolidColorBrush x:Key="ByhErrorBrush" Color="{StaticResource ByhColorError}" />
      <SolidColorBrush x:Key="ByhErrorSoftBrush" Color="{StaticResource ByhColorErrorSoft}" />
      <SolidColorBrush x:Key="ByhInfoBrush" Color="{StaticResource ByhColorInfo}" />
      <SolidColorBrush x:Key="ByhInfoSoftBrush" Color="{StaticResource ByhColorInfoSoft}" />
      <SolidColorBrush x:Key="ByhPinkBrush" Color="{StaticResource ByhColorPink}" />
      <SolidColorBrush x:Key="ByhPinkSoftBrush" Color="{StaticResource ByhColorPinkSoft}" />
      <SolidColorBrush x:Key="ByhFocusBrush" Color="{StaticResource ByhColorFocus}" />
      <SolidColorBrush x:Key="ByhFocusRingBrush" Color="#388FAE5A" />

      <!--
        Alpha variants derive only from approved tokens. Avalonia XAML has no
        alpha-rebinding syntax, so these remain
        explicit theme tokens and must change with their named base colors.
      -->
      <SolidColorBrush x:Key="ByhFloatingSurfaceBrush" Color="#F5FFFDF8" />
      <SolidColorBrush x:Key="ByhFloatingBorderBrush" Color="#62D5A86A" />
      <SolidColorBrush x:Key="ByhPorcelainBorderBrush" Color="#68EAD8B8" />
      <SolidColorBrush x:Key="ByhHairlineBrush" Color="#48D5A86A" />
      <!-- Dedicated rail rule: one identical low-contrast warm line is used
           for both the vertical edge and horizontal section dividers. -->
      <SolidColorBrush x:Key="ByhRailRuleBrush" Color="#78EAD8B8" />
      <SolidColorBrush x:Key="ByhPearlGlowBrush" Color="#7AFFFDF8" />
      <SolidColorBrush x:Key="ByhOverlayDimBrush" Color="#B3000000" />
      <SolidColorBrush x:Key="ByhOverlayPanelBrush" Color="#F23A2417" />
      <SolidColorBrush x:Key="ByhOverlaySecondaryTextBrush" Color="#CCE7DDCC" />
      <SolidColorBrush x:Key="ByhCaptureSelectionBrush" Color="#338FAE5A" />
      <SolidColorBrush x:Key="ByhCaptureStrokeBrush" Color="#FF8FAE5A" />
      <SolidColorBrush x:Key="ByhCaptureHandleBrush" Color="#FFD5A86A" />

      <!-- High-fidelity Ivory Jade materials. These stay within the approved
           palette while adding the soft sheen visible in the reference. -->
      <LinearGradientBrush x:Key="ByhCreamSheenBrush"
                            StartPoint="0%,0%"
                            EndPoint="100%,100%">
        <GradientStop Color="#FFFFFFFF" Offset="0" />
        <GradientStop Color="#FFFFF7EE" Offset="0.48" />
        <GradientStop Color="#FFF6F1E6" Offset="1" />
      </LinearGradientBrush>
      <!-- Macro surfaces are deliberately warmer than white. The subtle
           ivory-to-cream drift separates the five panels from the canvas
           while leaving their content cards one brightness step above. -->
      <LinearGradientBrush x:Key="ByhPanelIvoryBrush"
                           StartPoint="0%,0%"
                           EndPoint="100%,100%">
        <GradientStop Color="#FFFFFDF9" Offset="0" />
        <GradientStop Color="#FFFFF7EE" Offset="0.52" />
        <GradientStop Color="#FFF6F1E6" Offset="1" />
      </LinearGradientBrush>
      <!-- R54 reference-matched structural edge.  The changing luminance is
           intentionally confined to the one-DIP outer stroke: bronze at the
           tangent, champagne through the long runs, and a darker reflected
           note near the lower-right corner.  The adjacent ivory and pale-gold
           rings are supplied by MetallicFrame's inset shadows. -->
      <LinearGradientBrush x:Key="ByhMetallicEdgeBrush"
                           StartPoint="0%,0%"
                           EndPoint="100%,100%">
        <GradientStop Color="#FFB98242" Offset="0" />
        <GradientStop Color="#FFFFEDCF" Offset="0.14" />
        <GradientStop Color="#FFE8C89A" Offset="0.42" />
        <GradientStop Color="#FFD5A86A" Offset="0.68" />
        <GradientStop Color="#FFB77B37" Offset="0.88" />
        <GradientStop Color="#FFF2DDBB" Offset="1" />
      </LinearGradientBrush>
      <!-- Macro panels use the same directional metal response at a much
           lower contrast. The translucent stops blend into the ivory canvas,
           retaining a champagne glint without outlining every pane in orange. -->
      <LinearGradientBrush x:Key="ByhMacroEdgeBrush"
                           StartPoint="0%,0%"
                           EndPoint="100%,100%">
        <GradientStop Color="#8CB98242" Offset="0" />
        <GradientStop Color="#C8FFF1DA" Offset="0.14" />
        <GradientStop Color="#A8E8C89A" Offset="0.42" />
        <GradientStop Color="#98D5A86A" Offset="0.68" />
        <GradientStop Color="#7CB77B37" Offset="0.88" />
        <GradientStop Color="#B8F2DDBB" Offset="1" />
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="ByhPearlInsetBrush"
                           StartPoint="0%,0%"
                           EndPoint="0%,100%">
        <GradientStop Color="#FAFFFDF8" Offset="0" />
        <GradientStop Color="#F7F6F1E6" Offset="1" />
      </LinearGradientBrush>
      <!-- Reference-matched active navigation pill: four-stop caramel pour.
           A bright champagne highlight at the top creates the convex "pill"
           illusion, then warm caramel body, then bronze depth. -->
      <LinearGradientBrush x:Key="ByhGoldNavBrush"
                           StartPoint="0%,0%"
                           EndPoint="0%,100%">
        <GradientStop Color="#FFFFEBCB" Offset="0" />
        <GradientStop Color="#FFE8C89A" Offset="0.28" />
        <GradientStop Color="#FFD5A86A" Offset="0.66" />
        <GradientStop Color="#FFC08B48" Offset="1" />
      </LinearGradientBrush>
      <!-- Active pill border: bright top edge, warm sides, deep bottom to
           sell the convex 3D form on a flat Avalonia Button. -->
      <LinearGradientBrush x:Key="ByhGoldNavBorderBrush"
                           StartPoint="0%,0%"
                           EndPoint="0%,100%">
        <GradientStop Color="#FFFFF8EC" Offset="0" />
        <GradientStop Color="#FFF0D7AF" Offset="0.25" />
        <GradientStop Color="#FFD5A86A" Offset="0.72" />
        <GradientStop Color="#FFB77B37" Offset="1" />
      </LinearGradientBrush>
      <!-- Warm radial atmosphere: the soft bokeh-like glow behind floating
           panels in the reference. Low opacity, large radius. -->
      <RadialGradientBrush x:Key="ByhAtmosphereBrush"
                           RadiusX="0.7"
                           RadiusY="0.7"
                           Center="45%,35%"
                           GradientOrigin="45%,35%">
        <GradientStop Color="#38F3DCBA" Offset="0" />
        <GradientStop Color="#14FFF7EE" Offset="0.45" />
        <GradientStop Color="#00F6F1E6" Offset="1" />
      </RadialGradientBrush>
      <RadialGradientBrush x:Key="ByhGemGlowBrush"
                           RadiusX="0.55"
                           RadiusY="0.55">
        <GradientStop Color="#5E8FAE5A" Offset="0" />
        <GradientStop Color="#28667731" Offset="0.55" />
        <GradientStop Color="#00667731" Offset="1" />
      </RadialGradientBrush>
      <LinearGradientBrush x:Key="ByhJadeSheenBrush"
                           StartPoint="0%,0%"
                           EndPoint="100%,100%">
        <GradientStop Color="#FF8FAE5A" Offset="0" />
        <GradientStop Color="#FF667731" Offset="0.55" />
        <GradientStop Color="#FF4C5721" Offset="1" />
      </LinearGradientBrush>
      <!-- Reference-palette noble-metal lace: bright cream highlight →
           #E8C89A champagne body → #D5A86A shaded edge. The diagonal sweep
           simulates directional sheen without turning large surfaces yellow. -->
      <LinearGradientBrush x:Key="ByhSpotlightGoldBrush"
                           StartPoint="0%,0%"
                           EndPoint="100%,100%">
        <GradientStop Color="#FFFFE8C6" Offset="0" />
        <GradientStop Color="#FFE8C89A" Offset="0.5" />
        <GradientStop Color="#FFD5A86A" Offset="1" />
      </LinearGradientBrush>

      <CornerRadius x:Key="ByhRadiusSmall">8</CornerRadius>
      <CornerRadius x:Key="ByhRadiusMedium">12</CornerRadius>
      <CornerRadius x:Key="ByhRadiusLarge">18</CornerRadius>
      <BoxShadows x:Key="ByhShadowSmall">0 1 3 0 #0D4A2B19</BoxShadows>
      <BoxShadows x:Key="ByhShadowMedium">0 7 22 0 #104A2B19</BoxShadows>
      <BoxShadows x:Key="ByhShadowPearl">0 5 18 0 #149F5E30</BoxShadows>
      <!-- R54 deep float: layered ambient + cast shadow so panels lift off
           the cream background the way the reference cards do. -->
      <BoxShadows x:Key="ByhShadowDeep">0 2 6 0 #0D4A2B19, 0 12 34 0 #144A2B19, 0 24 56 0 #0A4A2B19</BoxShadows>
      <BoxShadows x:Key="ByhShadowLifted">0 4 12 0 #129F5E30, 0 16 40 0 #149F5E30</BoxShadows>
      <!-- Phone-reference soft diffusion: a warm, very diffuse cast shadow
           that makes a large rounded panel feel like it is hovering a few
           millimetres above the surface. -->
      <BoxShadows x:Key="ByhShadowDiffused">0 6 18 0 #144A2B19, 0 20 50 0 #184A2B19</BoxShadows>
      <FontFamily x:Key="ByhDisplayFontFamily">Georgia</FontFamily>
    </ResourceDictionary>
  </Styles.Resources>

  <!-- Foundations -->
  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource ByhBackgroundBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource ByhTextPrimaryBrush}" />
  </Style>
  <Style Selector="TextBlock.Secondary">
    <Setter Property="Foreground" Value="{DynamicResource ByhTextSecondaryBrush}" />
  </Style>
  <Style Selector="TextBlock.Muted">
    <Setter Property="Foreground" Value="{DynamicResource ByhTextPlaceholderBrush}" />
  </Style>
  <Style Selector="TextBlock.Accent">
    <Setter Property="Foreground" Value="{DynamicResource ByhAccentHoverBrush}" />
  </Style>
  <Style Selector="TextBlock.DisplayTitle">
    <Setter Property="Foreground" Value="{DynamicResource ByhTextPrimaryBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource ByhDisplayFontFamily}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <!-- Reference heading rhythm: every card section title uses the display
       serif, same as the page title — only size/weight scale down. -->
  <Style Selector="TextBlock.CardTitle">
    <Setter Property="Foreground" Value="{DynamicResource ByhTextPrimaryBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource ByhDisplayFontFamily}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.Kicker">
    <Setter Property="Foreground" Value="{DynamicResource ByhAccentBrush}" />
    <Setter Property="FontSize" Value="9" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="1.4" />
  </Style>
  <Style Selector="TextBlock.FeedbackSuccess">
    <Setter Property="Foreground" Value="{DynamicResource ByhSuccessBrush}" />
  </Style>
  <Style Selector="TextBlock.FeedbackError">
    <Setter Property="Foreground" Value="{DynamicResource ByhErrorBrush}" />
  </Style>
  <Style Selector="TextBlock.FeedbackInfo">
    <Setter Property="Foreground" Value="{DynamicResource ByhInfoBrush}" />
  </Style>

  <!-- Surfaces -->
  <Style Selector="Border.Card">
    <Setter Property="Background" Value="{DynamicResource ByhSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ByhBorderSubtleBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource ByhRadiusMedium}" />
    <Setter Property="BoxShadow" Value="{DynamicResource ByhShadowSmall}" />
  </Style>
  <Style Selector="Border.CardWarm">
    <Setter Property="Background" Value="{DynamicResource ByhSurfaceSecondaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ByhBorderSubtleBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource ByhRadiusMedium}" />
  </Style>
  <Style Selector="Border.PearlCard">
    <Setter Property="Background" Value="{DynamicResource ByhCreamSheenBrush}" />
    <Setter Property="BorderBrush" Value="#78E8C89A" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <!-- R54: stronger float + a bright top highlight edge so the card reads
         as a convex ivory tile catching light from above. -->
    <Setter Property="BoxShadow" Value="inset 0 1 0 0 #E8FFFFFF, inset 0 0 0 1 #C8FFFDF8, inset 0 0 0 2 #42F3DCBA, 0 4 12 0 #106B4B2A, 0 16 40 0 #126B4B2A" />
  </Style>
  <Style Selector="Border.PearlInset">
    <Setter Property="Background" Value="{DynamicResource ByhPearlInsetBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ByhPorcelainBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
  </Style>
  <!-- R54 structural frame: one real metallic gradient edge plus two inset
       optical rings.  The first inset shadow repaints a two-DIP porcelain gap;
       the second remains visible as a one-DIP pale-gold inner curve at 3 DIP.
       Because both are rendered from the same rounded geometry, straight runs
       and corners stay concentric without a wide nested-frame gutter.
       R54 atmosphere: add a deep float shadow so the whole frame reads as a
       raised tray resting on the cream surface. -->
  <Style Selector="Border.MetallicFrame">
    <Setter Property="Background" Value="#FAFFFDF8" />
    <Setter Property="BorderBrush" Value="{DynamicResource ByhMetallicEdgeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="28" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="BoxShadow" Value="inset 0 0 0 2 #FFFFFDF8, inset 0 0 0 3 #A8EAD8B8, inset 0 1 2 0 #B8FFFFFF, 0 2 6 0 #0D4A2B19, 0 12 34 0 #124A2B19, 0 24 56 0 #084A2B19" />
  </Style>
  <Style Selector="Border.MetallicFrame.Compact">
    <Setter Property="CornerRadius" Value="24" />
  </Style>
  <!-- Reference macro frame. One element owns the metallic contour and cast
       shadow; a separate MacroClip child owns rounded content clipping. This
       prevents nested full-size borders and clipped shadows from creating the
       thick or broken rim seen in the previous version. -->
  <Style Selector="Border.MetallicFrame.Thin">
    <Setter Property="Background" Value="#FFFFFDF8" />
    <Setter Property="BorderBrush" Value="{DynamicResource ByhMacroEdgeBrush}" />
    <Setter Property="Padding" Value="3" />
    <!-- Match the successful InnerCard material at macro scale: a bright
         top inset, a short contact shadow and a broad, faint ambient falloff.
         Depth comes from light, not from a darker outline. -->
    <Setter Property="BoxShadow" Value="inset 0 1 0 0 #F0FFFFFF, inset 0 0 0 1 #FFFFFFFF, inset 0 0 0 2 #54EAD8B8, 0 3 10 0 #0D4A2B19, 0 14 34 0 #104A2B19, 0 24 54 0 #064A2B19" />
  </Style>
  <!-- The right summary reads as a small handset rather than another desktop
       card: deeper body radius, a closer double rim and slightly longer lift. -->
  <Style Selector="Border.MetallicFrame.PhoneFrame">
    <Setter Property="CornerRadius" Value="34" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="BoxShadow" Value="inset 0 1 0 0 #F4FFFFFF, inset 0 0 0 1 #FFFFFDF8, inset 0 0 0 3 #70EAD8B8, 0 4 12 0 #104A2B19, 0 18 42 0 #124A2B19, 0 30 64 0 #084A2B19" />
  </Style>
  <Style Selector="Border.PorcelainCard">
    <Setter Property="Background" Value="{DynamicResource ByhCreamSheenBrush}" />
    <Setter Property="BorderBrush" Value="#70E8C89A" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="BoxShadow" Value="inset 0 1 0 0 #D8FFFFFF, inset 0 0 0 1 #B8FFFDF8, inset 0 0 0 2 #38F3DCBA, 0 3 10 0 #0D6B4B2A, 0 12 32 0 #106B4B2A" />
  </Style>
  <!-- R54 phone-reference large lifted panel: the "two rounded boxes
       stacked" look. Bigger radius, very soft diffuse shadow, bright top
       highlight, and a warm 1px rim so it reads as a thick ivory tile
       catching overhead light. -->
  <Style Selector="Border.LiftedPanel">
    <Setter Property="Background" Value="{DynamicResource ByhCreamSheenBrush}" />
    <Setter Property="BorderBrush" Value="#88E8C89A" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="BoxShadow" Value="inset 0 1 0 0 #ECFFFFFF, inset 0 0 0 1 #C8FFFDF8, inset 0 0 0 2 #42F3DCBA, 0 6 18 0 #106B4B2A, 0 20 50 0 #146B4B2A" />
  </Style>
      <!-- Inner card: a whisper-thin tile that sits on the SurfacePanel.
       Reference-matched: a bright top highlight + a soft, diffuse cast
       shadow sells the convex form without a heavy border.
       R57: stronger, wider shadow so the input tiles actually read as
       raised against the SurfacePanel. -->
  <Style Selector="Border.InnerCard">
    <Setter Property="Background" Value="#FCFFFFFF" />
    <Setter Property="BorderBrush" Value="#30E8C89A" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="BoxShadow" Value="inset 0 1 0 0 #E6FFFEFA, 0 3 10 0 #104A2B19, 0 10 26 0 #144A2B19" />
  </Style>
  <!-- R54 clipboard-history left nav tower. A compact raised tile that hosts
       the vertical tab rail (built-in tabs + custom tags + footer gear). Uses
       the same ivory-champagne material language as InnerCard/LiftedPanel but
       stands slightly taller (a touch more cast shadow) so the nav reads as a
       distinct frame from the entry list beside it. Rebuilt after the
       metallic-frames branch removed the pre-R54 NavTowerFrame definition. -->
  <Style Selector="Border.NavTowerFrame">
    <Setter Property="Background" Value="{DynamicResource ByhCreamSheenBrush}" />
    <Setter Property="BorderBrush" Value="#70E8C89A" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="3" />
    <Setter Property="BoxShadow" Value="inset 0 1 0 0 #D8FFFFFF, inset 0 0 0 1 #B8FFFDF8, inset 0 0 0 2 #2CF3DCBA, 0 2 8 0 #0D6B4B2A, 0 8 22 0 #106B4B2A" />
  </Style>
  <!-- Rounded content clip for every macro panel. It deliberately has no
       border or shadow: those belong exclusively to MetallicFrame.Thin. -->
  <Style Selector="Border.MacroClip">
    <Setter Property="Background" Value="{DynamicResource ByhPanelIvoryBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="24" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Border.MacroClip.Compact">
    <Setter Property="CornerRadius" Value="20" />
  </Style>
  <Style Selector="Border.MacroClip.PhoneClip">
    <Setter Property="CornerRadius" Value="29" />
  </Style>
  <Style Selector="Border.PhoneDock">
    <Setter Property="Background" Value="#E6FFF7EE" />
    <Setter Property="BorderBrush" Value="#72D5A86A" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="3" />
    <Setter Property="BoxShadow" Value="inset 0 1 0 0 #E6FFFEFA, 0 3 10 0 #104A2B19" />
  </Style>
  <Style Selector="Border.PhoneDockItem">
    <Setter Property="Width" Value="26" />
    <Setter Property="Height" Value="26" />
    <Setter Property="CornerRadius" Value="13" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.PhoneDockItem.Active">
    <Setter Property="Background" Value="{DynamicResource ByhAccentSoftBrush}" />
  </Style>
  <Style Selector="Border.PhoneDockItem.Center">
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="34" />
    <Setter Property="CornerRadius" Value="17" />
    <Setter Property="Background" Value="{DynamicResource ByhSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ByhGoldBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BoxShadow" Value="inset 0 1 0 0 #E6FFFEFA, 0 3 10 0 #149F5E30" />
  </Style>
  <Style Selector="Path.PhoneDockIcon">
    <Setter Property="Width" Value="13" />
    <Setter Property="Height" Value="13" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Fill" Value="Transparent" />
    <Setter Property="Stroke" Value="{DynamicResource ByhAccentHoverBrush}" />
    <Setter Property="StrokeThickness" Value="1.45" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- R55 elegant hero card for the settings page header. Much lighter than
       LiftedPanel: a whisper-thin warm border, very soft diffuse shadow, and
       generous radius so it floats gracefully inside the MetallicFrame. -->
  <Style Selector="Border.HeroCard">
    <Setter Property="Background" Value="#FFFFF9F1" />
    <Setter Property="BorderBrush" Value="#B8EAD8B8" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="24" />
    <Setter Property="BoxShadow" Value="0 2 8 0 #0A4A2B19" />
  </Style>
  <!-- Hero pill: the small tag row under the page title. Flat, airy, with
       only a hairline border so it reads as typography with a hint of shape. -->
  <Style Selector="Border.HeroPill">
    <Setter Property="Background" Value="#FFFFF9F0" />
    <Setter Property="BorderBrush" Value="#78EAD8B8" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="BoxShadow" Value="inset 0 1 0 0 #FFFFFEFA" />
  </Style>
  <!-- Theme pill: the active-theme badge in the header. Soft, rounded,
       almost token-like, with no heavy shadow or accent fill. -->
  <Style Selector="Border.ThemePill">
    <Setter Property="Background" Value="#FFF6F1E6" />
    <Setter Property="BorderBrush" Value="#80EAD8B8" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="BoxShadow" Value="inset 0 1 0 0 #FFFFFEFA" />
  </Style>
  <Style Selector="Border.GemPortrait">
    <Setter Property="Background" Value="{DynamicResource ByhPearlGlowBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ByhFloatingBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="72" />
    <Setter Property="BoxShadow" Value="0 0 0 4 #1E899845, 0 0 28 0 #289F5E30, 0 8 28 0 #189F5E30" />
  </Style>
  <Style Selector="Border.StatusPill">
    <Setter Property="Background" Value="#ECFFFDF8" />
    <Setter Property="BorderBrush" Value="{DynamicResource ByhPorcelainBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="BoxShadow" Value="inset 0 1 0 0 #CFFFFEFA, 0 1 3 0 #0D4A2B19" />
  </Style>
  <Style Selector="Border.Badge">
    <Setter Property="Background" Value="{DynamicResource ByhAccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ByhGoldBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource ByhRadiusSmall}" />
    <Setter Property="BoxShadow" Value="inset 0 1 0 0 #CCFFFEFA, 0 2 6 0 #109F5E30" />
  </Style>
  <!-- R54 v2: inline custom-TAB badges on each clipboard-history row (the
       custom tabs an entry was assigned to via "Move to…"). Soft olive fill +
       olive border. Distinct from EntryTagBadge (gold) so the two kinds read as
       different layers at a glance. -->
  <Style Selector="Border.TagBadge">
    <Setter Property="Background" Value="{DynamicResource ByhPrimarySoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ByhPrimaryBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource ByhRadiusSmall}" />
  </Style>
  <!-- R54 v2: inline entry-TAG badges (free-form annotations like "AWS"/
       "Stripe" added via "Add tag…"). Pink fill + pink border — visually
       distinct from the olive TagBadge (custom-tab assignments) and the gold
       Badge (auto-group) so all three kinds read as separate layers. -->
  <Style Selector="Border.EntryTagBadge">
    <Setter Property="Background" Value="{DynamicResource ByhPinkSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ByhPinkBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource ByhRadiusSmall}" />
  </Style>
  <!-- R103: "Archived" badge for entries that fell off the live window and were
       moved to the monthly archive (batch 102). Neutral gray so it reads as
       "historical / not currently active", distinct from the gold/olive/pink
       badges above. Uses existing surface-secondary + border-subtle resources —
       no new brush needed. -->
  <Style Selector="Border.ArchiveBadge">
    <Setter Property="Background" Value="{DynamicResource ByhSurfaceSecondaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ByhBorderSubtleBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource ByhRadiusSmall}" />
  </Style>
  <Style Selector="Border.FloatingSurface">
    <Setter Property="Background" Value="{DynamicResource ByhFloatingSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ByhFloatingBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource ByhRadiusMedium}" />
    <Setter Property="BoxShadow" Value="{DynamicResource ByhShadowMedium}" />
  </Style>

  <!-- R32 Spotlight launcher-search panel: row + active-state classes.
       R43: Active state hardened — SurfaceSelected fill + Primary border + a
       left accent bar (inset BoxShadow) so the selected row reads at a glance
       even when the panel is small and the list is dense. -->
  <!-- Flat concept rail remains square, but now shares the same gentle
       porcelain lift as the rounded panels. Its structural rule stays a
       single hairline so it never competes with the navigation tower. -->
  <Style Selector="Border.FlatRail">
    <Setter Property="Background" Value="{DynamicResource ByhCreamSheenBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ByhRailRuleBrush}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
    <Setter Property="BoxShadow" Value="inset -1 0 0 0 #38FFFDF8, inset 0 1 0 0 #B8FFFEFA, 4 2 12 0 #104A2B19, 12 10 34 0 #0C4A2B19" />
  </Style>

  <!-- Reference specimen typography: each section relies on restrained type
       hierarchy and a shared rule rather than nested cards. -->
  <Style Selector="TextBlock.RailSectionTitle">
    <Setter Property="FontFamily" Value="Georgia" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource ByhTextPrimaryBrush}" />
  </Style>
  <Style Selector="TextBlock.RailBody">
    <Setter Property="FontSize" Value="8.5" />
    <Setter Property="LineHeight" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource ByhTextSecondaryBrush}" />
  </Style>
  <Style Selector="Path.RailSampleIcon">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Stroke" Value="{DynamicResource ByhAccentBrush}" />
    <Setter Property="StrokeThickness" Value="1.35" />
    <Setter Property="Fill" Value="Transparent" />
  </Style>

  <Style Selector="Border.SpotlightRow">
    <Setter Property="Transitions">
      <Setter.Value>
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.08" />
          <BrushTransition Property="Background" Duration="0:0:0.08" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.08" />
        </Transitions>
      </Setter.Value>
    </Setter>
  </Style>
  <Style Selector="Border.SpotlightRow:pointerover">
    <Setter Property="Background" Value="{DynamicResource ByhSurfaceSecondaryBrush}" />
  </Style>
  <!-- R43 Spotlight selection: refined solid-gold double-line filigree,
     uniform on ALL four sides. No gradient, no asymmetric left rail (the
     rail was the "thick orange-yellow" the user rejected). Layers painted
     from outside in:
       - 1px outer border = mid champagne gold #D9C28A (the frame).
       - 1px champagne gap (#FCF7EA) — matches Background, reads as a
         hairline channel between the two gold lines.
       - 1px bright gold inner line (#F4E7C8) — the glint that makes it
         read as delicate filigree rather than a flat slab.
     Total frame ~3px on every side. -->
  <Style Selector="Border.SpotlightRow.Active">
    <Setter Property="Background" Value="#FFFCF7EA" />
    <Setter Property="BorderBrush" Value="#FFD9C28A" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BoxShadow" Value="inset 0 0 0 2 #FFFCF7EA, inset 0 0 0 3 #FFF4E7C8" />
  </Style>
  <!-- Keep the Active fill even while hovered, so the keyboard selection stays
       readable when the user happens to move the mouse over another row. -->
  <Style Selector="Border.SpotlightRow.Active:pointerover">
    <Setter Property="Background" Value="#FFFCF7EA" />
  </Style>
  <!-- Name in Bold + deep bronze — bookish, pairs with the gold frame. -->
  <Style Selector="Border.SpotlightRow.Active TextBlock.SpotlightRowName">
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="#FFB89A5C" />
  </Style>
  <!-- R54 v1.2 v3: expanded full-text block — softer ink + measured line gap so
       a long paste reads as prose, not a wall. The Active override below keeps
       the bronze tone when the row is also selected. -->
  <Style Selector="TextBlock.ExpandedText">
    <Setter Property="Foreground" Value="{DynamicResource ByhTextSecondaryBrush}" />
  </Style>
  <Style Selector="Border.SpotlightRow.Active TextBlock.ExpandedText">
    <Setter Property="Foreground" Value="#FF8A6D2F" />
  </Style>

  <!-- R54 v1.2 v5: Lucide vector icons used as tag icons. Stroke follows the
       surrounding text color so the icon matches an active/inactive nav row.
       The SettingsNav.Active override turns the stroke bronze to match the bold
       label text. -->
  <Style Selector="Path.TagIcon">
    <Setter Property="Stroke" Value="{DynamicResource ByhTextSecondaryBrush}" />
  </Style>
  <Style Selector="Button.SettingsNav:pointerover Path.TagIcon">
    <Setter Property="Stroke" Value="{DynamicResource ByhAccentBrush}" />
  </Style>
  <Style Selector="Button.SettingsNav.Active Path.TagIcon">
    <Setter Property="Stroke" Value="{DynamicResource ByhTextOnPrimaryBrush}" />
  </Style>
  <!-- R54 v1.2 v6: custom-tag nav row. The whole row is a Border (NOT a Button)
       so we can own pointer capture for drag-to-reorder AND deliver a click
       (select tab) on an under-threshold release — without fighting the Button
       internal capture state machine. These styles mirror Button.SettingsNav so
       the row looks identical to the built-in tabs (same padding, corner radius,
       hover/active fills, gold active frame). The .Dragging class dims the row
       while it is being dragged; .Active matches the SettingsNav.Active look. -->
  <Style Selector="Border.TagNavRow">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <!-- Match the built-in Button.SettingsNav rows exactly: the built-in
         BuildNavButton overrides Padding to 6,5 and uses FontSize 10, so the
         custom-tag row must use the same to align pixel-for-pixel. -->
    <Setter Property="Padding" Value="6,5" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Transitions">
      <Setter.Value>
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.08" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.08" />
        </Transitions>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- The label + "#" placeholder inherit the same secondary ink color the
       built-in Button.SettingsNav tabs use, so inactive custom tags match the
       built-in rows. The .Active override below flips them to onPrimary. -->
  <Style Selector="Border.TagNavRow TextBlock.TagLabel">
    <Setter Property="Foreground" Value="{DynamicResource ByhTextSecondaryBrush}" />
  </Style>
  <Style Selector="Border.TagNavRow:pointerover TextBlock.TagLabel">
    <Setter Property="Foreground" Value="{DynamicResource ByhAccentBrush}" />
  </Style>
  <Style Selector="Border.TagNavRow:pointerover">
    <Setter Property="Background" Value="{DynamicResource ByhCreamSheenBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ByhGoldBrush}" />
  </Style>
  <Style Selector="Border.TagNavRow.Active">
    <Setter Property="Background" Value="{DynamicResource ByhGoldNavBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ByhGoldBrush}" />
  </Style>
  <Style Selector="Border.TagNavRow.Active:pointerover">
    <Setter Property="Background" Value="{DynamicResource ByhGoldNavBrush}" />
  </Style>
  <Style Selector="Border.TagNavRow.Active TextBlock.TagLabel">
    <Setter Property="Foreground" Value="{DynamicResource ByhTextOnPrimaryBrush}" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <!-- The custom-tag icon (a Lucide/user Path) must mirror the built-in tabs'
       hover→accent and active→onPrimary color shifts, so the icon never reads
       as a different color from its row. -->
  <Style Selector="Border.TagNavRow:pointerover Path.TagIcon">
    <Setter Property="Stroke" Value="{DynamicResource ByhAccentBrush}" />
  </Style>
  <Style Selector="Border.TagNavRow.Active Path.TagIcon">
    <Setter Property="Stroke" Value="{DynamicResource ByhTextOnPrimaryBrush}" />
  </Style>
  <Style Selector="Border.TagNavRow.Dragging">
    <Setter Property="Opacity" Value="0.45" />
  </Style>

  <!-- R43 Spotlight search box wrapper Border: identical gold-lace frame as
       Border.SpotlightRow.Active — 1px gold outer border + champagne gap +
       bright-gold inner glint, all via inset BoxShadow. The inner TextBox
       is fully borderless/transparent; this Border is the sole frame.
       Wraps ONLY the TextBox (not the lightning icon), tightly. -->
  <Style Selector="Border.SpotlightGoldFrame">
    <Setter Property="Background" Value="#FFFCF7EA" />
    <Setter Property="BorderBrush" Value="#FFD9C28A" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BoxShadow" Value="inset 0 0 0 2 #FFFCF7EA, inset 0 0 0 3 #FFF4E7C8" />
  </Style>

  <!-- Inputs -->
  <Style Selector="TextBox">
    <Setter Property="Background" Value="{DynamicResource ByhSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ByhBorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ByhTextPrimaryBrush}" />
    <Setter Property="PlaceholderForeground" Value="{DynamicResource ByhTextPlaceholderBrush}" />
    <Setter Property="CaretBrush" Value="{DynamicResource ByhPrimaryBrush}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource ByhPrimarySoftBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource ByhRadiusSmall}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="TextBox:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource ByhPrimaryBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <!-- R43 Spotlight search box: the TextBox is fully borderless and
       transparent — the gold-lace frame is owned SOLELY by the wrapping
       Border.SpotlightGoldFrame. We must zero out every border property
       on the TextBox itself (BorderThickness + BorderBrush + Background)
       AND also override the FluentTheme's TextControl resource keys that
       the TextBox template uses internally to paint its own frame, so
       only ONE frame (the outer Border's gold lace) is visible.
       Defined AFTER the global TextBox / TextBox:focus rules so same-
       specificity document order resolves in our favour. -->
  <Style Selector="TextBox.SpotlightSearch">
    <Style.Resources>
      <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
      <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
      <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
      <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="Transparent" />
      <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
      <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
      <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
      <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent" />
    </Style.Resources>
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="PlaceholderForeground" Value="#FFA89788" />
    <Setter Property="CaretBrush" Value="#FFB89A5C" />
    <Setter Property="SelectionBrush" Value="#66B89A5C" />
    <Setter Property="SelectionForegroundBrush" Value="#FFFCF7EA" />
  </Style>
  <Style Selector="TextBox.SpotlightSearch:focus">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="TextBox.SpotlightSearch:focus /template/ ContentPresenter">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="Background" Value="{DynamicResource ByhSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ByhBorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ByhTextPrimaryBrush}" />
    <Setter Property="PlaceholderForeground" Value="{DynamicResource ByhTextPlaceholderBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource ByhRadiusSmall}" />
  </Style>
  <Style Selector="ComboBox:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource ByhPrimaryBrush}" />
  </Style>
  <Style Selector="NumericUpDown">
    <Setter Property="Background" Value="{DynamicResource ByhSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ByhBorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ByhTextPrimaryBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource ByhRadiusSmall}" />
  </Style>
  <Style Selector="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource ByhTextSecondaryBrush}" />
  </Style>
  <Style Selector="ToggleSwitch">
    <Setter Property="Foreground" Value="{DynamicResource ByhTextSecondaryBrush}" />
  </Style>
  <Style Selector="ProgressBar">
    <Setter Property="Foreground" Value="{DynamicResource ByhPrimaryBrush}" />
    <Setter Property="Background" Value="{DynamicResource ByhSurfaceSelectedBrush}" />
  </Style>

  <!-- Buttons: secondary is the quiet default; real actions opt into Primary. -->
  <Style Selector="Button">
    <Setter Property="Background" Value="{DynamicResource ByhCreamSheenBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ByhAccentHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ByhGoldBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource ByhRadiusSmall}" />
  </Style>
  <Style Selector="Button:pointerover">
    <Setter Property="Background" Value="{DynamicResource ByhSurfaceSecondaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ByhGoldBrush}" />
  </Style>
  <Style Selector="Button:pressed">
    <Setter Property="Background" Value="{DynamicResource ByhAccentSoftBrush}" />
  </Style>
  <Style Selector="Button:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource ByhFocusBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="Button:disabled">
    <Setter Property="Background" Value="{DynamicResource ByhDisabledBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ByhDisabledBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ByhTextPlaceholderBrush}" />
  </Style>

  <Style Selector="Button.Primary">
    <Setter Property="Background" Value="{DynamicResource ByhJadeSheenBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ByhPrimaryBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ByhTextOnPrimaryBrush}" />
  </Style>
  <Style Selector="Button.Primary:pointerover">
    <Setter Property="Background" Value="{DynamicResource ByhPrimaryHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ByhPrimaryHoverBrush}" />
  </Style>
  <Style Selector="Button.Primary:pressed">
    <Setter Property="Background" Value="{DynamicResource ByhPrimaryHoverBrush}" />
  </Style>
  <Style Selector="Button.Danger">
    <Setter Property="Background" Value="{DynamicResource ByhErrorBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ByhErrorBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ByhTextOnPrimaryBrush}" />
  </Style>
  <Style Selector="Button.Danger:pointerover">
    <Setter Property="Background" Value="{DynamicResource ByhAccentHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ByhAccentHoverBrush}" />
  </Style>
  <Style Selector="Button.DangerQuiet">
    <Setter Property="Background" Value="{DynamicResource ByhErrorSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ByhErrorSoftBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ByhErrorBrush}" />
  </Style>
  <Style Selector="Button.DangerQuiet:pointerover">
    <Setter Property="Background" Value="{DynamicResource ByhErrorBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ByhErrorBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ByhTextOnPrimaryBrush}" />
  </Style>
  <Style Selector="Button.Ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource ByhTextPrimaryBrush}" />
  </Style>
  <Style Selector="Button.Ghost:pointerover">
    <Setter Property="Background" Value="{DynamicResource ByhSurfaceSecondaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ByhBorderSubtleBrush}" />
  </Style>
  <Style Selector="Button.Ghost:pressed">
    <Setter Property="Background" Value="{DynamicResource ByhSurfaceSelectedBrush}" />
  </Style>

  <!-- Reference-style settings navigation: restrained line icons, quiet ivory
       rows, and a warm-gold active state. -->
  <Style Selector="Button.SettingsNav">
    <!-- Stretch to the host column (settings nav rail ≈170px, clipboard
         history left rail 104px). A hard Width here (task tried 146) breaks
         clipboard-history buttons, which share this style but live in a
         narrower column — they overflowed the 128px rail. Stretch + the
         parent StackPanel/Grid column width is the correct sizing source. -->
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Padding" Value="14,11" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource ByhTextSecondaryBrush}" />
  </Style>
  <Style Selector="Button.SettingsNav:pointerover">
    <Setter Property="Background" Value="{DynamicResource ByhCreamSheenBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ByhGoldBrush}" />
  </Style>
  <Style Selector="Button.SettingsNav:pressed">
    <Setter Property="Background" Value="{DynamicResource ByhSurfaceSelectedBrush}" />
  </Style>
  <!-- Reference active pill: rounder, plumper, with a bright top border
       gradient that sells the convex "pill" form even without BoxShadow. -->
  <Style Selector="Button.SettingsNav.Active">
    <Setter Property="Background" Value="{DynamicResource ByhGoldNavBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ByhGoldNavBorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ByhTextOnPrimaryBrush}" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="14,12" />
  </Style>
  <Style Selector="Button.SettingsNav.Active:pointerover">
    <Setter Property="Background" Value="{DynamicResource ByhGoldNavBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ByhGoldNavBorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ByhTextOnPrimaryBrush}" />
  </Style>
  <Style Selector="Button.SettingsNav.Active:pressed">
    <Setter Property="Background" Value="{DynamicResource ByhGoldNavBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ByhGoldNavBorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ByhTextOnPrimaryBrush}" />
  </Style>
  <Style Selector="Button.SettingsNav:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource ByhFocusBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="Button.SettingsNav Path.NavIcon">
    <Setter Property="Width" Value="17" />
    <Setter Property="Height" Value="17" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Fill" Value="Transparent" />
    <Setter Property="Stroke" Value="{DynamicResource ByhAccentBrush}" />
    <Setter Property="StrokeThickness" Value="1.35" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.SettingsNav.Active Path.NavIcon">
    <Setter Property="Stroke" Value="{DynamicResource ByhTextOnPrimaryBrush}" />
  </Style>
  <!-- Reference summary rows: small line icon centered inside a soft-tinted
       circular badge. Stroke color is set inline per badge tint. -->
  <Style Selector="Path.MiniIcon">
    <Setter Property="Width" Value="13" />
    <Setter Property="Height" Value="13" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Fill" Value="Transparent" />
    <Setter Property="StrokeThickness" Value="1.5" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- Class + focus selectors outrank normal class styles, preserving a
       visible keyboard-focus indicator on every semantic button variant. -->
  <Style Selector="Button.Primary:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource ByhPrimarySoftBrush}" />
    <Setter Property="BorderThickness" Value="3" />
  </Style>
  <Style Selector="Button.Danger:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource ByhFocusBrush}" />
    <Setter Property="BorderThickness" Value="3" />
  </Style>
  <Style Selector="Button.DangerQuiet:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource ByhFocusBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="Button.Ghost:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource ByhFocusBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <!-- Menus inherit the light material instead of Fluent's default variant. -->
  <Style Selector="ContextMenu">
    <Setter Property="Background" Value="{DynamicResource ByhSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ByhTextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ByhBorderSubtleBrush}" />
  </Style>
  <Style Selector="MenuItem">
    <Setter Property="Foreground" Value="{DynamicResource ByhTextPrimaryBrush}" />
  </Style>
</Styles>
