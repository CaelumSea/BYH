<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SelectionAssistant.UI.Views.RegionSelectOverlay"
        Title="BYH · 区域选择"
        ShowActivated="True"
        ShowInTaskbar="False"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        Topmost="True"
        CanResize="False"
        KeyDown="OnRootKeyDown">
  <Canvas x:Name="RootCanvas"
          Background="#01000000"
          PointerPressed="OnCanvasPointerPressed"
          PointerMoved="OnCanvasPointerMoved"
          PointerReleased="OnCanvasPointerReleased">

    <!-- R42: DimMask is a full-screen Path with an EvenOdd geometry that
         punches a transparent hole where the selection rect is. Outside the
         rect = dim (#B33A2417), inside = fully transparent (desktop visible).
         The geometry string is rebuilt in UpdateDimMask() on every rect change. -->
    <Path x:Name="DimMask"
          Fill="{DynamicResource ByhOverlayDimBrush}"
          IsHitTestVisible="False" />

    <!-- R42: selection rect — white dashed border, transparent fill (the hole
         in DimMask already shows the desktop through). IsHitTestVisible=False
         so all clicks fall through to the Canvas (框内外统一: drag = redraw,
         single click = confirm UIA box). Resize is via the 8 handles below. -->
    <Rectangle x:Name="SelectionRect"
               Fill="Transparent"
               Stroke="#FFFFFFFF"
               StrokeThickness="2"
               StrokeDashArray="4,3"
               IsHitTestVisible="False" />

    <!-- Eight resize handles (4 corners + 4 edges). Each is a small solid square;
         its Cursor + which edges it controls are set in code-behind.
         R42: kept in Ivory Jade ancient gold (ByhCaptureHandleBrush). -->
    <Rectangle x:Name="HandleNW" Width="12" Height="12" Fill="{DynamicResource ByhCaptureHandleBrush}" />
    <Rectangle x:Name="HandleN"  Width="12" Height="12" Fill="{DynamicResource ByhCaptureHandleBrush}" />
    <Rectangle x:Name="HandleNE" Width="12" Height="12" Fill="{DynamicResource ByhCaptureHandleBrush}" />
    <Rectangle x:Name="HandleE"  Width="12" Height="12" Fill="{DynamicResource ByhCaptureHandleBrush}" />
    <Rectangle x:Name="HandleSE" Width="12" Height="12" Fill="{DynamicResource ByhCaptureHandleBrush}" />
    <Rectangle x:Name="HandleS"  Width="12" Height="12" Fill="{DynamicResource ByhCaptureHandleBrush}" />
    <Rectangle x:Name="HandleSW" Width="12" Height="12" Fill="{DynamicResource ByhCaptureHandleBrush}" />
    <Rectangle x:Name="HandleW"  Width="12" Height="12" Fill="{DynamicResource ByhCaptureHandleBrush}" />

    <!-- Size readout shown at the bottom-right of the selection rect. -->
    <Border x:Name="SizeBadge"
            Background="{DynamicResource ByhOverlayPanelBrush}"
            CornerRadius="4"
            Padding="6,2"
            IsHitTestVisible="False">
      <TextBlock x:Name="SizeText" Foreground="{DynamicResource ByhOverlaySecondaryTextBrush}" FontSize="11" />
    </Border>

    <!-- Hint text shown at the top of the screen. -->
    <Border Background="{DynamicResource ByhOverlayPanelBrush}"
            CornerRadius="6"
            Padding="12,8"
            Canvas.Left="20"
            Canvas.Top="20"
            IsHitTestVisible="False">
      <StackPanel>
        <TextBlock Foreground="{DynamicResource ByhOverlaySecondaryTextBrush}" FontSize="13" FontWeight="SemiBold"
                   Text="拖拽选择要识别的区域" />
        <TextBlock Foreground="{DynamicResource ByhOverlaySecondaryTextBrush}" FontSize="11"
                   Text="单击=确认 UIA 框 · 拖动=自定义 · 右键=重画 · ESC=退出" />
      </StackPanel>
    </Border>
  </Canvas>
</Window>
