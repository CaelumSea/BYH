<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="clr-namespace:SelectionAssistant.Core.I18n;assembly=SelectionAssistant.Core"
        x:Class="SelectionAssistant.UI.Views.ResultWindow"
        Title="{x:Static i18n:Strings.Result_WindowTitle}"
        Width="560"
        Height="430"
        MinWidth="420"
        MinHeight="320"
        WindowStartupLocation="CenterScreen"
        KeyDown="OnWindowKeyDown">
  <Border Padding="20" Classes="Card">
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="12">
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
        <StackPanel>
          <TextBlock Text="{x:Static i18n:Strings.Result_Title}"
                     Classes="DisplayTitle"
                     FontSize="{DynamicResource ByhFontSizeHeading}" />
          <TextBlock x:Name="LanguagePairText"
                     Text="{x:Static i18n:Strings.Result_DefaultLanguagePair}"
                     Classes="Secondary"
                     FontSize="{DynamicResource ByhFontSizeBodyLarge}"
                     Margin="0,3,0,0" />
        </StackPanel>
        <Border Grid.Column="1"
                Classes="Badge"
                Padding="9,5"
                VerticalAlignment="Center">
          <TextBlock x:Name="ProviderText"
                     Text="{x:Static i18n:Strings.Result_DefaultProvider}"
                     Classes="Accent"
                     FontSize="{DynamicResource ByhFontSizeBody}" />
        </Border>
      </Grid>

      <Border Grid.Row="1"
              Classes="CardWarm"
              Padding="12">
        <StackPanel Spacing="6">
          <TextBlock Text="{x:Static i18n:Strings.Result_SourceLabel}"
                     Classes="Muted"
                     FontSize="{DynamicResource ByhFontSizeBody}" />
          <TextBox x:Name="SourceTextBox"
                   IsReadOnly="True"
                   AcceptsReturn="True"
                   TextWrapping="Wrap"
                   MaxHeight="92"
                   Background="Transparent"
                   BorderThickness="0"
                   Padding="0"
                   Foreground="{DynamicResource ByhTextPrimaryBrush}" />
        </StackPanel>
      </Border>

      <Grid Grid.Row="2">
        <ProgressBar x:Name="LoadingBar"
                     IsIndeterminate="True"
                     Height="3" />
        <TextBlock x:Name="ErrorText"
                   IsVisible="False"
                   Classes="FeedbackError"
                   TextWrapping="Wrap" />
      </Grid>

      <Border Grid.Row="3"
              Classes="Card"
              BorderBrush="{DynamicResource ByhPrimarySoftBrush}"
              BorderThickness="1"
              Padding="14">
        <TextBox x:Name="ResultTextBox"
                 Text="{x:Static i18n:Strings.Result_Loading}"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="0"
                 Foreground="{DynamicResource ByhTextPrimaryBrush}"
                 FontSize="{DynamicResource ByhFontSizeSubheading}" />
      </Border>

      <Grid Grid.Row="4" ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8">
        <TextBlock x:Name="PrivacyText"
                   Text="{x:Static i18n:Strings.Result_PrivacyTestMode}"
                   Classes="Muted"
                   FontSize="{DynamicResource ByhFontSizeBodySmall}"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
        <Button x:Name="CopySourceButton"
                Grid.Column="1"
                Content="{x:Static i18n:Strings.Result_CopySource}"
                IsEnabled="False"
                Click="OnCopySourceClick" />
        <Button x:Name="CopyButton"
                Grid.Column="2"
                Classes="Primary"
                Content="{x:Static i18n:Strings.Result_CopyTranslation}"
                IsEnabled="False"
                Click="OnCopyClick" />
        <Button x:Name="ReplaceButton"
                Grid.Column="3"
                Classes="Ghost"
                Content="{x:Static i18n:Strings.Result_Replace}"
                IsEnabled="False"
                Click="OnReplaceClick" />
        <Button x:Name="RetryButton"
                Grid.Column="4"
                Content="{x:Static i18n:Strings.Common_Retry}"
                IsEnabled="False"
                Click="OnRetryClick" />
        <Button Grid.Column="5"
                Content="{x:Static i18n:Strings.Common_Close}"
                Click="OnCloseClick" />
      </Grid>
    </Grid>
  </Border>
</Window>
