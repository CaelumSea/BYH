<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SelectionAssistant.UI.Views.ResultWindow"
        Title="BYH · Translation"
        Width="560"
        Height="430"
        MinWidth="420"
        MinHeight="320"
        WindowStartupLocation="CenterScreen"
        KeyDown="OnWindowKeyDown">
  <Border Padding="20" Classes="Card">
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="12">
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
        <StackPanel>
          <TextBlock Text="Translation"
                     Classes="DisplayTitle"
                     FontSize="20" />
          <TextBlock x:Name="LanguagePairText"
                     Text="English → 简体中文"
                     Classes="Secondary"
                     FontSize="12"
                     Margin="0,3,0,0" />
        </StackPanel>
        <Border Grid.Column="1"
                Classes="Badge"
                Padding="9,5"
                VerticalAlignment="Center">
          <TextBlock x:Name="ProviderText"
                     Text="测试提供器"
                     Classes="Accent"
                     FontSize="11" />
        </Border>
      </Grid>

      <Border Grid.Row="1"
              Classes="CardWarm"
              Padding="12">
        <StackPanel Spacing="6">
          <TextBlock Text="原文"
                     Classes="Muted"
                     FontSize="11" />
          <TextBox x:Name="SourceTextBox"
                   IsReadOnly="True"
                   AcceptsReturn="True"
                   TextWrapping="Wrap"
                   MaxHeight="92"
                   Background="Transparent"
                   BorderThickness="0"
                   Padding="0"
                   Foreground="{DynamicResource ByhTextPrimaryBrush}" />
        </StackPanel>
      </Border>

      <Grid Grid.Row="2">
        <ProgressBar x:Name="LoadingBar"
                     IsIndeterminate="True"
                     Height="3" />
        <TextBlock x:Name="ErrorText"
                   IsVisible="False"
                   Classes="FeedbackError"
                   TextWrapping="Wrap" />
      </Grid>

      <Border Grid.Row="3"
              Classes="Card"
              BorderBrush="{DynamicResource ByhPrimarySoftBrush}"
              BorderThickness="1"
              Padding="14">
        <TextBox x:Name="ResultTextBox"
                 Text="正在翻译…"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="0"
                 Foreground="{DynamicResource ByhTextPrimaryBrush}"
                 FontSize="15" />
      </Border>

      <Grid Grid.Row="4" ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8">
        <TextBlock x:Name="PrivacyText"
                   Text="MyMemory 测试模式 · 选中文字会通过 HTTPS 发送"
                   Classes="Muted"
                   FontSize="10"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
        <Button x:Name="CopySourceButton"
                Grid.Column="1"
                Content="复制原文"
                IsEnabled="False"
                Click="OnCopySourceClick" />
        <Button x:Name="CopyButton"
                Grid.Column="2"
                Classes="Primary"
                Content="复制译文"
                IsEnabled="False"
                Click="OnCopyClick" />
        <Button x:Name="ReplaceButton"
                Grid.Column="3"
                Classes="Ghost"
                Content="替换"
                IsEnabled="False"
                Click="OnReplaceClick" />
        <Button x:Name="RetryButton"
                Grid.Column="4"
                Content="重试"
                IsEnabled="False"
                Click="OnRetryClick" />
        <Button Grid.Column="5"
                Content="关闭"
                Click="OnCloseClick" />
      </Grid>
    </Grid>
  </Border>
</Window>
