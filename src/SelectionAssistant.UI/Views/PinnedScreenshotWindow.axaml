<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:anim="clr-namespace:Avalonia.Animation;assembly=Avalonia.Base"
        xmlns:i18n="clr-namespace:SelectionAssistant.Core.I18n;assembly=SelectionAssistant.Core"
        x:Class="SelectionAssistant.UI.Views.PinnedScreenshotWindow"
        Title="{x:Static i18n:Strings.Pinned_Title}"
        SizeToContent="WidthAndHeight"
        CanResize="False"
        ShowActivated="False"
        ShowInTaskbar="False"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        Background="Transparent"
        Topmost="True"
        Opacity="0">
  <!-- R56: pop-in scale animation is driven entirely from code-behind via a
       DispatcherTimer that rebuilds a center-scaled TransformOperations matrix
       each frame (no RenderTransform — that property's origin is broken on
       ExtendClientAreaToDecorationsHint frameless windows, per the v8-v12 log
       in handoff §22 / §R46-20). Opacity fade-in/out stays on the Window. -->
  <Window.Transitions>
    <anim:Transitions>
      <anim:DoubleTransition Property="Opacity" Duration="0:0:0.25"/>
    </anim:Transitions>
  </Window.Transitions>
  <!-- R52: snap guide canvas overlay. Positioned inside the Border but
       above the image. IsHitTestVisible=False so pointer events pass through
       to the drag handlers. Lines drawn at runtime when a snap edge is hit. -->
  <Panel>
    <!-- R55: outer shadow layer. The frameless transparent window is
         SizeToContent=WidthAndHeight, so without a margin the image sits
         flush against the window edge and BoxShadow (which only paints
         inside the element bounds and is clipped by ClipToBounds) would be
         invisible. Margin=24 grows the window on all sides to give the
         32px-blur shadow room to render; the window expands automatically.
         CornerRadius matches the inner Frame (both 11) so the soft shadow
         follows the same rounded corner as the image — no double outline.
         This Border MUST NOT set ClipToBounds (default false) — clipping
         here would cut the shadow.
         R97: the outer/inner radii are kept EQUAL (previously 14 outer vs
         12 inner produced two misaligned arcs = rough "double outline" at
         each corner). Radius also tuned to 11 — slightly smaller than the
         original 12 per user preference.
         R56: this Border is named so code-behind can read its Bounds (to bake
         a center-scaled matrix each animation frame). It carries NO
         RenderTransform in AXAML — the pop matrix is pushed from code-behind
         via TransformOperations (reliable on NativeAOT, unlike plain
         MatrixTransform), and the center offset is computed in code so we
         never rely on the broken RenderTransformOrigin property. -->
    <Border x:Name="OuterShadowBorder"
            Margin="24"
            Background="Transparent"
            CornerRadius="13"
            BoxShadow="0 12 32 0 #66000000"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
      <Border x:Name="Frame"
              Background="Transparent"
              BorderBrush="Transparent"
              BorderThickness="0"
              CornerRadius="13"
              Padding="0"
              ClipToBounds="True">
        <LayoutTransformControl x:Name="Scaler">
          <Image x:Name="ScreenshotImage"
                 Stretch="None" />
        </LayoutTransformControl>
      </Border>
    </Border>
    <Canvas x:Name="SnapGuideCanvas"
            IsHitTestVisible="False"
            IsVisible="False" />
  </Panel>
</Window>
