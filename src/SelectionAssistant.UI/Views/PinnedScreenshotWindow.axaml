<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:anim="clr-namespace:Avalonia.Animation;assembly=Avalonia.Base"
        x:Class="SelectionAssistant.UI.Views.PinnedScreenshotWindow"
        Title="BYH · Pinned"
        SizeToContent="WidthAndHeight"
        CanResize="False"
        ShowActivated="False"
        ShowInTaskbar="False"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        Background="Transparent"
        Topmost="True"
        Opacity="0">
  <!-- R46 v13: 回滚到 v9 的侧面滑入（用户决定 v8-v12 的 scale 弹性动画探索搁置）。
       TranslateTransform 从右下方屏幕外滑入到 (0,0) 目标位置。
       CubicEaseOut 300ms 快速减速。Opacity 配合凘入。 -->
  <Window.Transitions>
    <anim:Transitions>
      <anim:DoubleTransition Property="Opacity" Duration="0:0:0.25"/>
    </anim:Transitions>
  </Window.Transitions>
  <Window.RenderTransform>
    <TranslateTransform X="400" Y="100" />
  </Window.RenderTransform>
  <!-- R52: snap guide canvas overlay. Positioned inside the Border but
       above the image. IsHitTestVisible=False so pointer events pass through
       to the drag handlers. Lines drawn at runtime when a snap edge is hit. -->
  <Panel>
    <!-- R55: outer shadow layer. The frameless transparent window is
         SizeToContent=WidthAndHeight, so without a margin the image sits
         flush against the window edge and BoxShadow (which only paints
         inside the element bounds and is clipped by ClipToBounds) would be
         invisible. Margin=24 grows the window on all sides to give the
         32px-blur shadow room to render; the window expands automatically.
         CornerRadius=14 is slightly larger than the inner Frame's 12 so the
         soft shadow follows the rounded corner. This Border MUST NOT set
         ClipToBounds (default false) — clipping here would cut the shadow. -->
    <Border Margin="24"
            Background="Transparent"
            CornerRadius="14"
            BoxShadow="0 12 32 0 #66000000"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
      <Border x:Name="Frame"
              Background="Transparent"
              BorderBrush="Transparent"
              BorderThickness="0"
              CornerRadius="12"
              Padding="0"
              ClipToBounds="True">
        <LayoutTransformControl x:Name="Scaler">
          <Image x:Name="ScreenshotImage"
                 Stretch="None" />
        </LayoutTransformControl>
      </Border>
    </Border>
    <Canvas x:Name="SnapGuideCanvas"
            IsHitTestVisible="False"
            IsVisible="False" />
  </Panel>
</Window>
