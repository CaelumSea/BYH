<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SelectionAssistant.UI.Views"
        x:Class="SelectionAssistant.UI.Views.LongScreenshotWindow"
        x:DataType="vm:LongScreenshotWindow"
        Title="BYH · 长截图"
        Width="780" Height="720"
        MinWidth="500" MinHeight="400"
        CanResize="True"
        ShowActivated="True"
        ShowInTaskbar="True"
        WindowDecorations="Full"
        Background="#FFFCF7EA"
        KeyDown="OnKeyDown">
  <!-- R53: long-screenshot (manual scroll) session window. The user keeps the
       target window's region selected by Ocean Eyes and scrolls the target
       themselves; Space captures one frame (the runtime injects a BitBlt
       callback since the UI layer can't reference Platform.Windows), the
       stitcher appends it to a growing BGRA canvas, and the live preview
       grows downward with a ScrollViewer pinned to the bottom. Enter saves
       the merged PNG via the runtime; Esc cancels. Closing the window does
       NOT dismiss Ocean Eyes (same non-terminal pattern as P/G). -->
  <Grid RowDefinitions="Auto,*,Auto">
    <!-- Top bar: title + status hint -->
    <Border Grid.Row="0" Padding="16,12" Background="#22FFFFFF">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <TextBlock Text="📜 长截图" FontWeight="SemiBold" FontSize="16"
                   VerticalAlignment="Center"/>
        <TextBlock x:Name="StatusText" Classes="Secondary"
                   FontSize="12" VerticalAlignment="Center"
                   Text="滚动目标 · Space 截帧 · Enter 保存 · Esc 取消"/>
      </StackPanel>
    </Border>

    <!-- Live preview: ScrollViewer auto-pins to bottom as the canvas grows.
         Image.Stretch=Uniform fits the (fixed) region width to the viewport. -->
    <ScrollViewer Grid.Row="1"
                  x:Name="PreviewScroll"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto"
                  Padding="16">
      <Image x:Name="PreviewImage" Stretch="Uniform"
             HorizontalAlignment="Center"/>
    </ScrollViewer>

    <!-- Bottom bar: metrics + actions -->
    <Border Grid.Row="2" Padding="16,10" Background="#22FFFFFF">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock x:Name="FrameCountText" Classes="Secondary"
                   FontSize="12" VerticalAlignment="Center" Margin="0,0,16,0"/>
        <Button Click="OnCaptureClick" Content="📷 截帧 (Space)"/>
        <Button Click="OnSaveClick" Content="💾 保存 (Enter)" Classes="Primary"/>
        <Button Click="OnCancelClick" Content="取消 (Esc)"/>
        <TextBlock x:Name="WarnText" Foreground="#FFC08000" FontSize="12"
                   VerticalAlignment="Center" Margin="16,0,0,0"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
