<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SelectionAssistant.UI.Views"
        xmlns:i18n="clr-namespace:SelectionAssistant.Core.I18n;assembly=SelectionAssistant.Core"
        x:Class="SelectionAssistant.UI.Views.InstalledAppsScanDialog"
        Title="{x:Static i18n:Strings.ScanDialog_Title}"
        Width="640"
        Height="560"
        MinWidth="480"
        MinHeight="360"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        TransparencyLevelHint="AcrylicBlur"
        Background="Transparent"
        Topmost="True"
        KeyDown="OnWindowKeyDown">
  <Border x:Name="RootBorder"
          Classes="FloatingSurface"
          Padding="12"
          CornerRadius="12">
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="8">
      <!-- Header -->
      <StackPanel Grid.Row="0" Spacing="2">
        <TextBlock Text="{x:Static i18n:Strings.ScanDialog_Heading}"
                   Classes="CardTitle"
                   FontSize="{DynamicResource ByhFontSizeSubheading}"
                   FontWeight="SemiBold" />
        <TextBlock Text="{x:Static i18n:Strings.ScanDialog_Subtitle}"
                   Classes="Secondary"
                   FontSize="{DynamicResource ByhFontSizeBodySmall}"
                   TextWrapping="Wrap" />
      </StackPanel>

      <!-- Search box — bare TextBox (its own border is the single frame;
           an InnerCard wrapper here would double up into a two-layer look).
           .Bordered restores the classic TextBox frame since this input is
           not wrapped in an InnerCard. -->
      <TextBox Grid.Row="1"
               x:Name="SearchInput"
               Classes="Bordered"
               PlaceholderText="{x:Static i18n:Strings.ScanDialog_SearchPlaceholder}"
               FontSize="{DynamicResource ByhFontSizeBodyLarge}"
               TextChanged="OnSearchTextChanged" />

      <!-- Select-all row -->
      <Grid Grid.Row="2" ColumnDefinitions="Auto,*">
        <CheckBox x:Name="SelectAllCheckBox"
                  Content="{x:Static i18n:Strings.ScanDialog_SelectAll}"
                  IsCheckedChanged="OnSelectAllChanged" />
        <TextBlock x:Name="CountText"
                   Grid.Column="1"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Right"
                   Classes="Muted"
                   FontSize="{DynamicResource ByhFontSizeBody}" />
      </Grid>

      <!-- List -->
      <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
        <ItemsControl x:Name="ResultsList">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="views:ScanAppRow">
              <Grid ColumnDefinitions="32,*,Auto" Margin="0,4,16,4">
                <Image Source="{Binding Icon}"
                       Width="24"
                       Height="24"
                       VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Name}"
                             FontSize="{DynamicResource ByhFontSizeBodyLarge}"
                             FontWeight="SemiBold"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Path}"
                             FontSize="{DynamicResource ByhFontSizeBodySmall}"
                             Classes="Muted"
                             TextTrimming="CharacterEllipsis"
                             Opacity="0.6" />
                </StackPanel>
                <CheckBox Grid.Column="2"
                          IsChecked="{Binding IsSelected}"
                          VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <!-- Footer buttons -->
      <StackPanel Grid.Row="4"
                  Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  Spacing="10"
                  Margin="0,8,0,0">
        <Button Content="{x:Static i18n:Strings.Common_Cancel}"
                Classes="Ghost"
                Click="OnCancelClick" />
        <Button x:Name="ImportButton"
                Content="{x:Static i18n:Strings.ScanDialog_Import}"
                Classes="Primary"
                Click="OnImportClick" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
