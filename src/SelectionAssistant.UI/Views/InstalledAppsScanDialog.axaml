<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SelectionAssistant.UI.Views"
        x:Class="SelectionAssistant.UI.Views.InstalledAppsScanDialog"
        Title="BYH · 扫描已安装应用"
        Width="640"
        Height="560"
        MinWidth="480"
        MinHeight="360"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        TransparencyLevelHint="AcrylicBlur"
        Background="Transparent"
        Topmost="True"
        KeyDown="OnWindowKeyDown">
  <Border x:Name="RootBorder"
          Classes="FloatingSurface"
          Padding="12"
          CornerRadius="12">
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="8">
      <!-- Header -->
      <StackPanel Grid.Row="0" Spacing="2">
        <TextBlock Text="扫描已安装应用"
                   Classes="CardTitle"
                   FontSize="15"
                   FontWeight="SemiBold" />
        <TextBlock Text="勾选要导入的应用，点击导入即可在 Launcher 和 Spotlight 中使用。"
                   Classes="Secondary"
                   FontSize="10"
                   TextWrapping="Wrap" />
      </StackPanel>

      <!-- Search box — bare TextBox (its own border is the single frame;
           an InnerCard wrapper here would double up into a two-layer look). -->
      <TextBox Grid.Row="1"
               x:Name="SearchInput"
               PlaceholderText="搜索应用名称..."
               FontSize="12"
               TextChanged="OnSearchTextChanged" />

      <!-- Select-all row -->
      <Grid Grid.Row="2" ColumnDefinitions="Auto,*">
        <CheckBox x:Name="SelectAllCheckBox"
                  Content="全选/全不选"
                  IsCheckedChanged="OnSelectAllChanged" />
        <TextBlock x:Name="CountText"
                   Grid.Column="1"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Right"
                   Classes="Muted"
                   FontSize="11" />
      </Grid>

      <!-- List -->
      <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
        <ItemsControl x:Name="ResultsList">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="views:ScanAppRow">
              <Grid ColumnDefinitions="32,*,Auto" Margin="0,4,16,4">
                <Image Source="{Binding Icon}"
                       Width="24"
                       Height="24"
                       VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Name}"
                             FontSize="12"
                             FontWeight="SemiBold"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Path}"
                             FontSize="10"
                             Classes="Muted"
                             TextTrimming="CharacterEllipsis"
                             Opacity="0.6" />
                </StackPanel>
                <CheckBox Grid.Column="2"
                          IsChecked="{Binding IsSelected}"
                          VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <!-- Footer buttons -->
      <StackPanel Grid.Row="4"
                  Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  Spacing="10"
                  Margin="0,8,0,0">
        <Button Content="取消"
                Classes="Ghost"
                Click="OnCancelClick" />
        <Button x:Name="ImportButton"
                Content="导入选中"
                Classes="Primary"
                Click="OnImportClick" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
