<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="clr-namespace:SelectionAssistant.Core.I18n;assembly=SelectionAssistant.Core"
        x:Class="SelectionAssistant.UI.Views.PromptWindow"
        Title="{x:Static i18n:Strings.Prompt_Title}"
        Width="480"
        Height="260"
        MinWidth="380"
        MinHeight="200"
        CanResize="True"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        KeyDown="OnWindowKeyDown">
  <Border Padding="16">
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">

      <StackPanel Grid.Row="0" Spacing="4">
        <TextBlock Text="{x:Static i18n:Strings.Prompt_Heading}"
                   Classes="DisplayTitle"
                   FontSize="{DynamicResource ByhFontSizeHeading}" />
        <TextBlock x:Name="SourcePreview"
                   Text="{x:Static i18n:Strings.Prompt_DefaultPreview}"
                   Classes="Secondary"
                   FontSize="{DynamicResource ByhFontSizeBody}"
                   TextWrapping="Wrap" />
      </StackPanel>

      <TextBox Grid.Row="1"
               x:Name="PromptInput"
               PlaceholderText="{x:Static i18n:Strings.Prompt_Placeholder}"
               AcceptsReturn="True"
               TextWrapping="Wrap"
               FontSize="{DynamicResource ByhFontSizeBodyLarge}" />

      <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
        <TextBlock Text="{x:Static i18n:Strings.Prompt_FooterHint}"
                   Classes="Muted"
                   FontSize="{DynamicResource ByhFontSizeBodySmall}"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
        <Button Grid.Column="1"
                Content="{x:Static i18n:Strings.Common_Cancel}"
                Click="OnCancelClick" />
        <Button Grid.Column="2"
                x:Name="RunButton"
                Classes="Primary"
                Content="{x:Static i18n:Strings.Common_Run}"
                IsEnabled="False"
                Click="OnRunClick" />
      </Grid>
    </Grid>
  </Border>
</Window>
