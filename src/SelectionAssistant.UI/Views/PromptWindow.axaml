<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SelectionAssistant.UI.Views.PromptWindow"
        Title="BYH · Prompt Now"
        Width="480"
        Height="260"
        MinWidth="380"
        MinHeight="200"
        CanResize="True"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        KeyDown="OnWindowKeyDown">
  <Border Padding="16">
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">

      <StackPanel Grid.Row="0" Spacing="4">
        <TextBlock Text="Prompt Now"
                   Classes="DisplayTitle"
                   FontSize="18" />
        <TextBlock x:Name="SourcePreview"
                   Text="对已选中的文字运行你输入的指令。"
                   Classes="Secondary"
                   FontSize="11"
                   TextWrapping="Wrap" />
      </StackPanel>

      <TextBox Grid.Row="1"
               x:Name="PromptInput"
               PlaceholderText="例如：用一句话解释这段代码在做什么"
               AcceptsReturn="True"
               TextWrapping="Wrap"
               FontSize="13" />

      <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
        <TextBlock Text="用当前 Provider 运行 · 结果会流式显示"
                   Classes="Muted"
                   FontSize="10"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
        <Button Grid.Column="1"
                Content="取消"
                Click="OnCancelClick" />
        <Button Grid.Column="2"
                x:Name="RunButton"
                Classes="Primary"
                Content="运行"
                IsEnabled="False"
                Click="OnRunClick" />
      </Grid>
    </Grid>
  </Border>
</Window>
