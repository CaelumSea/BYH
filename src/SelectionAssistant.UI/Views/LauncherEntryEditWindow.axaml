<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="clr-namespace:SelectionAssistant.Core.I18n;assembly=SelectionAssistant.Core"
        x:Class="SelectionAssistant.UI.Views.LauncherEntryEditWindow"
        Title="{x:Static i18n:Strings.LauncherEdit_Title}"
        Width="520"
        Height="460"
        MinWidth="420"
        MinHeight="360"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        Topmost="True"
        KeyDown="OnWindowKeyDown">
  <Border Padding="16">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="10">

      <StackPanel Grid.Row="0" Spacing="4">
        <TextBlock x:Name="TitleText"
                   Text="{x:Static i18n:Strings.LauncherEdit_Heading}"
                   Classes="DisplayTitle"
                   FontSize="{DynamicResource ByhFontSizeHeading}" />
        <TextBlock x:Name="SubtitleText"
                   Text="{x:Static i18n:Strings.LauncherEdit_Subtitle}"
                   Classes="Secondary"
                   FontSize="{DynamicResource ByhFontSizeBody}"
                   TextWrapping="Wrap" />
      </StackPanel>

      <!-- Type selection -->
      <StackPanel Grid.Row="1" Spacing="4">
        <TextBlock Text="{x:Static i18n:Strings.LauncherEdit_Kind}" Classes="Muted" FontSize="{DynamicResource ByhFontSizeBody}" />
        <StackPanel Orientation="Horizontal" Spacing="16">
          <RadioButton x:Name="LocalAppRadio"
                       Content="{x:Static i18n:Strings.LauncherEdit_KindLocal}"
                       GroupName="LauncherKind"
                       IsChecked="True"
                       IsCheckedChanged="OnKindCheckedChanged" />
          <RadioButton x:Name="WebUrlRadio"
                       Content="{x:Static i18n:Strings.LauncherEdit_KindWeb}"
                       GroupName="LauncherKind"
                       IsCheckedChanged="OnKindCheckedChanged" />
        </StackPanel>
      </StackPanel>

      <!-- Name -->
      <StackPanel Grid.Row="2" Spacing="4">
        <TextBlock Text="{x:Static i18n:Strings.LauncherEdit_Name}" Classes="Muted" FontSize="{DynamicResource ByhFontSizeBody}" />
        <TextBox x:Name="NameInput"
                 PlaceholderText="{x:Static i18n:Strings.LauncherEdit_NamePlaceholder}"
                 FontSize="{DynamicResource ByhFontSizeBodyLarge}" />
      </StackPanel>

      <!-- Target -->
      <StackPanel Grid.Row="3" Spacing="4">
        <TextBlock x:Name="TargetLabel" Text="{x:Static i18n:Strings.LauncherEdit_Target}" Classes="Muted" FontSize="{DynamicResource ByhFontSizeBody}" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBox x:Name="TargetInput"
                   PlaceholderText="{x:Static i18n:Strings.LauncherEdit_TargetPlaceholder}"
                   FontSize="{DynamicResource ByhFontSizeBodyLarge}" />
          <Button Grid.Column="1"
                  x:Name="BrowseTargetButton"
                  Content="{x:Static i18n:Strings.Common_Browse}"
                  Click="OnBrowseTargetClick" />
        </Grid>
      </StackPanel>

      <!-- Arguments -->
      <StackPanel Grid.Row="4" Spacing="4">
        <TextBlock Text="{x:Static i18n:Strings.LauncherEdit_Args}" Classes="Muted" FontSize="{DynamicResource ByhFontSizeBody}" />
        <TextBox x:Name="ArgumentsInput"
                 PlaceholderText="{x:Static i18n:Strings.LauncherEdit_ArgsPlaceholder}"
                 FontSize="{DynamicResource ByhFontSizeBodyLarge}" />
      </StackPanel>

      <!-- Working directory (local app only) -->
      <StackPanel Grid.Row="5" x:Name="WorkingDirectoryPanel" Spacing="4" IsVisible="False">
        <TextBlock Text="{x:Static i18n:Strings.LauncherEdit_WorkDir}" Classes="Muted" FontSize="{DynamicResource ByhFontSizeBody}" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBox x:Name="WorkingDirectoryInput"
                   PlaceholderText="{x:Static i18n:Strings.LauncherEdit_WorkDirPlaceholder}"
                   FontSize="{DynamicResource ByhFontSizeBodyLarge}" />
          <Button Grid.Column="1"
                  Content="{x:Static i18n:Strings.Common_Browse}"
                  Click="OnBrowseWorkDirClick" />
        </Grid>
      </StackPanel>

      <!-- Icon preview -->
      <StackPanel Grid.Row="6" x:Name="IconPreviewPanel" Spacing="4" IsVisible="False">
        <TextBlock Text="{x:Static i18n:Strings.LauncherEdit_IconPreview}" Classes="Muted" FontSize="{DynamicResource ByhFontSizeBody}" />
        <Border Width="24" Height="24" CornerRadius="4" ClipToBounds="True">
          <Image x:Name="IconPreview" Width="24" Height="24" />
        </Border>
      </StackPanel>

      <!-- Save / Cancel -->
      <Grid Grid.Row="7" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
        <TextBlock Text="{x:Static i18n:Strings.LauncherEdit_ArgsHint}"
                   Classes="Muted"
                   FontSize="{DynamicResource ByhFontSizeCaption}"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
        <Button Grid.Column="1"
                Content="{x:Static i18n:Strings.Common_Cancel}"
                Click="OnCancelClick" />
        <Button Grid.Column="2"
                x:Name="SaveButton"
                Classes="Primary"
                Content="{x:Static i18n:Strings.Common_Save}"
                Click="OnSaveClick" />
      </Grid>
    </Grid>
  </Border>
</Window>
