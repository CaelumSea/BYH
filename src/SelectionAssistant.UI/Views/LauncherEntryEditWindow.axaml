<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SelectionAssistant.UI.Views.LauncherEntryEditWindow"
        Title="BYH · 编辑启动项"
        Width="520"
        Height="460"
        MinWidth="420"
        MinHeight="360"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        Topmost="True"
        KeyDown="OnWindowKeyDown">
  <Border Padding="16">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="10">

      <StackPanel Grid.Row="0" Spacing="4">
        <TextBlock x:Name="TitleText"
                   Text="编辑启动项"
                   Classes="DisplayTitle"
                   FontSize="18" />
        <TextBlock x:Name="SubtitleText"
                   Text="配置启动参数后，可在 Spotlight 搜索面板一键启动。"
                   Classes="Secondary"
                   FontSize="11"
                   TextWrapping="Wrap" />
      </StackPanel>

      <!-- Type selection -->
      <StackPanel Grid.Row="1" Spacing="4">
        <TextBlock Text="类型" Classes="Muted" FontSize="11" />
        <StackPanel Orientation="Horizontal" Spacing="16">
          <RadioButton x:Name="LocalAppRadio"
                       Content="本地软件"
                       GroupName="LauncherKind"
                       IsChecked="True"
                       IsCheckedChanged="OnKindCheckedChanged" />
          <RadioButton x:Name="WebUrlRadio"
                       Content="网页"
                       GroupName="LauncherKind"
                       IsCheckedChanged="OnKindCheckedChanged" />
        </StackPanel>
      </StackPanel>

      <!-- Name -->
      <StackPanel Grid.Row="2" Spacing="4">
        <TextBlock Text="名称" Classes="Muted" FontSize="11" />
        <TextBox x:Name="NameInput"
                 PlaceholderText="例如：记事本、Google 翻译…"
                 FontSize="13" />
      </StackPanel>

      <!-- Target -->
      <StackPanel Grid.Row="3" Spacing="4">
        <TextBlock x:Name="TargetLabel" Text="目标" Classes="Muted" FontSize="11" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBox x:Name="TargetInput"
                   PlaceholderText="程序路径或网页地址"
                   FontSize="13" />
          <Button Grid.Column="1"
                  x:Name="BrowseTargetButton"
                  Content="浏览…"
                  Click="OnBrowseTargetClick" />
        </Grid>
      </StackPanel>

      <!-- Arguments -->
      <StackPanel Grid.Row="4" Spacing="4">
        <TextBlock Text="参数" Classes="Muted" FontSize="11" />
        <TextBox x:Name="ArgumentsInput"
                 PlaceholderText="支持 {clip} {sel} {prompt:提示语}"
                 FontSize="13" />
      </StackPanel>

      <!-- Working directory (local app only) -->
      <StackPanel Grid.Row="5" x:Name="WorkingDirectoryPanel" Spacing="4" IsVisible="False">
        <TextBlock Text="工作目录" Classes="Muted" FontSize="11" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBox x:Name="WorkingDirectoryInput"
                   PlaceholderText="留空则使用程序所在目录"
                   FontSize="13" />
          <Button Grid.Column="1"
                  Content="浏览…"
                  Click="OnBrowseWorkDirClick" />
        </Grid>
      </StackPanel>

      <!-- Icon preview -->
      <StackPanel Grid.Row="6" x:Name="IconPreviewPanel" Spacing="4" IsVisible="False">
        <TextBlock Text="图标预览" Classes="Muted" FontSize="11" />
        <Border Width="24" Height="24" CornerRadius="4" ClipToBounds="True">
          <Image x:Name="IconPreview" Width="24" Height="24" />
        </Border>
      </StackPanel>

      <!-- Save / Cancel -->
      <Grid Grid.Row="7" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
        <TextBlock Text="参数中 {clip} 会替换为剪贴板内容，{sel} 替换为选中文本。"
                   Classes="Muted"
                   FontSize="9"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
        <Button Grid.Column="1"
                Content="取消"
                Click="OnCancelClick" />
        <Button Grid.Column="2"
                x:Name="SaveButton"
                Classes="Primary"
                Content="保存"
                Click="OnSaveClick" />
      </Grid>
    </Grid>
  </Border>
</Window>
