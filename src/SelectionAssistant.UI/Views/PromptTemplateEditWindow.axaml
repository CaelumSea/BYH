<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SelectionAssistant.UI.Views.PromptTemplateEditWindow"
        Title="BYH · 编辑提示词"
        Width="520"
        Height="380"
        MinWidth="420"
        MinHeight="300"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        Topmost="True"
        KeyDown="OnWindowKeyDown">
  <Border Padding="16">
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto" RowSpacing="10">

      <StackPanel Grid.Row="0" Spacing="4">
        <TextBlock x:Name="TitleText"
                   Text="编辑提示词"
                   Classes="DisplayTitle"
                   FontSize="18" />
        <TextBlock x:Name="SubtitleText"
                   Text="修改后所有 Provider 立即生效。留空（仅翻译）= 用内置翻译模板。"
                   Classes="Secondary"
                   FontSize="11"
                   TextWrapping="Wrap" />
      </StackPanel>

      <StackPanel Grid.Row="1" x:Name="NamePanel" Spacing="4" IsVisible="False">
        <TextBlock Text="功能名称"
                   Classes="Muted"
                   FontSize="11" />
        <TextBox x:Name="NameInput"
                 PlaceholderText="例如：润色、改写、续写…"
                 FontSize="13" />
      </StackPanel>

      <TextBlock Grid.Row="2"
                 x:Name="DefaultHintText"
                 Classes="Muted"
                 FontSize="10"
                 TextWrapping="Wrap" />

      <TextBox Grid.Row="3"
               x:Name="PromptInput"
               AcceptsReturn="True"
               TextWrapping="Wrap"
               FontSize="13" />

      <CheckBox Grid.Row="4"
                x:Name="ThinkingCheckBox"
                Content="允许模型思考（思考模式会增加延迟；适合解释/总结，翻译一般关闭）"
                FontSize="11"
                IsChecked="False" />

      <!-- R34: per-template toolbar shortcut. Single character; fires while the
           selection toolbar is visible. Blank = no shortcut for this action. -->
      <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <TextBlock Text="工具栏快捷键："
                   Classes="Muted"
                   FontSize="11"
                   VerticalAlignment="Center" />
        <TextBox x:Name="ShortcutInput"
                 MaxLength="1"
                 Width="40"
                 FontSize="13"
                 PlaceholderText="无" />
        <TextBlock Text="（划词弹出工具栏后按此键即触发该动作；留空则不绑定）"
                   Classes="Secondary"
                   FontSize="10"
                   VerticalAlignment="Center"
                   TextWrapping="Wrap" />
      </StackPanel>

      <Grid Grid.Row="6" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
        <Button Grid.Column="0"
                x:Name="ResetButton"
                Classes="DangerQuiet"
                Content="恢复默认"
                Click="OnResetClick" />
        <Button Grid.Column="2"
                Content="取消"
                Click="OnCancelClick" />
        <Button Grid.Column="3"
                x:Name="SaveButton"
                Classes="Primary"
                Content="保存"
                Click="OnSaveClick" />
      </Grid>
    </Grid>
  </Border>
</Window>
