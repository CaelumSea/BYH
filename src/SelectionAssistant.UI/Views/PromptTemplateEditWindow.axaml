<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="clr-namespace:SelectionAssistant.Core.I18n;assembly=SelectionAssistant.Core"
        x:Class="SelectionAssistant.UI.Views.PromptTemplateEditWindow"
        Title="{x:Static i18n:Strings.PromptEdit_Title}"
        Width="520"
        Height="380"
        MinWidth="420"
        MinHeight="300"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        Topmost="True"
        KeyDown="OnWindowKeyDown">
  <Border Padding="16">
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto" RowSpacing="10">

      <StackPanel Grid.Row="0" Spacing="4">
        <TextBlock x:Name="TitleText"
                   Text="{x:Static i18n:Strings.PromptEdit_Heading}"
                   Classes="DisplayTitle"
                   FontSize="18" />
        <TextBlock x:Name="SubtitleText"
                   Text="{x:Static i18n:Strings.PromptEdit_Subtitle}"
                   Classes="Secondary"
                   FontSize="11"
                   TextWrapping="Wrap" />
      </StackPanel>

      <StackPanel Grid.Row="1" x:Name="NamePanel" Spacing="4" IsVisible="False">
        <TextBlock Text="{x:Static i18n:Strings.PromptEdit_Name}"
                   Classes="Muted"
                   FontSize="11" />
        <TextBox x:Name="NameInput"
                 PlaceholderText="{x:Static i18n:Strings.PromptEdit_NamePlaceholder}"
                 FontSize="13" />
      </StackPanel>

      <TextBlock Grid.Row="2"
                 x:Name="DefaultHintText"
                 Classes="Muted"
                 FontSize="10"
                 TextWrapping="Wrap" />

      <TextBox Grid.Row="3"
               x:Name="PromptInput"
               AcceptsReturn="True"
               TextWrapping="Wrap"
               FontSize="13" />

      <CheckBox Grid.Row="4"
                x:Name="ThinkingCheckBox"
                Content="{x:Static i18n:Strings.PromptEdit_AllowThinking}"
                FontSize="11"
                IsChecked="False" />

      <!-- R34: per-template toolbar shortcut. Single character; fires while the
           selection toolbar is visible. Blank = no shortcut for this action. -->
      <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <TextBlock Text="{x:Static i18n:Strings.PromptEdit_ShortcutLabel}"
                   Classes="Muted"
                   FontSize="11"
                   VerticalAlignment="Center" />
        <TextBox x:Name="ShortcutInput"
                 MaxLength="1"
                 Width="40"
                 FontSize="13"
                 PlaceholderText="{x:Static i18n:Strings.Common_Placeholder_None}" />
        <TextBlock Text="{x:Static i18n:Strings.PromptEdit_ShortcutHint}"
                   Classes="Secondary"
                   FontSize="10"
                   VerticalAlignment="Center"
                   TextWrapping="Wrap" />
      </StackPanel>

      <Grid Grid.Row="6" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
        <Button Grid.Column="0"
                x:Name="ResetButton"
                Classes="DangerQuiet"
                Content="{x:Static i18n:Strings.PromptEdit_Reset}"
                Click="OnResetClick" />
        <Button Grid.Column="2"
                Content="{x:Static i18n:Strings.Common_Cancel}"
                Click="OnCancelClick" />
        <Button Grid.Column="3"
                x:Name="SaveButton"
                Classes="Primary"
                Content="{x:Static i18n:Strings.Common_Save}"
                Click="OnSaveClick" />
      </Grid>
    </Grid>
  </Border>
</Window>
