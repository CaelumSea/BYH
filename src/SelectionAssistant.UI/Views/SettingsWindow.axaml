<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SelectionAssistant.UI.Views"
        xmlns:i18n="clr-namespace:SelectionAssistant.Core.I18n;assembly=SelectionAssistant.Core"
        x:Class="SelectionAssistant.UI.Views.SettingsWindow"
        Title="{x:Static i18n:Strings.Settings_Title}"
        Width="1320"
        Height="840"
        MinWidth="1240"
        MinHeight="720"
        CanResize="True"
        Background="{DynamicResource ByhBackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        AutomationProperties.AutomationId="BYH.Settings.Window"
        KeyDown="OnWindowKeyDown">
  <Grid x:Name="ShellGrid"
          RowDefinitions="2.15*,1*"
          ColumnSpacing="12"
          RowSpacing="24"
          Margin="12,12,12,20">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="190" />
        <ColumnDefinition Width="170" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="270" />
      </Grid.ColumnDefinitions>

    <!-- R54 atmosphere: a large warm radial glow behind the floating panels,
         echoing the soft bokeh light pools in the Foamie reference. -->
    <Border Grid.Column="0" Grid.ColumnSpan="4" Grid.Row="0" Grid.RowSpan="2"
            Background="{DynamicResource ByhAtmosphereBrush}"
            IsHitTestVisible="False" />

    <!-- The ornament sits behind navigation content while MetallicFrame keeps
         the reference's close, concentric champagne-gold double curve. -->
    <Border Grid.Column="1"
            Grid.Row="0"
            Classes="MetallicFrame Compact Thin">
      <Border Classes="MacroClip Compact"
              Background="{DynamicResource ByhPanelIvoryBrush}">
        <Grid>
        <Image Source="avares://SelectionAssistant.UI/Assets/Theme/ivory-jade-ornament.jpg"
               Stretch="UniformToFill"
               Opacity="0.30"
               IsHitTestVisible="False" />
        <Grid Margin="8,8,8,7" RowDefinitions="Auto,*,Auto">
        <StackPanel Grid.Row="0" Spacing="3" Margin="4,0,4,7">
          <Border Width="48"
                  Height="48"
                  HorizontalAlignment="Center"
                  Background="{DynamicResource ByhGemGlowBrush}"
                  CornerRadius="24"
                  Padding="3">
            <Border Width="42"
                    Height="42"
                    Background="{DynamicResource ByhSurfaceBrush}"
                    BorderBrush="{DynamicResource ByhHairlineBrush}"
                    BorderThickness="1"
                    CornerRadius="21"
                    ClipToBounds="True">
              <Image Source="avares://SelectionAssistant.UI/Assets/Theme/ivory-jade-emblem.jpg"
                     Width="60"
                     Height="60"
                     Stretch="UniformToFill"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />
            </Border>
          </Border>
          <TextBlock Text="BYH"
                     Classes="DisplayTitle"
                     FontSize="{DynamicResource ByhFontSizeDisplay}"
                     HorizontalAlignment="Center" />
          <TextBlock Text="By Your Hand"
                     Classes="Secondary"
                     FontSize="{DynamicResource ByhFontSizeBodySmall}"
                     HorizontalAlignment="Center" />
          <Border Width="32"
                  Height="2"
                  HorizontalAlignment="Center"
                  Background="{DynamicResource ByhGoldBrush}"
                  CornerRadius="1" />
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="3" VerticalAlignment="Top">

          <Button x:Name="DashboardNavButton"
                  Classes="SettingsNav Active"
                  Padding="12,8"
                  AutomationProperties.AutomationId="BYH.Settings.Nav.Dashboard"
                  Click="OnShowDashboardClick">
            <Grid ColumnDefinitions="22,*" ColumnSpacing="9">
              <Path Classes="NavIcon"
                    Data="M4,4 L10,4 L10,10 L4,10 Z M14,4 L20,4 L20,10 L14,10 Z M4,14 L10,14 L10,20 L4,20 Z M14,14 L20,14 L20,20 L14,20 Z" />
              <TextBlock Grid.Column="1" Text="{x:Static i18n:Strings.Settings_Nav_Dashboard}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
            </Grid>
          </Button>

          <Button x:Name="GeneralNavButton"
                  Classes="SettingsNav"
                  Padding="12,8"
                  AutomationProperties.AutomationId="BYH.Settings.Nav.General"
                  Click="OnShowGeneralClick">
            <Grid ColumnDefinitions="22,*" ColumnSpacing="9">
              <Path Classes="NavIcon"
                    Data="M3,10 L12,3 L21,10 M5,9 L5,20 L19,20 L19,9 M9,20 L9,14 L15,14 L15,20" />
              <TextBlock Grid.Column="1" Text="{x:Static i18n:Strings.Settings_Nav_General}" FontSize="{DynamicResource ByhFontSizeBodyLarge}" FontWeight="SemiBold" VerticalAlignment="Center" />
            </Grid>
          </Button>

          <Button x:Name="ProviderNavButton"
                  Classes="SettingsNav"
                  Padding="12,8"
                  AutomationProperties.AutomationId="BYH.Settings.Nav.Translation"
                  Click="OnShowProviderClick">
            <Grid ColumnDefinitions="22,*" ColumnSpacing="9">
              <Path Classes="NavIcon"
                    Data="M4,5 L20,5 L20,19 L4,19 Z M8,9 L16,9 M8,13 L16,13 M8,17 L13,17" />
              <TextBlock Grid.Column="1" Text="{x:Static i18n:Strings.Settings_Nav_Provider}" FontSize="{DynamicResource ByhFontSizeBodyLarge}" FontWeight="SemiBold" VerticalAlignment="Center" />
            </Grid>
          </Button>

          <Button x:Name="FunctionsNavButton"
                  Classes="SettingsNav"
                  Padding="12,8"
                  AutomationProperties.AutomationId="BYH.Settings.Nav.Actions"
                  Click="OnShowFunctionsClick">
            <Grid ColumnDefinitions="22,*" ColumnSpacing="9">
              <Path Classes="NavIcon"
                    Data="M12,3 L14.7,8.3 L20.5,9.2 L16.3,13.3 L17.3,19 L12,16.3 L6.7,19 L7.7,13.3 L3.5,9.2 L9.3,8.3 Z" />
              <TextBlock Grid.Column="1" Text="{x:Static i18n:Strings.Settings_Nav_Functions}" FontSize="{DynamicResource ByhFontSizeBodyLarge}" FontWeight="SemiBold" VerticalAlignment="Center" />
            </Grid>
          </Button>

          <Button x:Name="VisionNavButton"
                  Classes="SettingsNav"
                  Padding="12,8"
                  AutomationProperties.AutomationId="BYH.Settings.Nav.Vision"
                  Click="OnShowVisionClick">
            <Grid ColumnDefinitions="22,*" ColumnSpacing="9">
              <Path Classes="NavIcon"
                    Data="M2,12 C5.2,6.8 8.5,5 12,5 C15.5,5 18.8,6.8 22,12 C18.8,17.2 15.5,19 12,19 C8.5,19 5.2,17.2 2,12 Z M12,9 A3,3 0 1 0 12,15 A3,3 0 1 0 12,9" />
              <TextBlock Grid.Column="1" Text="{x:Static i18n:Strings.Settings_Nav_Vision}" FontSize="{DynamicResource ByhFontSizeBodyLarge}" FontWeight="SemiBold" VerticalAlignment="Center" />
            </Grid>
          </Button>

          <Button x:Name="LauncherNavButton"
                  Classes="SettingsNav"
                  Padding="12,8"
                  AutomationProperties.AutomationId="BYH.Settings.Nav.Launcher"
                  Click="OnShowLauncherClick">
            <Grid ColumnDefinitions="22,*" ColumnSpacing="9">
              <Path Classes="NavIcon"
                    Data="M13,2 L4,13 L11,13 L10,22 L20,10 L13,10 Z" />
              <TextBlock Grid.Column="1" Text="{x:Static i18n:Strings.Settings_Nav_Launcher}" FontSize="{DynamicResource ByhFontSizeBodyLarge}" FontWeight="SemiBold" VerticalAlignment="Center" />
            </Grid>
          </Button>

          <Button x:Name="ClipboardHistoryNavButton"
                  Classes="SettingsNav"
                  Padding="12,8"
                  AutomationProperties.AutomationId="BYH.Settings.Nav.Clipboard"
                  Click="OnShowClipboardHistoryClick">
            <Grid ColumnDefinitions="22,*" ColumnSpacing="9">
              <Path Classes="NavIcon"
                    Data="M4,2 L20,2 A2,2 0 0 1 22,4 L22,16 A2,2 0 0 1 20,18 L8,18 L4,22 Z" />
              <TextBlock Grid.Column="1" Text="{x:Static i18n:Strings.Settings_Nav_Clipboard}" FontSize="{DynamicResource ByhFontSizeBodyLarge}" FontWeight="SemiBold" VerticalAlignment="Center" />
            </Grid>
          </Button>
        </StackPanel>

        <!-- Reference nav card carries a gem ornament at both ends; this is
             the smaller foot gem mirroring the emblem above the brand. -->
        <Border Grid.Row="2"
                Width="22"
                Height="22"
                CornerRadius="11"
                Background="{DynamicResource ByhGemGlowBrush}"
                Padding="2"
                HorizontalAlignment="Center"
                Margin="0,4,0,0">
          <Border Width="18"
                  Height="18"
                  CornerRadius="9"
                  Background="{DynamicResource ByhSurfaceBrush}"
                  BorderBrush="{DynamicResource ByhHairlineBrush}"
                  BorderThickness="1"
                  ClipToBounds="True">
            <Image Source="avares://SelectionAssistant.UI/Assets/Theme/ivory-jade-emblem.jpg"
                   Width="26"
                   Height="26"
                   Stretch="UniformToFill"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />
          </Border>
        </Border>

          </Grid>
        </Grid>
      </Border>
    </Border>


    <!-- Main work pane: the selected dashboard or settings category remains
         independently scrollable inside one calm, continuous surface. -->
    <Border Grid.Column="2"
            Grid.Row="0"
            Classes="MetallicFrame Thin MainWorkspaceFrame">
        <Border Classes="MacroClip">
        <Grid RowDefinitions="Auto,*">
      <Image Grid.RowSpan="2"
             Source="avares://SelectionAssistant.UI/Assets/Theme/ivory-jade-ornament.jpg"
             Stretch="UniformToFill"
             Opacity="0.09"
             IsHitTestVisible="False" />
      <!-- Foreground content stays quiet while the shared pearl ornament
           remains a very faint, non-interactive atmosphere layer. -->
      <Grid Grid.Row="0"
            ColumnDefinitions="*,Auto"
            RowDefinitions="Auto,Auto"
            ColumnSpacing="24"
            RowSpacing="12"
            Margin="28,22,26,12">
          <StackPanel Spacing="3">
            <TextBlock Text="{x:Static i18n:Strings.Settings_Header_Kicker}" Classes="Kicker" />
            <StackPanel Orientation="Horizontal" Spacing="9">
              <TextBlock x:Name="PageTitleText"
                         Text="{x:Static i18n:Strings.Settings_PageTitle_General}"
                         Classes="DisplayTitle"
                         AutomationProperties.AutomationId="BYH.Settings.PageTitle"
                         FontSize="{DynamicResource ByhFontSizeDisplay}" />
              <TextBlock Text="✦"
                         Foreground="{DynamicResource ByhGoldBrush}"
                         FontSize="{DynamicResource ByhFontSizeHeading}"
                         VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="PageSubtitleText"
                       Text="{x:Static i18n:Strings.Settings_PageSubtitle_General}"
                       Classes="Secondary"
                       FontSize="{DynamicResource ByhFontSizeBodySmall}" />
          </StackPanel>
          <Border Grid.Column="1"
                  Classes="ThemePill"
                  VerticalAlignment="Center"
                  Padding="6,5">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Border Width="22" Height="22" CornerRadius="11" Background="{DynamicResource ByhGemGlowBrush}" Padding="2">
                <Border Width="18" Height="18" CornerRadius="9" ClipToBounds="True">
                  <Image Source="avares://SelectionAssistant.UI/Assets/Theme/ivory-jade-emblem.jpg"
                         Width="24"
                         Height="24"
                         Stretch="UniformToFill"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
                </Border>
              </Border>
              <TextBlock Text="IVORY JADE"
                         Classes="Accent"
                         FontSize="{DynamicResource ByhFontSizeCaption}"
                         FontWeight="SemiBold"
                         VerticalAlignment="Center" />
            </StackPanel>
          </Border>
          <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8">
            <Border Classes="HeroPill" Padding="8,4">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <Border Width="5" Height="5" CornerRadius="2.5"
                        Background="{DynamicResource ByhSuccessBrush}"
                        VerticalAlignment="Center" />
                <TextBlock Text="LOCAL FIRST" Classes="Accent" FontSize="{DynamicResource ByhFontSizeCaption}" FontWeight="SemiBold" />
              </StackPanel>
            </Border>
            <Border Classes="HeroPill" Padding="8,4">
              <TextBlock Text="INSTANT CAPTURE" Classes="Secondary" FontSize="{DynamicResource ByhFontSizeCaption}" FontWeight="SemiBold" />
            </Border>
            <Border Classes="HeroPill" Padding="8,4">
              <TextBlock Text="WINDOWS NATIVEAOT" Classes="Secondary" FontSize="{DynamicResource ByhFontSizeCaption}" FontWeight="SemiBold" />
            </Border>
          </StackPanel>
      </Grid>

      <ScrollViewer x:Name="SettingsContentScroll"
                    Grid.Row="1"
                    Padding="0"
                    AutomationProperties.AutomationId="BYH.Settings.ContentScroll"
                    VerticalScrollBarVisibility="Hidden"
                    HorizontalScrollBarVisibility="Disabled">
        <!-- Keep one shared bottom safe area inside the scroll extent.  The
             continuous-surface redesign removed the old 28 px ScrollViewer
             padding, which left most pages ending directly under the rounded
             clip even though their offset had technically reached 100%. -->
        <Grid Margin="0,0,0,24">

        <!-- Dashboard -->
        <StackPanel x:Name="DashboardSection"
                    Spacing="11"
                    Margin="24,12,24,0"
                    AutomationProperties.AutomationId="BYH.Settings.Dashboard">
          <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
            <Border Grid.Column="0" Classes="DashboardMetricCard">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <Border Classes="DashboardMetricIcon Success">
                  <Path Classes="MiniIcon"
                        Stroke="{DynamicResource ByhPrimaryBrush}"
                        Data="M4,4 L10,4 L10,10 L4,10 Z M14,4 L20,4 L20,10 L14,10 Z M4,14 L10,14 L10,20 L4,20 Z M14,14 L20,14 L20,20 L14,20 Z" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                  <TextBlock Text="{x:Static i18n:Strings.Settings_Dashboard_Modules}" Classes="Muted" FontSize="7" FontWeight="SemiBold" />
                  <TextBlock x:Name="DashboardActiveModulesText" Text="{x:Static i18n:Strings.Settings_Loading}" Classes="DashboardMetricValue" />
                  <TextBlock Text="{x:Static i18n:Strings.Settings_Dashboard_ActiveLocally}" Classes="Secondary" FontSize="7" />
                </StackPanel>
              </Grid>
            </Border>
            <Border Grid.Column="1" Classes="DashboardMetricCard">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <Border Classes="DashboardMetricIcon Warning">
                  <Path Classes="MiniIcon"
                        Stroke="{DynamicResource ByhWarningBrush}"
                        Data="M12,3 A9,9 0 1 0 12,21 A9,9 0 1 0 12,3 M12,7 L12,12 L16,14" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                  <TextBlock Text="{x:Static i18n:Strings.Settings_Dashboard_Events}" Classes="Muted" FontSize="7" FontWeight="SemiBold" />
                  <TextBlock x:Name="DashboardTotalEventsText" Text="{x:Static i18n:Strings.Settings_Loading}" Classes="DashboardMetricValue" />
                  <TextBlock Text="{x:Static i18n:Strings.Settings_Dashboard_PrivacySafe}" Classes="Secondary" FontSize="7" />
                </StackPanel>
              </Grid>
            </Border>
            <Border Grid.Column="2" Classes="DashboardMetricCard">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <Border Classes="DashboardMetricIcon Accent">
                  <Path Classes="MiniIcon"
                        Stroke="{DynamicResource ByhAccentBrush}"
                        Data="M3,7 L21,7 L21,17 L3,17 Z M7,10.5 L9,10.5 M11,10.5 L13,10.5 M15,10.5 L17,10.5 M7,14 L17,14" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                  <TextBlock Text="{x:Static i18n:Strings.Settings_Dashboard_TopFeature}" Classes="Muted" FontSize="7" FontWeight="SemiBold" />
                  <TextBlock x:Name="DashboardTopFeatureText" Text="{x:Static i18n:Strings.Settings_Dashboard_EmptyTitle}" Classes="DashboardMetricName" />
                  <TextBlock x:Name="DashboardTopFeatureCountText" Text="{x:Static i18n:Strings.Settings_Dashboard_NoLocalHistory}" Classes="Secondary" FontSize="7" />
                </StackPanel>
              </Grid>
            </Border>
            <Border Grid.Column="3" Classes="DashboardMetricCard">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <Border Classes="DashboardMetricIcon Success">
                  <Path Classes="MiniIcon"
                        Stroke="{DynamicResource ByhPrimaryBrush}"
                        Data="M2,12 C5.2,6.8 8.5,5 12,5 C15.5,5 18.8,6.8 22,12 C18.8,17.2 15.5,19 12,19 C8.5,19 5.2,17.2 2,12 Z M12,9 A3,3 0 1 0 12,15 A3,3 0 1 0 12,9" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                  <TextBlock Text="{x:Static i18n:Strings.Settings_Dashboard_Models}" Classes="Muted" FontSize="7" FontWeight="SemiBold" />
                  <TextBlock x:Name="DashboardModelRouteCountText" Text="{x:Static i18n:Strings.Settings_Loading}" Classes="DashboardMetricValue" />
                  <TextBlock Text="{x:Static i18n:Strings.Settings_Dashboard_TextAndVision}" Classes="Secondary" FontSize="7" />
                </StackPanel>
              </Grid>
            </Border>
          </Grid>

          <Grid ColumnDefinitions="1.45*,1*" ColumnSpacing="12">
            <Border Grid.Column="0" Classes="DashboardPanel">
              <Grid RowDefinitions="Auto,*,Auto">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{x:Static i18n:Strings.Settings_Dashboard_FeatureFrequency}" Classes="CardTitle" FontSize="13" FontWeight="SemiBold" />
                    <TextBlock Text="{x:Static i18n:Strings.Settings_Dashboard_FeatureFrequencyDesc}" Classes="Secondary" FontSize="8" />
                  </StackPanel>
                  <Border Grid.Column="1" Classes="HeroPill" Padding="8,4">
                    <TextBlock Text="{x:Static i18n:Strings.Settings_Dashboard_LocalOnly}" Classes="Accent" FontSize="7" FontWeight="SemiBold" />
                  </Border>
                </Grid>
                <StackPanel Grid.Row="1" Spacing="9" Margin="0,12,0,8">
                  <Grid ColumnDefinitions="86,*,34" ColumnSpacing="9">
                    <TextBlock Text="{x:Static i18n:Strings.Settings_Dashboard_Module_OceanEyes}" Classes="Secondary" FontSize="9" VerticalAlignment="Center" />
                    <ProgressBar x:Name="DashboardOceanEyesBar" Grid.Column="1" Classes="DashboardUsageBar" Minimum="0" Maximum="1" />
                    <TextBlock x:Name="DashboardOceanEyesCountText" Grid.Column="2" Text="0" Classes="Accent" FontSize="9" HorizontalAlignment="Right" />
                  </Grid>
                  <Grid ColumnDefinitions="86,*,34" ColumnSpacing="9">
                    <TextBlock Text="{x:Static i18n:Strings.Settings_Dashboard_Module_Actions}" Classes="Secondary" FontSize="9" VerticalAlignment="Center" />
                    <ProgressBar x:Name="DashboardActionsBar" Grid.Column="1" Classes="DashboardUsageBar Accent" Minimum="0" Maximum="1" />
                    <TextBlock x:Name="DashboardActionsCountText" Grid.Column="2" Text="0" Classes="Accent" FontSize="9" HorizontalAlignment="Right" />
                  </Grid>
                  <Grid ColumnDefinitions="86,*,34" ColumnSpacing="9">
                    <TextBlock Text="{x:Static i18n:Strings.Settings_Dashboard_Module_Launcher}" Classes="Secondary" FontSize="9" VerticalAlignment="Center" />
                    <ProgressBar x:Name="DashboardLauncherBar" Grid.Column="1" Classes="DashboardUsageBar Gold" Minimum="0" Maximum="1" />
                    <TextBlock x:Name="DashboardLauncherCountText" Grid.Column="2" Text="0" Classes="Accent" FontSize="9" HorizontalAlignment="Right" />
                  </Grid>
                  <Grid ColumnDefinitions="86,*,34" ColumnSpacing="9">
                    <TextBlock Text="{x:Static i18n:Strings.Settings_Dashboard_Module_Clipboard}" Classes="Secondary" FontSize="9" VerticalAlignment="Center" />
                    <ProgressBar x:Name="DashboardClipboardBar" Grid.Column="1" Classes="DashboardUsageBar Soft" Minimum="0" Maximum="1" />
                    <TextBlock x:Name="DashboardClipboardCountText" Grid.Column="2" Text="0" Classes="Accent" FontSize="9" HorizontalAlignment="Right" />
                  </Grid>
                </StackPanel>
                <TextBlock x:Name="DashboardUsageEmptyText"
                           Grid.Row="2"
                           Text="{x:Static i18n:Strings.Settings_Dashboard_EmptyHint}"
                           Classes="Muted"
                           FontSize="8"
                           IsVisible="False" />
              </Grid>
            </Border>

            <Border Grid.Column="1" Classes="DashboardPanel">
              <StackPanel Spacing="12">
                <StackPanel Spacing="2">
                  <TextBlock Text="{x:Static i18n:Strings.Settings_Dashboard_ModelPreference}" Classes="CardTitle" FontSize="13" FontWeight="SemiBold" />
                  <TextBlock Text="{x:Static i18n:Strings.Settings_Dashboard_ModelPreferenceDesc}" Classes="Secondary" FontSize="8" />
                </StackPanel>
                <Border Classes="DashboardModelCard">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Border Classes="DashboardMetricIcon Accent">
                      <Path Classes="MiniIcon" Stroke="{DynamicResource ByhAccentBrush}"
                            Data="M12,3 A9,9 0 1 0 12,21 A9,9 0 1 0 12,3 M3,12 L21,12 M12,3 C15,7 15,17 12,21 C9,17 9,7 12,3" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="2">
                      <TextBlock Text="{x:Static i18n:Strings.Settings_Dashboard_TextActive}" Classes="Muted" FontSize="7" FontWeight="SemiBold" />
                      <TextBlock x:Name="DashboardTextProviderText" Text="{x:Static i18n:Strings.Settings_Dashboard_NotConfigured}" FontSize="11" FontWeight="SemiBold" />
                      <TextBlock x:Name="DashboardTextModelText" Text="{x:Static i18n:Strings.Settings_Dashboard_NoModelSelected}" Classes="Secondary" FontSize="8" TextWrapping="Wrap" />
                    </StackPanel>
                  </Grid>
                </Border>
                <Border Classes="DashboardModelCard">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Border Classes="DashboardMetricIcon Success">
                      <Path Classes="MiniIcon" Stroke="{DynamicResource ByhPrimaryBrush}"
                            Data="M2,12 C5.2,6.8 8.5,5 12,5 C15.5,5 18.8,6.8 22,12 C18.8,17.2 15.5,19 12,19 C8.5,19 5.2,17.2 2,12 Z M12,9 A3,3 0 1 0 12,15 A3,3 0 1 0 12,9" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="2">
                      <TextBlock Text="{x:Static i18n:Strings.Settings_Dashboard_VisionActive}" Classes="Muted" FontSize="7" FontWeight="SemiBold" />
                      <TextBlock x:Name="DashboardVisionProviderText" Text="{x:Static i18n:Strings.Settings_Dashboard_NotConfigured}" FontSize="11" FontWeight="SemiBold" />
                      <TextBlock x:Name="DashboardVisionModelText" Text="{x:Static i18n:Strings.Settings_Dashboard_NoModelSelected}" Classes="Secondary" FontSize="8" TextWrapping="Wrap" />
                    </StackPanel>
                  </Grid>
                </Border>
              </StackPanel>
            </Border>
          </Grid>

          <Border Classes="DashboardPanel" Padding="16,12">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
              <Border Width="9" Height="9" CornerRadius="4.5"
                      Background="{DynamicResource ByhSuccessBrush}"
                      VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Text="{x:Static i18n:Strings.Settings_Dashboard_Ready}" FontSize="10" FontWeight="SemiBold" />
                <TextBlock x:Name="DashboardModuleSummaryText"
                           Text="{x:Static i18n:Strings.Settings_Dashboard_ReadingConfig}"
                           Classes="Secondary"
                           FontSize="8"
                           TextWrapping="Wrap" />
              </StackPanel>
              <Button Grid.Column="2"
                      Content="{x:Static i18n:Strings.Settings_Nav_General}"
                      Classes="Ghost"
                      Click="OnShowGeneralClick" />
            </Grid>
          </Border>
        </StackPanel>

        <!-- General -->
        <StackPanel x:Name="GeneralSection" Spacing="0">
          <!-- Language card. Sits at the top of General so users find it
               immediately. Save persists ui-language.json and triggers a
               restart (Strings' dictionary is snapshotted at process start,
               so a fresh process is what actually swaps the UI text).
               Wrapped in a DashboardPanel shell so the header + InnerCard
               read as one raised ivory tile, matching the Dashboard page. -->
          <Border Classes="DashboardPanel" Margin="24,14,24,0">
            <StackPanel Spacing="12">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Spacing="3">
                  <TextBlock Text="{x:Static i18n:Strings.Settings_LanguageCard_Title}"
                             Classes="CardTitle"
                             FontSize="{DynamicResource ByhFontSizeSubheading}"
                             FontWeight="SemiBold" />
                  <TextBlock Text="{x:Static i18n:Strings.Settings_LanguageCard_Subtitle}"
                             Classes="Muted"
                             FontSize="{DynamicResource ByhFontSizeBodySmall}"
                             TextWrapping="Wrap" />
                </StackPanel>
              </Grid>

              <Border Classes="InnerCard" Padding="12">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                  <ComboBox x:Name="LanguageComboBox"
                            Grid.Column="0"
                            HorizontalAlignment="Stretch"
                            SelectedIndex="0" />
                  <Button Grid.Column="1"
                          x:Name="SaveLanguageButton"
                          Content="{x:Static i18n:Strings.Settings_LanguageCard_SaveButton}"
                          Classes="Primary"
                          Click="OnSaveLanguageClick" />
                  <TextBlock Grid.Column="2"
                             x:Name="LanguageStatusText"
                             Classes="Secondary"
                             FontSize="{DynamicResource ByhFontSizeBody}"
                             VerticalAlignment="Center" />
                </Grid>
              </Border>
            </StackPanel>
          </Border>

          <!-- Launch-at-startup card. Toggles the HKCU\…\Run entry so BYH
               starts on Windows login. Single switch + save button + status
               line; the registry is the source of truth, so the toggle reflects
               whatever App.axaml.cs calibrated on load (user may have disabled
               it in Task Manager / Windows Settings, which we honor). -->
          <Border Classes="DashboardPanel" Margin="24,14,24,0">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                <StackPanel Spacing="3">
                  <TextBlock Text="{x:Static i18n:Strings.Settings_Startup_Title}"
                             Classes="CardTitle"
                             FontSize="{DynamicResource ByhFontSizeSubheading}"
                             FontWeight="SemiBold" />
                  <TextBlock Text="{x:Static i18n:Strings.Settings_Startup_Subtitle}"
                             Classes="Muted"
                             FontSize="{DynamicResource ByhFontSizeBodySmall}"
                             TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch x:Name="LaunchAtStartupToggle"
                              Grid.Column="1"
                              OnContent="{x:Static i18n:Strings.Common_Toggle_On}"
                              OffContent="{x:Static i18n:Strings.Common_Toggle_Off}"
                              IsChecked="False"
                              VerticalAlignment="Center"
                              AutomationProperties.AutomationId="BYH.Settings.Startup.Toggle" />
              </Grid>
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Button Content="{x:Static i18n:Strings.Common_Save}"
                        Classes="Primary"
                        Click="OnSaveStartupClick"
                        AutomationProperties.AutomationId="BYH.Settings.Startup.Save" />
                <TextBlock x:Name="StartupStatusText"
                           Grid.Column="1"
                           Classes="Muted"
                           FontSize="{DynamicResource ByhFontSizeBody}"
                           VerticalAlignment="Center"
                           AutomationProperties.AutomationId="BYH.Settings.Startup.Status" />
              </Grid>
            </StackPanel>
          </Border>

          <!-- Personal Greeting card. REQ-027 — display name used by the
               phone greeting. Wrapped in a DashboardPanel shell. -->
          <Border Classes="DashboardPanel" Margin="24,14,24,0">
            <StackPanel Spacing="10">
              <TextBlock Text="{x:Static i18n:Strings.Settings_Profile_CardTitle}"
                         Classes="CardTitle"
                         FontSize="15"
                         FontWeight="SemiBold" />
              <Border Classes="InnerCard" Padding="12">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <StackPanel Spacing="4">
                    <TextBlock Text="{x:Static i18n:Strings.Settings_Profile_DisplayNameLabel}"
                               Classes="Secondary"
                               FontSize="10"
                               FontWeight="SemiBold" />
                    <TextBox x:Name="ProfileDisplayNameInput"
                             MaxLength="32"
                             FontSize="11"
                             PlaceholderText="{x:Static i18n:Strings.Settings_Profile_DisplayNamePlaceholder}"
                             AutomationProperties.AutomationId="BYH.Settings.Profile.DisplayName" />
                  </StackPanel>
                  <Button Grid.Column="1"
                          Content="{x:Static i18n:Strings.Common_Save}"
                          Classes="Primary"
                          VerticalAlignment="Bottom"
                          Click="OnSaveUserProfileClick"
                          AutomationProperties.AutomationId="BYH.Settings.Profile.Save" />
                </Grid>
              </Border>
              <TextBlock x:Name="ProfileStatusText"
                         Classes="Muted"
                         FontSize="9"
                         Text="{x:Static i18n:Strings.Settings_Profile_Hint}"
                         AutomationProperties.AutomationId="BYH.Settings.Profile.Status" />
            </StackPanel>
          </Border>

          <!-- Section: Ocean Eyes Trigger sits directly on the surface.
               Wrapped in a DashboardPanel shell. -->
          <Border Classes="DashboardPanel" Margin="24,14,24,0">
            <StackPanel Spacing="12">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Spacing="3">
                  <TextBlock Text="{x:Static i18n:Strings.Settings_OceanEyesTrigger_Title}"
                             Classes="CardTitle"
                             FontSize="{DynamicResource ByhFontSizeSubheading}"
                             FontWeight="SemiBold" />
                  <TextBlock Text="{x:Static i18n:Strings.Settings_OceanEyesTrigger_Hint}"
                             Classes="Muted"
                             FontSize="{DynamicResource ByhFontSizeBodySmall}"
                             TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch x:Name="KeyboardShortcutToggle"
                              Grid.Column="1"
                              OnContent="{x:Static i18n:Strings.Common_Toggle_On}"
                              OffContent="{x:Static i18n:Strings.Common_Toggle_Off}"
                              IsChecked="True"
                              VerticalAlignment="Center" />
              </Grid>

              <Border Classes="InnerCard" Padding="12">
                <StackPanel Spacing="8">
                  <TextBlock Text="{x:Static i18n:Strings.Settings_Hotkey}"
                             Classes="Secondary"
                             FontSize="{DynamicResource ByhFontSizeBody}"
                             FontWeight="SemiBold" />
                  <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,120" ColumnSpacing="10">
                    <CheckBox Grid.Column="0" x:Name="CtrlModifierCheckBox" Content="{x:Static i18n:Strings.Settings_Mod_Ctrl}" IsChecked="True" />
                    <CheckBox Grid.Column="1" x:Name="AltModifierCheckBox" Content="{x:Static i18n:Strings.Settings_Mod_Alt}" IsChecked="True" />
                    <CheckBox Grid.Column="2" x:Name="ShiftModifierCheckBox" Content="{x:Static i18n:Strings.Settings_Mod_Shift}" />
                    <CheckBox Grid.Column="3" x:Name="WinModifierCheckBox" Content="{x:Static i18n:Strings.Settings_Mod_Win}" />
                    <ComboBox Grid.Column="5" x:Name="ShortcutKeyComboBox" SelectedIndex="16" />
                  </Grid>
                </StackPanel>
              </Border>

              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Button Content="{x:Static i18n:Strings.Settings_SaveHotkey}"
                        Classes="Primary"
                        Click="OnSaveOceanEyesTriggerClick" />
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                  <TextBlock x:Name="ShortcutStatusText"
                             Text="Current: Ctrl+Alt+Q"
                             FontSize="{DynamicResource ByhFontSizeBody}" />
                </StackPanel>
              </Grid>

              <Border BorderBrush="{DynamicResource ByhBorderSubtleBrush}"
                      BorderThickness="0,1,0,0"
                      Padding="0,12,0,0">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                  <StackPanel Spacing="3">
                    <TextBlock Text="{x:Static i18n:Strings.Settings_MouseChord_Title}"
                               FontSize="{DynamicResource ByhFontSizeBody}"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{x:Static i18n:Strings.Settings_MouseChord_Hint}"
                               Classes="Muted"
                               FontSize="{DynamicResource ByhFontSizeCaption}"
                               TextWrapping="Wrap" />
                  </StackPanel>
                  <ToggleSwitch x:Name="MouseChordToggle"
                                Grid.Column="1"
                                OnContent="{x:Static i18n:Strings.Common_Toggle_On}"
                                OffContent="{x:Static i18n:Strings.Common_Toggle_Off}"
                                IsChecked="False"
                                VerticalAlignment="Center" />
                </Grid>
              </Border>
          </StackPanel>
          </Border>

          <!-- Section: Toolbar Shortcuts sits directly on the surface.
               Wrapped in a DashboardPanel shell. -->
          <Border Classes="DashboardPanel" Margin="24,14,24,0">
            <StackPanel Spacing="12">
              <TextBlock Text="{x:Static i18n:Strings.Settings_ToolbarShortcuts_Title}"
                         Classes="CardTitle"
                         FontSize="{DynamicResource ByhFontSizeSubheading}"
                         FontWeight="SemiBold" />
              <Border Classes="InnerCard" Padding="12">
                <Grid ColumnDefinitions="Auto,60,*" RowDefinitions="Auto,Auto"
                      RowSpacing="8" ColumnSpacing="12">
                  <TextBlock Grid.Row="0" Grid.Column="0"
                             Text="{x:Static i18n:Strings.Settings_ToolbarShortcut_Prompt}"
                             Classes="Secondary"
                             FontSize="{DynamicResource ByhFontSizeBody}"
                             VerticalAlignment="Center" />
                  <TextBox  Grid.Row="0" Grid.Column="1"
                            x:Name="PromptShortcutInput"
                            MaxLength="1"
                            FontSize="{DynamicResource ByhFontSizeBodyLarge}"
                            HorizontalAlignment="Stretch"
                            PlaceholderText="{x:Static i18n:Strings.Common_Placeholder_None}" />
                  <TextBlock Grid.Row="0" Grid.Column="2"
                             Text="{x:Static i18n:Strings.Settings_ToolbarShortcut_Prompt_Hint}"
                             Classes="Muted"
                             FontSize="{DynamicResource ByhFontSizeBodySmall}"
                             VerticalAlignment="Center" />

                  <TextBlock Grid.Row="1" Grid.Column="0"
                             Text="{x:Static i18n:Strings.Settings_ToolbarShortcut_Copy}"
                             Classes="Secondary"
                             FontSize="{DynamicResource ByhFontSizeBody}"
                             VerticalAlignment="Center" />
                  <TextBox  Grid.Row="1" Grid.Column="1"
                            x:Name="CopyShortcutInput"
                            MaxLength="1"
                            FontSize="{DynamicResource ByhFontSizeBodyLarge}"
                            HorizontalAlignment="Stretch"
                            PlaceholderText="{x:Static i18n:Strings.Common_Placeholder_None}" />
                  <TextBlock Grid.Row="1" Grid.Column="2"
                             Text="{x:Static i18n:Strings.Settings_ToolbarShortcut_Copy_Hint}"
                             Classes="Muted"
                             FontSize="{DynamicResource ByhFontSizeBodySmall}"
                             VerticalAlignment="Center" />
                </Grid>
              </Border>

              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Button Content="{x:Static i18n:Strings.Settings_SaveShortcuts}"
                        Classes="Primary"
                        Click="OnSaveToolbarShortcutsClick" />
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                  <TextBlock x:Name="ToolbarShortcutsStatusText"
                             Text="Current: Prompt R · Copy C"
                             FontSize="{DynamicResource ByhFontSizeBody}" />
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>

          <!-- Section: Ocean Eyes Capture sits directly on the surface.
               Wrapped in a DashboardPanel shell. -->
          <Border Classes="DashboardPanel" Margin="24,14,24,0">
            <StackPanel Spacing="12">
                <TextBlock Text="{x:Static i18n:Strings.Settings_OceanEyesCapture_Title}"
                           Classes="CardTitle"
                           FontSize="{DynamicResource ByhFontSizeSubheading}"
                           FontWeight="SemiBold" />
                <Border Classes="InnerCard" Padding="12">
                  <StackPanel Spacing="6">
                    <TextBlock Text="{x:Static i18n:Strings.Settings_SaveLocation}"
                               Classes="Secondary"
                               FontSize="{DynamicResource ByhFontSizeBody}"
                               FontWeight="SemiBold" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                      <TextBox x:Name="OceanEyesSavePathTextBox"
                               Grid.Column="0"
                               PlaceholderText="{x:Static i18n:Strings.Settings_OceanEyesSavePath_Placeholder}"
                               FontSize="{DynamicResource ByhFontSizeBody}" />
                      <Button Grid.Column="1"
                              Content="{x:Static i18n:Strings.Common_Browse}"
                              Classes="Ghost"
                              Click="OnBrowseOceanEyesSavePathClick" />
                    </Grid>
                  </StackPanel>
                </Border>

                <!-- Phone-reference summary row: three compact toggle cards in
                     one row, like the "Projects / Tasks / Completed" blocks. -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                  <Border Classes="InnerCard" Padding="10">
                    <StackPanel Spacing="2">
                      <TextBlock Text="{x:Static i18n:Strings.Settings_AutoSave}" Classes="Muted" FontSize="{DynamicResource ByhFontSizeCaption}" FontWeight="SemiBold" />
                      <ToggleSwitch x:Name="OceanEyesAutoSaveToggle"
                                    OnContent="{x:Static i18n:Strings.Common_Toggle_On}"
                                    OffContent="{x:Static i18n:Strings.Common_Toggle_Off}"
                                    IsChecked="True"
                                    FontSize="{DynamicResource ByhFontSizeBodySmall}" />
                    </StackPanel>
                  </Border>
                  <Border Classes="InnerCard" Padding="10">
                    <StackPanel Spacing="2">
                      <TextBlock Text="{x:Static i18n:Strings.Settings_ClipboardToggle}" Classes="Muted" FontSize="{DynamicResource ByhFontSizeCaption}" FontWeight="SemiBold" />
                      <ToggleSwitch x:Name="OceanEyesClipboardToggle"
                                    OnContent="{x:Static i18n:Strings.Common_Toggle_On}"
                                    OffContent="{x:Static i18n:Strings.Common_Toggle_Off}"
                                    IsChecked="True"
                                    FontSize="{DynamicResource ByhFontSizeBodySmall}" />
                    </StackPanel>
                  </Border>
                  <Border Classes="InnerCard" Padding="10">
                    <StackPanel Spacing="2">
                      <TextBlock Text="{x:Static i18n:Strings.Settings_UiaSnap}" Classes="Muted" FontSize="{DynamicResource ByhFontSizeCaption}" FontWeight="SemiBold" />
                      <ToggleSwitch x:Name="OceanEyesUiaAssistToggle"
                                    OnContent="{x:Static i18n:Strings.Common_Toggle_On}"
                                    OffContent="{x:Static i18n:Strings.Common_Toggle_Off}"
                                    IsChecked="True"
                                    FontSize="{DynamicResource ByhFontSizeBodySmall}" />
                    </StackPanel>
                  </Border>
                </Grid>

                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                  <Button Content="{x:Static i18n:Strings.Settings_SaveCapture}"
                          Classes="Primary"
                          Click="OnSaveOceanEyesCaptureClick" />
                  <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock x:Name="OceanEyesCaptureStatusText"
                               Text="Current: Default location"
                               FontSize="{DynamicResource ByhFontSizeBody}" />
                  </StackPanel>
                </Grid>
              </StackPanel>
          </Border>

        </StackPanel>

        <!-- Translation providers. The whole edit form sits inside one
             DashboardPanel shell; x:Name="EditFormBorder" stays on the
             Border (BringIntoView works on Control) so code-behind is
             unaffected by the StackPanel→Border type change. -->
        <StackPanel x:Name="ProviderSection" IsVisible="False" Spacing="0">
          <Border x:Name="EditFormBorder" Classes="DashboardPanel" Margin="24,14,24,0">
            <StackPanel Spacing="16">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Spacing="4">
                  <TextBlock Text="{x:Static i18n:Strings.Settings_ProviderProfiles_Title}"
                             Classes="CardTitle"
                             FontSize="{DynamicResource ByhFontSizeSubheading}"
                             FontWeight="SemiBold" />
                </StackPanel>
                <Button Grid.Column="1"
                        Content="{x:Static i18n:Strings.Settings_AddProvider}"
                        Click="OnAddProviderClick" />
              </Grid>

              <StackPanel Spacing="6">
                <TextBlock Text="{x:Static i18n:Strings.Settings_Editing}"
                           Classes="Secondary"
                           FontSize="{DynamicResource ByhFontSizeBodySmall}"
                           FontWeight="SemiBold" />
                <Border Classes="InnerCard" Padding="12">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <ComboBox x:Name="ProviderComboBox"
                              HorizontalAlignment="Stretch"
                              SelectionChanged="OnProviderSelectionChanged">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="views:ProviderOption">
                          <TextBlock Text="{Binding DisplayLabel}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock x:Name="EditingProviderNameHint"
                               Grid.Column="1"
                               Classes="Muted"
                               FontSize="{DynamicResource ByhFontSizeBodySmall}"
                               VerticalAlignment="Center" />
                  </Grid>
                </Border>
              </StackPanel>

              <Border Classes="InnerCard" Padding="14">
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="14" RowSpacing="12">
                  <StackPanel Grid.Row="0" Grid.Column="0" Spacing="6">
                    <TextBlock Text="{x:Static i18n:Strings.Settings_Provider_Name}" Classes="Muted" FontSize="{DynamicResource ByhFontSizeBodySmall}" />
                    <TextBox x:Name="NameInput" />
                  </StackPanel>
                  <StackPanel Grid.Row="0" Grid.Column="1" Spacing="6">
                    <TextBlock Text="{x:Static i18n:Strings.Settings_Provider_Model}" Classes="Muted" FontSize="{DynamicResource ByhFontSizeBodySmall}" />
                    <ComboBox x:Name="ModelInput"
                              HorizontalAlignment="Stretch"
                              IsEditable="True" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <TextBlock x:Name="ModelFetchStatus"
                                 Grid.Column="0"
                                 VerticalAlignment="Center"
                                 Classes="Muted"
                                 Text="{x:Static i18n:Strings.Settings_Provider_LastFetched_Never}"
                                 FontSize="{DynamicResource ByhFontSizeCaption}"
                                 TextTrimming="CharacterEllipsis" />
                      <Button x:Name="FetchModelsButton"
                              Grid.Column="1"
                              Content="{x:Static i18n:Strings.Settings_Provider_FetchModels}"
                              Click="OnFetchModelsClick" />
                    </Grid>
                  </StackPanel>
                  <StackPanel Grid.Row="1" Grid.Column="0" Spacing="6">
                    <TextBlock Text="{x:Static i18n:Strings.Settings_Provider_BaseUrl}" Classes="Muted" FontSize="{DynamicResource ByhFontSizeBodySmall}" />
                    <TextBox x:Name="BaseUrlInput" />
                  </StackPanel>
                  <StackPanel Grid.Row="1" Grid.Column="1" Spacing="6">
                    <TextBlock Text="{x:Static i18n:Strings.Settings_Provider_ChatPath}" Classes="Muted" FontSize="{DynamicResource ByhFontSizeBodySmall}" />
                    <TextBox x:Name="ChatPathInput" PlaceholderText="chat/completions" />
                  </StackPanel>
                </Grid>
              </Border>

              <StackPanel Spacing="6">
                <TextBlock Text="{x:Static i18n:Strings.Settings_Provider_SystemPrompt}"
                           Classes="Muted"
                           FontSize="{DynamicResource ByhFontSizeBodySmall}" />
                <Border Classes="InnerCard" Padding="12">
                  <TextBox x:Name="SystemPromptInput"
                           AcceptsReturn="True"
                           TextWrapping="Wrap"
                           Height="78" />
                </Border>
              </StackPanel>

              <Border Classes="InnerCard" Padding="14">
                <StackPanel Spacing="7">
                  <TextBlock Text="{x:Static i18n:Strings.Settings_Provider_ApiKey}"
                             FontSize="{DynamicResource ByhFontSizeBody}"
                             FontWeight="SemiBold" />
                  <TextBlock Text="{x:Static i18n:Strings.Settings_Provider_ApiKey_Hint}"
                             Classes="Muted"
                             FontSize="{DynamicResource ByhFontSizeCaption}" />
                  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <TextBox x:Name="ApiKeyInput"
                             PlaceholderText="sk-..."
                             PasswordChar="•" />
                    <Button Grid.Column="1" Content="{x:Static i18n:Strings.Settings_Show}" Click="OnToggleVisibilityClick" />
                    <Button Grid.Column="2" Content="{x:Static i18n:Strings.Settings_SaveKey}" Classes="Primary" Click="OnSaveKeyClick" />
                  </Grid>
                  <TextBlock x:Name="ApiKeyStatusText"
                             Classes="Muted"
                             Text="{x:Static i18n:Strings.Settings_Key_NotSet}"
                             FontSize="{DynamicResource ByhFontSizeBodySmall}" />
                </StackPanel>
              </Border>

              <Grid ColumnDefinitions="150,*" ColumnSpacing="16">
                <StackPanel Spacing="6">
                  <TextBlock Text="{x:Static i18n:Strings.Settings_Provider_Timeout}" Classes="Muted" FontSize="{DynamicResource ByhFontSizeBodySmall}" />
                  <Border Classes="InnerCard" Padding="6,4">
                    <NumericUpDown x:Name="TimeoutInput"
                                   Minimum="10"
                                   Maximum="300"
                                   Value="60" />
                  </Border>
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Spacing="8">
                  <Button Content="{x:Static i18n:Strings.Common_Delete}"
                          Classes="DangerQuiet"
                          Click="OnDeleteProviderClick" />
                  <Button Content="{x:Static i18n:Strings.Settings_SetActive}" Click="OnSetActiveClick" />
                  <Button Content="{x:Static i18n:Strings.Settings_SaveProfile}"
                          Classes="Primary"
                          Click="OnSaveProviderClick" />
                </StackPanel>
              </Grid>

            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Prompt functions -->
        <StackPanel x:Name="FunctionsSection" IsVisible="False" Spacing="0">
          <Border x:Name="PromptTemplatesCard" Classes="DashboardPanel" Margin="24,14,24,0">
            <StackPanel Spacing="16">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Spacing="3">
                  <TextBlock Text="{x:Static i18n:Strings.Settings_Actions_Title}"
                             Classes="CardTitle"
                             FontSize="{DynamicResource ByhFontSizeSubheading}"
                             FontWeight="SemiBold" />
                </StackPanel>
                <Button x:Name="AddFunctionButton"
                        Grid.Column="1"
                        Content="{x:Static i18n:Strings.Settings_AddAction}"
                        Classes="Primary"
                        Click="OnAddFunctionClick" />
              </Grid>

              <Border Classes="InnerCard" Padding="12">
                <ItemsControl x:Name="FunctionsList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="views:PromptFunctionRow">
                      <Grid ColumnDefinitions="*,Auto,Auto"
                            ColumnSpacing="10"
                            Margin="0,5">
                        <TextBlock Grid.Column="0"
                                   Text="{Binding Name}"
                                   FontSize="{DynamicResource ByhFontSizeBodyLarge}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="1"
                                Content="{x:Static i18n:Strings.Common_Edit}"
                                Classes="Ghost"
                                Padding="10,4"
                                FontSize="{DynamicResource ByhFontSizeBodySmall}"
                                Command="{Binding EditCommand}" />
                        <Button Grid.Column="2"
                                Content="{x:Static i18n:Strings.Common_Delete}"
                                Classes="DangerQuiet"
                                Padding="10,4"
                                FontSize="{DynamicResource ByhFontSizeBodySmall}"
                                Command="{Binding DeleteCommand}"
                                IsVisible="{Binding !IsBuiltIn}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Vision OCR. Whole page (title + OCR + strategy) in one
             DashboardPanel shell; the two inter-block hairlines collapse
             into the panel's Spacing. -->
        <StackPanel x:Name="VisionSection" IsVisible="False" Spacing="0">
          <Border Classes="DashboardPanel" Margin="24,14,24,0">
            <StackPanel Spacing="16">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
              <StackPanel Spacing="4">
                <TextBlock Text="{x:Static i18n:Strings.Settings_Vision_Title}"
                           Classes="CardTitle"
                           FontSize="{DynamicResource ByhFontSizeSubheading}"
                           FontWeight="SemiBold" />
              </StackPanel>
              <ToggleSwitch x:Name="VisionEnabledToggle"
                            Grid.Column="1"
                            OnContent="{x:Static i18n:Strings.Common_Toggle_On}"
                            OffContent="{x:Static i18n:Strings.Common_Toggle_Off}"
                            IsChecked="True"
                            VerticalAlignment="Center" />
            </Grid>

            <StackPanel Spacing="14">
              <StackPanel Spacing="6">
                <TextBlock Text="{x:Static i18n:Strings.Settings_Vision_OcrModel}"
                           Classes="CardTitle"
                           FontSize="{DynamicResource ByhFontSizeBodyLarge}"
                           FontWeight="SemiBold" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                  <StackPanel Grid.Column="0" Spacing="6">
                    <TextBlock Text="{x:Static i18n:Strings.Settings_Vision_Provider}" Classes="Muted" FontSize="{DynamicResource ByhFontSizeBodySmall}" />
                    <Border Classes="InnerCard" Padding="6,4">
                      <ComboBox x:Name="VisionProviderComboBox"
                                HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                          <DataTemplate x:DataType="views:ProviderOption">
                            <TextBlock Text="{Binding DisplayLabel}" />
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                    </Border>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="6">
                    <TextBlock Text="{x:Static i18n:Strings.Settings_Vision_Model}" Classes="Muted" FontSize="{DynamicResource ByhFontSizeBodySmall}" />
                    <Border Classes="InnerCard" Padding="6,4">
                      <ComboBox x:Name="VisionModelComboBox"
                                HorizontalAlignment="Stretch"
                                IsEditable="True" />
                    </Border>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <TextBlock x:Name="VisionModelFetchStatus"
                                 Grid.Column="0"
                                 VerticalAlignment="Center"
                                 Classes="Muted"
                                 Text="{x:Static i18n:Strings.Settings_Provider_LastFetched_Never}"
                                 FontSize="{DynamicResource ByhFontSizeCaption}"
                                 TextTrimming="CharacterEllipsis" />
                      <Button x:Name="VisionFetchModelsButton"
                              Grid.Column="1"
                              Content="{x:Static i18n:Strings.Settings_Provider_FetchModels}"
                              Click="OnVisionFetchModelsClick" />
                    </Grid>
                  </StackPanel>
                </Grid>
                <StackPanel Spacing="6">
                  <TextBlock Text="{x:Static i18n:Strings.Settings_Vision_Prompt}" Classes="Muted" FontSize="{DynamicResource ByhFontSizeBodySmall}" />
                  <Border Classes="InnerCard" Padding="12">
                    <TextBox x:Name="VisionPromptInput"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Height="68"
                             PlaceholderText="{x:Static i18n:Strings.Settings_Vision_Prompt_Placeholder}" />
                  </Border>
                </StackPanel>
              </StackPanel>

              <StackPanel Spacing="16">
                <TextBlock Text="{x:Static i18n:Strings.Settings_Vision_Strategy}"
                           Classes="CardTitle"
                           FontSize="{DynamicResource ByhFontSizeBodyLarge}"
                           FontWeight="SemiBold" />

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                  <StackPanel Spacing="3">
                    <TextBlock Text="{x:Static i18n:Strings.Settings_Vision_UiaPrefill}"
                               FontSize="{DynamicResource ByhFontSizeBody}"
                               FontWeight="SemiBold" />
                  </StackPanel>
                  <ToggleSwitch x:Name="VisionUiaPrefillToggle"
                                Grid.Column="1"
                                OnContent="{x:Static i18n:Strings.Common_Toggle_On}"
                                OffContent="{x:Static i18n:Strings.Common_Toggle_Off}"
                                IsChecked="False"
                                VerticalAlignment="Center" />
                </Grid>

                <Border BorderBrush="{DynamicResource ByhBorderSubtleBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="0,14,0,0">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                    <StackPanel Spacing="3">
                      <TextBlock Text="{x:Static i18n:Strings.Settings_Vision_DisableThinking}"
                                 FontSize="{DynamicResource ByhFontSizeBody}"
                                 FontWeight="SemiBold" />
                      <TextBlock Text="{x:Static i18n:Strings.Settings_Vision_DisableThinking_Hint}"
                                 Classes="Muted"
                                 FontSize="{DynamicResource ByhFontSizeCaption}"
                                 TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch x:Name="VisionDisableThinkingToggle"
                                  Grid.Column="1"
                                  OnContent="{x:Static i18n:Strings.Settings_Vision_Thinking_Disabled}"
                                  OffContent="{x:Static i18n:Strings.Settings_Vision_Thinking_Allowed}"
                                  IsChecked="False"
                                  VerticalAlignment="Center" />
                  </Grid>
                </Border>
              </StackPanel>
            </StackPanel>

          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="{x:Static i18n:Strings.Settings_SaveVision}"
                    Classes="Primary"
                    Click="OnSaveVisionClick" />
          </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Launcher. List subsection wrapped in a DashboardPanel shell. -->
        <StackPanel x:Name="LauncherSection" IsVisible="False" Spacing="0">
          <Border Classes="DashboardPanel" Margin="24,14,24,0">
            <StackPanel Spacing="16">
              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                <StackPanel Spacing="3">
                  <TextBlock Text="{x:Static i18n:Strings.Settings_Launcher_Title}"
                             Classes="CardTitle"
                             FontSize="{DynamicResource ByhFontSizeSubheading}"
                             FontWeight="SemiBold" />
                  <TextBlock x:Name="LauncherScanStatusText"
                             Text=""
                             Classes="Secondary"
                             FontSize="{DynamicResource ByhFontSizeCaption}" />
                </StackPanel>
                <Button Grid.Column="1"
                        Content="{x:Static i18n:Strings.Settings_ScanInstalledApps}"
                        Classes="Ghost"
                        Click="OnScanInstalledAppsClick" />
                <Button x:Name="AddLauncherButton"
                        Grid.Column="2"
                        Content="{x:Static i18n:Strings.Settings_AddLauncher}"
                        Classes="Primary"
                        Click="OnAddLauncherClick" />
              </Grid>

              <Border Classes="InnerCard" Padding="12">
                <ItemsControl x:Name="LauncherList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="views:LauncherEntryRow">
                      <Grid ColumnDefinitions="32,*,Auto,Auto,Auto,Auto"
                            ColumnSpacing="10"
                            Margin="0,5">
                        <Border Grid.Column="0"
                                Width="24" Height="24"
                                CornerRadius="4"
                                ClipToBounds="True">
                          <Image Source="{Binding Icon}"
                                 Width="24" Height="24" />
                        </Border>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Name}"
                                   FontSize="{DynamicResource ByhFontSizeBodyLarge}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="2"
                                Content="↑"
                                Classes="Ghost"
                                Padding="8,4"
                                FontSize="{DynamicResource ByhFontSizeBodySmall}"
                                Command="{Binding MoveUpCommand}" />
                        <Button Grid.Column="3"
                                Content="↓"
                                Classes="Ghost"
                                Padding="8,4"
                                FontSize="{DynamicResource ByhFontSizeBodySmall}"
                                Command="{Binding MoveDownCommand}" />
                        <Button Grid.Column="4"
                                Content="{x:Static i18n:Strings.Common_Edit}"
                                Classes="Ghost"
                                Padding="10,4"
                                FontSize="{DynamicResource ByhFontSizeBodySmall}"
                                Command="{Binding EditCommand}" />
                        <Button Grid.Column="5"
                                Content="{x:Static i18n:Strings.Common_Delete}"
                                Classes="DangerQuiet"
                                Padding="10,4"
                                FontSize="{DynamicResource ByhFontSizeBodySmall}"
                                Command="{Binding DeleteCommand}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>
            </StackPanel>
          </Border>

            <!-- R32 Spotlight launcher-search shortcut card. Wrapped in its
                 own DashboardPanel shell; the inter-block hairline collapses
                 into the section's Spacing. -->
            <Border Classes="DashboardPanel" Margin="24,14,24,0">
            <StackPanel Spacing="14">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Spacing="3">
                  <TextBlock Text="{x:Static i18n:Strings.Settings_Spotlight_Title}"
                             Classes="CardTitle"
                             FontSize="{DynamicResource ByhFontSizeSubheading}"
                             FontWeight="SemiBold" />
                </StackPanel>
                <ToggleSwitch x:Name="SpotlightKeyboardShortcutToggle"
                              Grid.Column="1"
                              OnContent="{x:Static i18n:Strings.Common_Toggle_On}"
                              OffContent="{x:Static i18n:Strings.Common_Toggle_Off}"
                              IsChecked="True"
                              VerticalAlignment="Center" />
              </Grid>

              <Border Classes="InnerCard" Padding="14">
                <StackPanel Spacing="10">
                  <TextBlock Text="{x:Static i18n:Strings.Settings_Hotkey}"
                             Classes="Secondary"
                             FontSize="{DynamicResource ByhFontSizeBody}"
                             FontWeight="SemiBold" />
                  <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,120" ColumnSpacing="10">
                    <CheckBox Grid.Column="0" x:Name="SpotlightCtrlModifierCheckBox" Content="{x:Static i18n:Strings.Settings_Mod_Ctrl}" IsChecked="True" />
                    <CheckBox Grid.Column="1" x:Name="SpotlightAltModifierCheckBox" Content="{x:Static i18n:Strings.Settings_Mod_Alt}" IsChecked="True" />
                    <CheckBox Grid.Column="2" x:Name="SpotlightShiftModifierCheckBox" Content="{x:Static i18n:Strings.Settings_Mod_Shift}" />
                    <CheckBox Grid.Column="3" x:Name="SpotlightWinModifierCheckBox" Content="{x:Static i18n:Strings.Settings_Mod_Win}" />
                    <ComboBox Grid.Column="5" x:Name="SpotlightShortcutKeyComboBox" />
                  </Grid>
                </StackPanel>
              </Border>

              <!-- R54 window-size card: Spotlight is CanResize=False, so this is
                   the only way the user controls its size. Saved by the same
                   OnSaveSpotlightTriggerClick button below. Two stacked rows
                   (Width / Height) mirror the MaxEntries/MaxImages pattern in
                   the Clipboard card — side-by-side labels collided in this
                   narrow card and were unreadable. -->
              <Border Classes="InnerCard" Padding="14">
                <StackPanel Spacing="10">
                  <TextBlock Text="{x:Static i18n:Strings.Settings_Spotlight_WindowSize_Title}"
                             Classes="Secondary"
                             FontSize="{DynamicResource ByhFontSizeBody}"
                             FontWeight="SemiBold" />
                  <Grid ColumnDefinitions="*,82" ColumnSpacing="10">
                    <TextBlock Text="{x:Static i18n:Strings.Common_Width}"
                               Classes="Secondary"
                               FontSize="{DynamicResource ByhFontSizeBody}"
                               VerticalAlignment="Center" />
                    <TextBox Grid.Column="1"
                             x:Name="SpotlightWindowWidthInput"
                             Text="560"
                             FontSize="{DynamicResource ByhFontSizeBodyLarge}" />
                  </Grid>
                  <Grid ColumnDefinitions="*,82" ColumnSpacing="10">
                    <TextBlock Text="{x:Static i18n:Strings.Common_Height}"
                               Classes="Secondary"
                               FontSize="{DynamicResource ByhFontSizeBody}"
                               VerticalAlignment="Center" />
                    <TextBox Grid.Column="1"
                             x:Name="SpotlightWindowHeightInput"
                             Text="480"
                             FontSize="{DynamicResource ByhFontSizeBodyLarge}" />
                  </Grid>
                </StackPanel>
              </Border>

              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Button Content="{x:Static i18n:Strings.Settings_SaveHotkey}"
                        Classes="Primary"
                        Click="OnSaveSpotlightTriggerClick" />
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                  <TextBlock x:Name="SpotlightShortcutStatusText"
                             Text="Current: Ctrl+Alt+Space"
                             FontSize="{DynamicResource ByhFontSizeBody}" />
                </StackPanel>
              </Grid>
            </StackPanel>
            </Border>
        </StackPanel>


        <!-- Clipboard history follows the same continuous-surface rhythm as
             the five existing pages: one editorial header, then quiet inset
             groups instead of stacked standalone cards. Whole page (header +
             Global Hotkey + Behavior) wrapped in one DashboardPanel shell;
             the inter-block hairline collapses into the panel's Spacing. -->
        <StackPanel x:Name="ClipboardHistorySection" IsVisible="False" Spacing="0">
          <Border Classes="DashboardPanel" Margin="24,14,24,0">
            <StackPanel Spacing="16">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
              <StackPanel Spacing="3">
                <TextBlock Text="{x:Static i18n:Strings.Settings_Clipboard_Title}"
                           Classes="CardTitle"
                           FontSize="{DynamicResource ByhFontSizeSubheading}"
                           FontWeight="SemiBold" />
                <TextBlock Text="{x:Static i18n:Strings.Settings_Clipboard_Subtitle}"
                           Classes="Muted"
                           FontSize="{DynamicResource ByhFontSizeCaption}" />
              </StackPanel>
              <ToggleSwitch x:Name="ClipboardHistoryEnabledToggle"
                            Grid.Column="1"
                            OnContent="{x:Static i18n:Strings.Settings_Clipboard_On}"
                            OffContent="{x:Static i18n:Strings.Settings_Clipboard_Off}"
                            IsChecked="True"
                            VerticalAlignment="Center" />
            </Grid>

            <Border Classes="InnerCard" Padding="14">
              <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                  <TextBlock Text="{x:Static i18n:Strings.Settings_Clipboard_GlobalHotkey}"
                             Classes="CardTitle"
                             FontSize="{DynamicResource ByhFontSizeBodyLarge}"
                             FontWeight="SemiBold"
                             VerticalAlignment="Center" />
                  <ToggleSwitch x:Name="ClipboardHistoryKeyboardShortcutToggle"
                                Grid.Column="1"
                                OnContent="{x:Static i18n:Strings.Common_Toggle_On}"
                                OffContent="{x:Static i18n:Strings.Common_Toggle_Off}"
                                IsChecked="True"
                                VerticalAlignment="Center" />
                </Grid>

                <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,112" ColumnSpacing="10">
                  <CheckBox Grid.Column="0" x:Name="ClipboardHistoryCtrlModifierCheckBox" Content="{x:Static i18n:Strings.Settings_Mod_Ctrl}" IsChecked="True" />
                  <CheckBox Grid.Column="1" x:Name="ClipboardHistoryAltModifierCheckBox" Content="{x:Static i18n:Strings.Settings_Mod_Alt}" IsChecked="True" />
                  <CheckBox Grid.Column="2" x:Name="ClipboardHistoryShiftModifierCheckBox" Content="{x:Static i18n:Strings.Settings_Mod_Shift}" />
                  <CheckBox Grid.Column="3" x:Name="ClipboardHistoryWinModifierCheckBox" Content="{x:Static i18n:Strings.Settings_Mod_Win}" />
                  <ComboBox Grid.Column="5" x:Name="ClipboardHistoryShortcutKeyComboBox" />
                </Grid>

                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                  <Button Content="{x:Static i18n:Strings.Settings_SaveHotkey}"
                          Classes="Primary"
                          Click="OnSaveClipboardHistoryTriggerClick" />
                  <TextBlock x:Name="ClipboardHistoryShortcutStatusText"
                             Grid.Column="1"
                             Text="Current: Ctrl+Alt+V"
                             FontSize="{DynamicResource ByhFontSizeBody}"
                             VerticalAlignment="Center" />
                </Grid>
              </StackPanel>
            </Border>

            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
              <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="{x:Static i18n:Strings.Settings_Clipboard_BehaviorTitle}"
                           Classes="CardTitle"
                           FontSize="{DynamicResource ByhFontSizeBodyLarge}"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="ClipboardHistorySettingsStatusText"
                           Text=""
                           FontSize="{DynamicResource ByhFontSizeCaption}" />
              </StackPanel>
              <Button Grid.Column="1"
                      Content="{x:Static i18n:Strings.Settings_SaveSettings}"
                      Classes="Primary"
                      Click="OnSaveClipboardHistorySettingsClick" />
              <Button Grid.Column="2"
                      Content="{x:Static i18n:Strings.Settings_ClearHistory}"
                      Classes="Ghost"
                      Click="OnClearClipboardHistoryClick" />
            </Grid>

            <Grid ColumnDefinitions="0.9*,1.1*" ColumnSpacing="14">
              <Border Grid.Column="0" Classes="InnerCard" Padding="12">
                  <StackPanel Spacing="8">
                    <ToggleSwitch x:Name="ClipboardHistoryAutoPasteToggle"
                                  OnContent="{x:Static i18n:Strings.Settings_Clipboard_AutoPasteOn}"
                                  OffContent="{x:Static i18n:Strings.Settings_Clipboard_AutoPasteOff}"
                                  IsChecked="False" />
                    <ToggleSwitch x:Name="ClipboardHistoryMaskSensitiveToggle"
                                  OnContent="{x:Static i18n:Strings.Settings_Clipboard_MaskOn}"
                                  OffContent="{x:Static i18n:Strings.Settings_Clipboard_MaskOff}"
                                  IsChecked="True" />
                    <Grid ColumnDefinitions="*,82" ColumnSpacing="10">
                      <TextBlock Text="{x:Static i18n:Strings.Settings_Clipboard_MaxEntries}"
                                 Classes="Secondary"
                                 FontSize="{DynamicResource ByhFontSizeBody}"
                                 VerticalAlignment="Center" />
                      <TextBox Grid.Column="1"
                               x:Name="ClipboardHistoryMaxEntriesInput"
                               Text="1000"
                               FontSize="{DynamicResource ByhFontSizeBodyLarge}" />
                    </Grid>
                    <ToggleSwitch x:Name="ClipboardHistoryCaptureImagesToggle"
                                  OnContent="{x:Static i18n:Strings.Settings_Clipboard_ImagesOn}"
                                  OffContent="{x:Static i18n:Strings.Settings_Clipboard_ImagesOff}"
                                  IsChecked="True" />
                    <Grid ColumnDefinitions="*,82" ColumnSpacing="10">
                      <TextBlock Text="{x:Static i18n:Strings.Settings_Clipboard_MaxImages}"
                                 Classes="Secondary"
                                 FontSize="{DynamicResource ByhFontSizeBody}"
                                 VerticalAlignment="Center" />
                      <TextBox Grid.Column="1"
                               x:Name="ClipboardHistoryMaxImageEntriesInput"
                               Text="50"
                               FontSize="{DynamicResource ByhFontSizeBodyLarge}" />
                    </Grid>
                    <!-- R54 window-size: default open size of the
                         ClipboardHistoryWindow. The window is CanResize=True,
                         so this is the launch default; in-session manual
                         resizes persist across Show/Hide only. Saved by the
                         same OnSaveClipboardHistorySettingsClick button.
                         Two stacked rows (Width / Height) mirror MaxEntries /
                         MaxImages above — side-by-side labels collided in
                         this narrow card and were unreadable. -->
                    <TextBlock Text="{x:Static i18n:Strings.Settings_Clipboard_WindowSize_Title}"
                               Classes="Secondary"
                               FontSize="{DynamicResource ByhFontSizeBody}"
                               FontWeight="SemiBold" />
                    <Grid ColumnDefinitions="*,82" ColumnSpacing="10">
                      <TextBlock Text="{x:Static i18n:Strings.Common_Width}"
                                 Classes="Secondary"
                                 FontSize="{DynamicResource ByhFontSizeBody}"
                                 VerticalAlignment="Center" />
                      <TextBox Grid.Column="1"
                               x:Name="ClipboardHistoryWindowWidthInput"
                               Text="800"
                               FontSize="{DynamicResource ByhFontSizeBodyLarge}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,82" ColumnSpacing="10">
                      <TextBlock Text="{x:Static i18n:Strings.Common_Height}"
                                 Classes="Secondary"
                                 FontSize="{DynamicResource ByhFontSizeBody}"
                                 VerticalAlignment="Center" />
                      <TextBox Grid.Column="1"
                               x:Name="ClipboardHistoryWindowHeightInput"
                               Text="620"
                               FontSize="{DynamicResource ByhFontSizeBodyLarge}" />
                    </Grid>
                  </StackPanel>
              </Border>

              <Border Grid.Column="1" Classes="InnerCard" Padding="12">
                  <StackPanel Spacing="9">
                    <TextBlock Text="{x:Static i18n:Strings.Settings_Clipboard_Excluded}"
                               Classes="Secondary"
                               FontSize="{DynamicResource ByhFontSizeBody}" />
                    <TextBox x:Name="ClipboardHistoryExcludeAppsInput"
                             Text="1password, keepass, authy, bitwarden"
                             FontSize="{DynamicResource ByhFontSizeBodyLarge}"
                             MinHeight="54"
                             AcceptsReturn="True"
                             TextWrapping="Wrap" />
                  </StackPanel>
              </Border>
            </Grid>
            </StackPanel>
          </Border>
        </StackPanel>
        </Grid>
      </ScrollViewer>

        </Grid>
        </Border>
      </Border>

    <!-- Reference-style theme specimen: four calm editorial sections on one
         continuous square sheet. The rail remains decorative and read-only. -->
    <Border Grid.Column="0"
            Grid.RowSpan="2"
            Classes="FlatRail"
            CornerRadius="0">
      <Grid RowDefinitions="0.95*,1.55*,0.9*,1.0*">
        <Border Grid.Row="0"
                ClipToBounds="True"
                IsHitTestVisible="False">
          <!-- Reuse the ornament's lower gemstone as the concept focal point.
               The tall image is bottom-aligned inside this clipped first row,
               so the former lower-rail gem moves here without a new asset. -->
          <Image Source="avares://SelectionAssistant.UI/Assets/Theme/ivory-jade-ornament.jpg"
                 Width="170"
                 Height="340"
                 Margin="0,0,-32,-8"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Bottom"
                 Stretch="Fill"
                 Opacity="0.26" />
        </Border>
        <Border BorderBrush="{DynamicResource ByhRailRuleBrush}"
                BorderThickness="0,0,0,1"
                Padding="22,14,18,12">
          <StackPanel Spacing="7" VerticalAlignment="Center">
            <TextBlock Text="{x:Static i18n:Strings.Settings_Theme_Concept}" Classes="RailSectionTitle" />
            <TextBlock Text="{x:Static i18n:Strings.Settings_Theme_Tagline}"
                       Classes="Secondary"
                       FontSize="{DynamicResource ByhFontSizeCaption}" />
            <TextBlock Text="{x:Static i18n:Strings.Settings_Theme_Description}"
                       Classes="RailBody"
                       MaxWidth="112"
                       HorizontalAlignment="Left"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border Grid.Row="1"
                BorderBrush="{DynamicResource ByhRailRuleBrush}"
                BorderThickness="0,0,0,1"
                Padding="22,16,18,14">
          <StackPanel Spacing="10" VerticalAlignment="Center">
            <TextBlock Text="{x:Static i18n:Strings.Settings_Theme_ColorPalette}" Classes="RailSectionTitle" />
            <Grid ColumnDefinitions="48,*"
                  RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                  ColumnSpacing="9" RowSpacing="5">
              <Border Grid.Row="0" Width="40" Height="18" CornerRadius="6"
                      Background="#E8C89A" BorderBrush="#80D5A86A" BorderThickness="1" />
              <StackPanel Grid.Row="0" Grid.Column="1" Spacing="0" VerticalAlignment="Center">
                <TextBlock Text="{x:Static i18n:Strings.Settings_Theme_Role_Primary}" FontSize="{DynamicResource ByhFontSizeCaption}" FontWeight="SemiBold" />
                <TextBlock Text="#E8C89A" Classes="Muted" FontSize="{DynamicResource ByhFontSizeMicro}" />
              </StackPanel>
              <Border Grid.Row="1" Width="40" Height="18" CornerRadius="6"
                      Background="#D5A86A" BorderBrush="#70B77934" BorderThickness="1" />
              <StackPanel Grid.Row="1" Grid.Column="1" Spacing="0" VerticalAlignment="Center">
                <TextBlock Text="{x:Static i18n:Strings.Settings_Theme_Role_Secondary}" FontSize="{DynamicResource ByhFontSizeCaption}" FontWeight="SemiBold" />
                <TextBlock Text="#D5A86A" Classes="Muted" FontSize="{DynamicResource ByhFontSizeMicro}" />
              </StackPanel>
              <Border Grid.Row="2" Width="40" Height="18" CornerRadius="6"
                      Background="#8FAE5A" BorderBrush="#70667731" BorderThickness="1" />
              <StackPanel Grid.Row="2" Grid.Column="1" Spacing="0" VerticalAlignment="Center">
                <TextBlock Text="{x:Static i18n:Strings.Settings_Theme_Role_Accent}" FontSize="{DynamicResource ByhFontSizeCaption}" FontWeight="SemiBold" />
                <TextBlock Text="#8FAE5A" Classes="Muted" FontSize="{DynamicResource ByhFontSizeMicro}" />
              </StackPanel>
              <Border Grid.Row="3" Width="40" Height="18" CornerRadius="6"
                      Background="#6B4B2A" BorderBrush="#70513822" BorderThickness="1" />
              <StackPanel Grid.Row="3" Grid.Column="1" Spacing="0" VerticalAlignment="Center">
                <TextBlock Text="{x:Static i18n:Strings.Settings_Theme_Role_DeepBrown}" FontSize="{DynamicResource ByhFontSizeCaption}" FontWeight="SemiBold" />
                <TextBlock Text="#6B4B2A" Classes="Muted" FontSize="{DynamicResource ByhFontSizeMicro}" />
              </StackPanel>
              <Border Grid.Row="4" Width="40" Height="18" CornerRadius="6"
                      Background="#FFF7EE" BorderBrush="#90E8C89A" BorderThickness="1" />
              <StackPanel Grid.Row="4" Grid.Column="1" Spacing="0" VerticalAlignment="Center">
                <TextBlock Text="{x:Static i18n:Strings.Settings_Theme_Role_Cream}" FontSize="{DynamicResource ByhFontSizeCaption}" FontWeight="SemiBold" />
                <TextBlock Text="#FFF7EE" Classes="Muted" FontSize="{DynamicResource ByhFontSizeMicro}" />
              </StackPanel>
              <Border Grid.Row="5" Width="40" Height="18" CornerRadius="6"
                      Background="#F6F1E6" BorderBrush="#90EAD8B8" BorderThickness="1" />
              <StackPanel Grid.Row="5" Grid.Column="1" Spacing="0" VerticalAlignment="Center">
                <TextBlock Text="{x:Static i18n:Strings.Settings_Theme_Role_Ivory}" FontSize="{DynamicResource ByhFontSizeCaption}" FontWeight="SemiBold" />
                <TextBlock Text="#F6F1E6" Classes="Muted" FontSize="{DynamicResource ByhFontSizeMicro}" />
              </StackPanel>
              <Border Grid.Row="6" Width="40" Height="18" CornerRadius="6"
                      Background="#EAD8B8" BorderBrush="#90D5A86A" BorderThickness="1" />
              <StackPanel Grid.Row="6" Grid.Column="1" Spacing="0" VerticalAlignment="Center">
                <TextBlock Text="{x:Static i18n:Strings.Settings_Theme_Role_Border}" FontSize="{DynamicResource ByhFontSizeCaption}" FontWeight="SemiBold" />
                <TextBlock Text="#EAD8B8" Classes="Muted" FontSize="{DynamicResource ByhFontSizeMicro}" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <Border Grid.Row="2"
                BorderBrush="{DynamicResource ByhRailRuleBrush}"
                BorderThickness="0,0,0,1"
                Padding="22,14,18,12">
          <StackPanel Spacing="8" VerticalAlignment="Center">
            <TextBlock Text="{x:Static i18n:Strings.Settings_Theme_Typography}" Classes="RailSectionTitle" />
            <Grid ColumnDefinitions="42,*" ColumnSpacing="8">
              <TextBlock Text="Aa" FontFamily="Georgia" FontSize="{DynamicResource ByhFontSizeDisplay}" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                <TextBlock Text="{x:Static i18n:Strings.Settings_Theme_HeadingFont}" FontSize="{DynamicResource ByhFontSizeCaption}" FontWeight="SemiBold" />
                <TextBlock Text="Georgia" Classes="Muted" FontSize="{DynamicResource ByhFontSizeMicro}" />
              </StackPanel>
            </Grid>
            <Grid ColumnDefinitions="42,*" ColumnSpacing="8">
              <TextBlock Text="Aa" FontFamily="Segoe UI" FontSize="{DynamicResource ByhFontSizeDisplay}" FontWeight="Light" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                <TextBlock Text="{x:Static i18n:Strings.Settings_Theme_BodyFont}" FontSize="{DynamicResource ByhFontSizeCaption}" FontWeight="SemiBold" />
                <TextBlock Text="Segoe UI" Classes="Muted" FontSize="{DynamicResource ByhFontSizeMicro}" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <Border Grid.Row="3" Padding="22,14,18,14">
          <StackPanel Spacing="11" VerticalAlignment="Center">
            <TextBlock Text="{x:Static i18n:Strings.Settings_Theme_IconStyle}" Classes="RailSectionTitle" />
            <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="8">
              <Path Grid.Column="0" Classes="RailSampleIcon"
                    Data="M3,10 L12,3 L21,10 M5,9 L5,20 L19,20 L19,9 M9,20 L9,14 L15,14 L15,20" />
              <Path Grid.Column="1" Classes="RailSampleIcon"
                    Data="M12,3 L19,8 L16,18 L8,18 L5,8 Z M5,8 L19,8 M8,18 L12,8 L16,18" />
              <Path Grid.Column="2" Classes="RailSampleIcon"
                    Data="M12,21 C12,14 7,12 4,7 C10,7 12,10 12,14 M12,21 C12,13 17,10 20,5 C14,5 12,9 12,14" />
              <Path Grid.Column="3" Classes="RailSampleIcon"
                    Data="M3,6 L21,6 L21,18 L3,18 Z M3,7 L12,14 L21,7" />
              <Path Grid.Column="4" Classes="RailSampleIcon"
                    Data="M12,8 A4,4 0 1 0 12,16 A4,4 0 1 0 12,8 M12,2 L13,5 M12,19 L12,22 M2,12 L5,12 M19,12 L22,12 M5,5 L7,7 M17,17 L19,19 M19,5 L17,7 M7,17 L5,19" />
            </Grid>
            <TextBlock Text="{x:Static i18n:Strings.Settings_Theme_IconStyleDesc}"
                       Classes="RailBody"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <!-- Portrait-led welcome card plus real runtime summary. The character art
         is the actual BYH app icon supplied by the user, not decorative mock data. -->
    <Border Grid.Column="3"
             Grid.Row="0"
             Classes="MetallicFrame Thin PhoneFrame"
            Margin="0,14,0,12"
            VerticalAlignment="Stretch"
            Background="{DynamicResource ByhPanelIvoryBrush}">
      <Border Classes="MacroClip PhoneClip"
              Background="{DynamicResource ByhPanelIvoryBrush}">
        <Grid RowDefinitions="122,*,Auto">
        <Image Grid.RowSpan="3"
               Source="avares://SelectionAssistant.UI/Assets/Theme/ivory-jade-ornament.jpg"
               Stretch="UniformToFill"
               Opacity="0.28"
               IsHitTestVisible="False" />

        <Border ClipToBounds="True">
          <Grid>
            <Border Width="144"
                    Height="144"
                    CornerRadius="72"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,-24,-22,0"
                    Background="{DynamicResource ByhGemGlowBrush}" />
            <StackPanel Margin="18,21,102,12" Spacing="3">
              <StackPanel Orientation="Horizontal" Spacing="3">
                <TextBlock Text="{x:Static i18n:Strings.Settings_Greeting_Prefix}" Classes="Kicker" />
                <TextBlock x:Name="GreetingUserNameText"
                           Text="{x:Static i18n:Strings.Settings_Greeting_DefaultName}"
                           Classes="Kicker"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="90"
                           AutomationProperties.AutomationId="BYH.Settings.Phone.GreetingName" />
              </StackPanel>
              <Image Source="avares://SelectionAssistant.UI/Assets/Theme/byh-wordmark.png"
                     Width="94"
                     Height="30"
                     Margin="-2,0,0,0"
                     HorizontalAlignment="Left"
                     Stretch="Uniform" />
              <TextBlock Text="{x:Static i18n:Strings.Settings_Phone_Tagline}"
                         Classes="Secondary"
                         FontSize="{DynamicResource ByhFontSizeCaption}"
                         TextWrapping="Wrap" />
            </StackPanel>
            <Border Classes="GemPortrait"
                    Width="112"
                    Height="112"
                    Padding="3"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,6,3">
              <Image Source="avares://BYH/Assets/app-icon.png"
                     Stretch="Uniform" />
            </Border>
            <Border Classes="Badge"
                    Padding="7,3"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Margin="18,0,0,12">
              <TextBlock Text="IVORY JADE" Classes="Accent" FontSize="{DynamicResource ByhFontSizeCaption}" FontWeight="SemiBold" />
            </Border>
          </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Disabled">
          <Grid Margin="12,5,12,5">
            <!-- The handset owns a separate five-page information space. None
                 of these views change the central settings page or its scroll. -->
            <StackPanel x:Name="PhoneOverviewView"
                        Spacing="6">
              <TextBlock Text="{x:Static i18n:Strings.Settings_Phone_CurrentSetup}"
                         Classes="DisplayTitle"
                         FontSize="14"
                         Margin="4,0,0,2"
                         AutomationProperties.AutomationId="BYH.Settings.PhoneView.Overview" />
              <Border Classes="PorcelainCard" Padding="10,8">
                <StackPanel Spacing="7">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                    <Border Classes="PhoneSummaryIcon Accent">
                      <Path Classes="MiniIcon"
                            Stroke="{DynamicResource ByhAccentHoverBrush}"
                            Data="M12,3 A9,9 0 1 0 12,21 A9,9 0 1 0 12,3 M3,12 L21,12 M12,3 C15,7 15,17 12,21 C9,17 9,7 12,3" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                      <TextBlock Text="{x:Static i18n:Strings.Settings_Phone_ProviderLabel}" Classes="Muted" FontSize="7" FontWeight="SemiBold" />
                      <TextBlock x:Name="SummaryProviderText" Text="{x:Static i18n:Strings.Settings_Loading}" Classes="PhoneSummaryValue" />
                    </StackPanel>
                  </Grid>
                  <Border Classes="PhoneSummaryDivider" />
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                    <Border Classes="PhoneSummaryIcon Warning">
                      <Path Classes="MiniIcon"
                            Stroke="{DynamicResource ByhWarningBrush}"
                            Data="M3,7 L21,7 L21,17 L3,17 Z M7,10.5 L9,10.5 M11,10.5 L13,10.5 M15,10.5 L17,10.5 M7,14 L17,14" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                      <TextBlock Text="{x:Static i18n:Strings.Settings_Phone_OceanEyesLabel}" Classes="Muted" FontSize="7" FontWeight="SemiBold" />
                      <TextBlock x:Name="SummaryShortcutText" Text="{x:Static i18n:Strings.Settings_Loading}" Classes="PhoneSummaryValue" />
                    </StackPanel>
                  </Grid>
                  <Border Classes="PhoneSummaryDivider" />
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                    <Border Classes="PhoneSummaryIcon Success">
                      <Path Classes="MiniIcon"
                            Stroke="{DynamicResource ByhPrimaryBrush}"
                            Data="M2,12 C5.2,6.8 8.5,5 12,5 C15.5,5 18.8,6.8 22,12 C18.8,17.2 15.5,19 12,19 C8.5,19 5.2,17.2 2,12 Z M12,9 A3,3 0 1 0 12,15 A3,3 0 1 0 12,9" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                      <TextBlock Text="{x:Static i18n:Strings.Settings_Phone_VisionLabel}" Classes="Muted" FontSize="7" FontWeight="SemiBold" />
                      <TextBlock x:Name="SummaryVisionText" Text="{x:Static i18n:Strings.Settings_Loading}" Classes="PhoneSummaryValue" />
                    </StackPanel>
                  </Grid>
                  <Border Classes="PhoneSummaryDivider" />
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                    <Border Classes="PhoneSummaryIcon Accent">
                      <Path Classes="MiniIcon"
                            Stroke="{DynamicResource ByhAccentBrush}"
                            Data="M5,3 L19,3 A2,2 0 0 1 21,5 L21,17 A2,2 0 0 1 19,19 L9,19 L5,22 Z M9,7 L17,7 M9,11 L17,11 M9,15 L14,15" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                      <TextBlock Text="{x:Static i18n:Strings.Settings_Phone_ClipboardLabel}" Classes="Muted" FontSize="7" FontWeight="SemiBold" />
                      <TextBlock x:Name="SummaryClipboardText" Text="{x:Static i18n:Strings.Settings_Loading}" Classes="PhoneSummaryValue" />
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </Border>
            </StackPanel>

            <StackPanel x:Name="PhoneTranslationView"
                        IsVisible="False"
                        Spacing="8">
              <StackPanel Margin="4,0,0,1" Spacing="2">
                <TextBlock Text="{x:Static i18n:Strings.Settings_Phone_Translation_Title}"
                           Classes="DisplayTitle"
                           FontSize="14"
                           AutomationProperties.AutomationId="BYH.Settings.PhoneView.Translation" />
                <TextBlock Text="{x:Static i18n:Strings.Settings_Phone_Translation_Subtitle}" Classes="Secondary" FontSize="8" />
              </StackPanel>
              <Border Classes="PorcelainCard" Padding="12">
                <StackPanel Spacing="10">
                  <Border Classes="PhoneFeatureEmblem Accent">
                    <Path Classes="MiniIcon" Stroke="{DynamicResource ByhAccentHoverBrush}"
                          Data="M12,3 A9,9 0 1 0 12,21 A9,9 0 1 0 12,3 M3,12 L21,12 M12,3 C15,7 15,17 12,21 C9,17 9,7 12,3" />
                  </Border>
                  <StackPanel Spacing="3">
                    <TextBlock Text="{x:Static i18n:Strings.Settings_Phone_Translation_ActiveProvider}" Classes="Muted" FontSize="7" FontWeight="SemiBold" />
                    <TextBlock x:Name="PhoneProviderNameText" Text="{x:Static i18n:Strings.Settings_Loading}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="PhoneProviderModelText" Text="{x:Static i18n:Strings.Settings_Loading}" Classes="Secondary" FontSize="9" TextWrapping="Wrap" />
                  </StackPanel>
                  <Border Classes="PhoneSummaryDivider" />
                  <TextBlock x:Name="PhoneProviderCountText" Text="{x:Static i18n:Strings.Settings_Loading}" Classes="PhoneStatusPill" />
                </StackPanel>
              </Border>
              <TextBlock Text="{x:Static i18n:Strings.Settings_Phone_Translation_ManageHint}"
                         Classes="Muted" FontSize="8" TextWrapping="Wrap" Margin="4,0" />
            </StackPanel>

            <StackPanel x:Name="PhoneVisionView"
                        IsVisible="False"
                        Spacing="8">
              <StackPanel Margin="4,0,0,1" Spacing="2">
                <TextBlock Text="{x:Static i18n:Strings.Settings_Phone_Vision_Title}"
                           Classes="DisplayTitle"
                           FontSize="14"
                           AutomationProperties.AutomationId="BYH.Settings.PhoneView.Vision" />
                <TextBlock x:Name="PhoneVisionStatusText" Text="{x:Static i18n:Strings.Settings_Loading}" Classes="Secondary" FontSize="8" />
              </StackPanel>
              <Border Classes="PorcelainCard" Padding="12">
                <StackPanel Spacing="9">
                  <Border Classes="PhoneFeatureEmblem Success">
                    <Path Classes="MiniIcon" Stroke="{DynamicResource ByhPrimaryBrush}"
                          Data="M2,12 C5.2,6.8 8.5,5 12,5 C15.5,5 18.8,6.8 22,12 C18.8,17.2 15.5,19 12,19 C8.5,19 5.2,17.2 2,12 Z M12,9 A3,3 0 1 0 12,15 A3,3 0 1 0 12,9" />
                  </Border>
                  <StackPanel Spacing="3">
                    <TextBlock Text="{x:Static i18n:Strings.Settings_Phone_Vision_OcrProvider}" Classes="Muted" FontSize="7" FontWeight="SemiBold" />
                    <TextBlock x:Name="PhoneVisionProviderText" Text="{x:Static i18n:Strings.Settings_Loading}" FontSize="12" FontWeight="SemiBold" />
                    <TextBlock x:Name="PhoneVisionModelText" Text="{x:Static i18n:Strings.Settings_Loading}" Classes="Secondary" FontSize="9" TextWrapping="Wrap" />
                  </StackPanel>
                  <Border Classes="PhoneSummaryDivider" />
                  <TextBlock x:Name="PhoneVisionAssistText" Text="{x:Static i18n:Strings.Settings_Loading}" Classes="PhoneStatusPill" />
                </StackPanel>
              </Border>
            </StackPanel>

            <StackPanel x:Name="PhoneClipboardView"
                        IsVisible="False"
                        Spacing="8">
              <StackPanel Margin="4,0,0,1" Spacing="2">
                <TextBlock Text="{x:Static i18n:Strings.Settings_Phone_Clipboard_Title}"
                           Classes="DisplayTitle"
                           FontSize="14"
                           AutomationProperties.AutomationId="BYH.Settings.PhoneView.Clipboard" />
                <TextBlock x:Name="PhoneClipboardStatusText" Text="{x:Static i18n:Strings.Settings_Loading}" Classes="Secondary" FontSize="8" />
              </StackPanel>
              <Border Classes="PorcelainCard" Padding="12">
                <StackPanel Spacing="10">
                  <Border Classes="PhoneFeatureEmblem Accent">
                    <Path Classes="MiniIcon" Stroke="{DynamicResource ByhAccentBrush}"
                          Data="M5,3 L19,3 A2,2 0 0 1 21,5 L21,17 A2,2 0 0 1 19,19 L9,19 L5,22 Z M9,7 L17,7 M9,11 L17,11 M9,15 L14,15" />
                  </Border>
                  <StackPanel Spacing="3">
                    <TextBlock Text="{x:Static i18n:Strings.Settings_Phone_Clipboard_HistoryHotkey}" Classes="Muted" FontSize="7" FontWeight="SemiBold" />
                    <TextBlock x:Name="PhoneClipboardHotkeyText" Text="{x:Static i18n:Strings.Settings_Loading}" FontSize="12" FontWeight="SemiBold" />
                  </StackPanel>
                  <Border Classes="PhoneSummaryDivider" />
                  <StackPanel Spacing="3">
                    <TextBlock Text="{x:Static i18n:Strings.Settings_Phone_Clipboard_LocalRetention}" Classes="Muted" FontSize="7" FontWeight="SemiBold" />
                    <TextBlock x:Name="PhoneClipboardRetentionText" Text="{x:Static i18n:Strings.Settings_Loading}" Classes="Secondary" FontSize="9" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </StackPanel>

            <StackPanel x:Name="PhoneLauncherView"
                        IsVisible="False"
                        Spacing="8">
              <StackPanel Margin="4,0,0,1" Spacing="2">
                <TextBlock Text="{x:Static i18n:Strings.Settings_Phone_Launcher_Title}"
                           Classes="DisplayTitle"
                           FontSize="14"
                           AutomationProperties.AutomationId="BYH.Settings.PhoneView.Launcher" />
                <TextBlock Text="{x:Static i18n:Strings.Settings_Phone_Launcher_Subtitle}" Classes="Secondary" FontSize="8" />
              </StackPanel>
              <Border Classes="PorcelainCard" Padding="12">
                <StackPanel Spacing="9">
                  <Border Classes="PhoneFeatureEmblem Warning">
                    <Path Classes="MiniIcon" Stroke="{DynamicResource ByhWarningBrush}"
                          Data="M12,8 A4,4 0 1 0 12,16 A4,4 0 1 0 12,8 M12,2 L13,5 M12,19 L12,22 M2,12 L5,12 M19,12 L22,12 M5,5 L7,7 M17,17 L19,19 M19,5 L17,7 M7,17 L5,19" />
                  </Border>
                  <StackPanel Spacing="3">
                    <TextBlock Text="{x:Static i18n:Strings.Settings_Phone_Launcher_SpotlightHotkey}" Classes="Muted" FontSize="7" FontWeight="SemiBold" />
                    <TextBlock x:Name="PhoneLauncherHotkeyText" Text="{x:Static i18n:Strings.Settings_Loading}" FontSize="12" FontWeight="SemiBold" />
                  </StackPanel>
                  <Border Classes="PhoneSummaryDivider" />
                  <TextBlock x:Name="PhoneLauncherCountText" Text="{x:Static i18n:Strings.Settings_Loading}" Classes="PhoneStatusPill" />
                  <TextBlock x:Name="PhoneLauncherPreviewText" Text="{x:Static i18n:Strings.Settings_Loading}" Classes="Secondary" FontSize="8" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>
        </ScrollViewer>

        <!-- Phone-style bottom dock. Its state and content are intentionally
             independent from the central settings navigation. -->
        <Border Grid.Row="2" Margin="10,4,10,10" Classes="PhoneDock">
          <Grid ColumnDefinitions="*,*,*,*,*" Height="42">
            <Button x:Name="PhoneGeneralButton"
                    Grid.Column="0"
                    Classes="PhoneDockButton Active"
                    ToolTip.Tip="Overview"
                    AutomationProperties.Name="Phone overview"
                    AutomationProperties.AutomationId="BYH.Settings.PhoneNav.General"
                    Click="OnShowPhoneOverviewClick">
              <Border Classes="PhoneDockItem">
                <Path Classes="PhoneDockIcon"
                      Data="M3,10 L12,3 L21,10 M5,9 L5,20 L19,20 L19,9 M9,20 L9,14 L15,14 L15,20" />
              </Border>
            </Button>
            <Button x:Name="PhoneProviderButton"
                    Grid.Column="1"
                    Classes="PhoneDockButton"
                    ToolTip.Tip="Translation"
                    AutomationProperties.Name="Phone translation summary"
                    AutomationProperties.AutomationId="BYH.Settings.PhoneNav.Translation"
                    Click="OnShowPhoneTranslationClick">
              <Border Classes="PhoneDockItem">
                <Path Classes="PhoneDockIcon"
                      Data="M12,3 L19,8 L16,18 L8,18 L5,8 Z M5,8 L19,8 M8,18 L12,8 L16,18" />
              </Border>
            </Button>
            <Button x:Name="PhoneVisionButton"
                    Grid.Column="2"
                    Classes="PhoneDockButton Center"
                    ToolTip.Tip="Vision"
                    AutomationProperties.Name="Phone vision summary"
                    AutomationProperties.AutomationId="BYH.Settings.PhoneNav.Vision"
                    Click="OnShowPhoneVisionClick">
              <Border Classes="PhoneDockItem Center">
                <Path Classes="PhoneDockIcon"
                      Data="M12,21 C12,14 7,12 4,7 C10,7 12,10 12,14 M12,21 C12,13 17,10 20,5 C14,5 12,9 12,14" />
              </Border>
            </Button>
            <Button x:Name="PhoneClipboardButton"
                    Grid.Column="3"
                    Classes="PhoneDockButton"
                    ToolTip.Tip="Clipboard"
                    AutomationProperties.Name="Phone clipboard summary"
                    AutomationProperties.AutomationId="BYH.Settings.PhoneNav.Clipboard"
                    Click="OnShowPhoneClipboardClick">
              <Border Classes="PhoneDockItem">
                <Path Classes="PhoneDockIcon"
                      Data="M3,6 L21,6 L21,18 L3,18 Z M3,7 L12,14 L21,7" />
              </Border>
            </Button>
            <Button x:Name="PhoneLauncherButton"
                    Grid.Column="4"
                    Classes="PhoneDockButton"
                    ToolTip.Tip="Launcher"
                    AutomationProperties.Name="Phone launcher summary"
                    AutomationProperties.AutomationId="BYH.Settings.PhoneNav.Launcher"
                    Click="OnShowPhoneLauncherClick">
              <Border Classes="PhoneDockItem">
                <Path Classes="PhoneDockIcon"
                      Data="M12,8 A4,4 0 1 0 12,16 A4,4 0 1 0 12,8 M12,2 L13,5 M12,19 L12,22 M2,12 L5,12 M19,12 L22,12 M5,5 L7,7 M17,17 L19,19 M19,5 L17,7 M7,17 L5,19" />
              </Border>
            </Button>
          </Grid>
        </Border>
        </Grid>
      </Border>
    </Border>

    <!-- Reference bottom strip: useful, real controls instead of invented metrics. -->
    <Border Grid.Column="1"
            Grid.ColumnSpan="2"
            Grid.Row="1"
            MinHeight="220"
            Classes="MetallicFrame Thin"
            Background="{DynamicResource ByhPanelIvoryBrush}">
      <Border Classes="MacroClip">
      <!-- R30 follow-up: the reference composition treats the lower area as one coherent
           pane: a quiet title band above grouped content.  Keep the three real
           modules, but remove the nested card-per-module rhythm. -->
      <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0"
                Background="Transparent"
                BorderThickness="0"
                Padding="18,10,16,4">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <StackPanel Spacing="2">
              <TextBlock Text="{x:Static i18n:Strings.Settings_Overview_Title}"
                         FontFamily="Georgia"
                         FontSize="{DynamicResource ByhFontSizeBodyLarge}" />
            </StackPanel>
            <TextBlock Grid.Column="1"
                       Text="BYH · LOCAL FIRST"
                       Classes="Kicker"
                       FontSize="{DynamicResource ByhFontSizeCaption}"
                       VerticalAlignment="Center" />
          </Grid>
        </Border>


        <Border Grid.Row="1"
                Background="Transparent"
                Padding="16,6,16,13">
          <Grid ColumnDefinitions="0.72*,1,0.8*,1,1.18*">
            <StackPanel Grid.Column="0" Spacing="9" Margin="2,0,14,0">
              <TextBlock Text="{x:Static i18n:Strings.Settings_Overview_Runtime}" FontFamily="Georgia" FontSize="{DynamicResource ByhFontSizeBodyLarge}" />
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                <Border Width="28" Height="28" CornerRadius="14"
                        Background="{DynamicResource ByhSuccessSoftBrush}"
                        BorderBrush="#40D9C28A"
                        BorderThickness="1"
                        BoxShadow="0 2 6 0 #109F5E30"
                        VerticalAlignment="Center">
                  <Border Width="10" Height="10" CornerRadius="5"
                          Background="{DynamicResource ByhSuccessBrush}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                  <TextBlock Text="{x:Static i18n:Strings.Settings_Overview_CaptureActive}" FontSize="{DynamicResource ByhFontSizeBody}" FontWeight="SemiBold" TextWrapping="Wrap" />
                </StackPanel>
              </Grid>
            </StackPanel>

            <Border Grid.Column="1"
                    Width="1"
                    Background="{DynamicResource ByhHairlineBrush}"
                    HorizontalAlignment="Center" />

            <StackPanel Grid.Column="2" Spacing="7" Margin="16,0">
              <TextBlock Text="{x:Static i18n:Strings.Settings_Overview_Theme}" FontFamily="Georgia" FontSize="{DynamicResource ByhFontSizeBodyLarge}" />
              <TextBlock Text="{x:Static i18n:Strings.Settings_Overview_ThemeValue}" FontSize="{DynamicResource ByhFontSizeBody}" FontWeight="SemiBold" />
              <StackPanel Orientation="Horizontal" Spacing="5">
                <Border Width="16" Height="16" CornerRadius="5"
                        Background="{DynamicResource ByhSurfaceBrush}"
                        BorderBrush="{DynamicResource ByhBorderBrush}"
                        BorderThickness="1"
                        BoxShadow="0 1 3 0 #0D4A2B19" />
                <Border Width="16" Height="16" CornerRadius="5"
                        Background="{DynamicResource ByhPrimaryBrush}"
                        BoxShadow="0 1 3 0 #0D4A2B19" />
                <Border Width="16" Height="16" CornerRadius="5"
                        Background="{DynamicResource ByhGoldBrush}"
                        BoxShadow="0 1 3 0 #0D4A2B19" />
                <Border Width="16" Height="16" CornerRadius="5"
                        Background="{DynamicResource ByhAccentBrush}"
                        BoxShadow="0 1 3 0 #0D4A2B19" />
              </StackPanel>
            </StackPanel>

            <Border Grid.Column="3"
                    Width="1"
                    Background="{DynamicResource ByhHairlineBrush}"
                    HorizontalAlignment="Center" />

            <Grid Grid.Column="4"
                  RowDefinitions="Auto,*,Auto"
                  Margin="16,0,2,0">
              <TextBlock Text="{x:Static i18n:Strings.Settings_Overview_Diagnostics}" FontFamily="Georgia" FontSize="{DynamicResource ByhFontSizeBodyLarge}" />
              <TextBlock x:Name="PolicyPathText"
                         Grid.Row="1"
                         Margin="0,7,0,5"
                         Classes="Muted"
                         FontSize="{DynamicResource ByhFontSizeCaption}"
                         TextWrapping="Wrap"
                         TextTrimming="CharacterEllipsis"
                         MaxLines="2" />
              <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                <Button Content="{x:Static i18n:Strings.Settings_OpenConfigFolder}" Click="OnOpenConfigDirectoryClick" />
                <Button Content="{x:Static i18n:Strings.Settings_OpenLogFolder}" Click="OnOpenLogDirectoryClick" />
              </StackPanel>
            </Grid>
          </Grid>
        </Border>
      </Grid>
      </Border>
    </Border>

    <Border Grid.Column="3"
            Grid.Row="1"
            Classes="MetallicFrame Thin"
            Background="{DynamicResource ByhPanelIvoryBrush}">
      <Border Classes="MacroClip"
              Background="{DynamicResource ByhPanelIvoryBrush}"
              Padding="16">
        <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Spacing="3">
          <TextBlock Text="{x:Static i18n:Strings.Settings_WindowControls_Title}" FontFamily="Georgia" FontSize="{DynamicResource ByhFontSizeBodyLarge}" />
          <TextBlock Text="{x:Static i18n:Strings.Settings_VersionTag}" Classes="Muted" FontSize="{DynamicResource ByhFontSizeCaption}" />
        </StackPanel>
        <TextBlock Grid.Row="1"
                   Text="{x:Static i18n:Strings.Settings_WindowControls_Hint}"
                   Classes="Secondary"
                   FontSize="{DynamicResource ByhFontSizeCaption}"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center" />
        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="8">
          <Button Content="{x:Static i18n:Strings.Settings_Hide}" Classes="Ghost" Click="OnHideClick" />
          <Button Grid.Column="1" Content="{x:Static i18n:Strings.Settings_Exit}" Classes="DangerQuiet" Click="OnExitClick" />
        </Grid>
        </Grid>
      </Border>
    </Border>
  </Grid>
</Window>
