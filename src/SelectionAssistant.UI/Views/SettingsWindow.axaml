<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SelectionAssistant.UI.Views"
        x:Class="SelectionAssistant.UI.Views.SettingsWindow"
        Title="BYH · Settings"
        Width="1320"
        Height="840"
        MinWidth="1240"
        MinHeight="720"
        CanResize="True"
        Background="{DynamicResource ByhBackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        AutomationProperties.AutomationId="BYH.Settings.Window"
        KeyDown="OnWindowKeyDown">
  <Grid x:Name="ShellGrid"
          RowDefinitions="2.15*,1*"
          ColumnSpacing="12"
          RowSpacing="12"
          Margin="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="190" />
        <ColumnDefinition Width="170" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="270" />
      </Grid.ColumnDefinitions>

    <!-- R54 atmosphere: a large warm radial glow behind the floating panels,
         echoing the soft bokeh light pools in the Foamie reference. -->
    <Border Grid.Column="0" Grid.ColumnSpan="4" Grid.Row="0" Grid.RowSpan="2"
            Background="{DynamicResource ByhAtmosphereBrush}"
            IsHitTestVisible="False" />

    <!-- The ornament sits behind navigation content while MetallicFrame keeps
         the reference's close, concentric champagne-gold double curve. -->
    <Border Grid.Column="1"
            Grid.Row="0"
            Classes="MetallicFrame Compact Thin">
      <Border Classes="MacroClip Compact"
              Background="{DynamicResource ByhPanelIvoryBrush}">
        <Grid>
        <Image Source="avares://SelectionAssistant.UI/Assets/Theme/ivory-jade-ornament.jpg"
               Stretch="UniformToFill"
               Opacity="0.30"
               IsHitTestVisible="False" />
        <Grid Margin="8,8,8,7" RowDefinitions="Auto,*,Auto">
        <StackPanel Grid.Row="0" Spacing="3" Margin="4,0,4,7">
          <Border Width="48"
                  Height="48"
                  HorizontalAlignment="Center"
                  Background="{DynamicResource ByhGemGlowBrush}"
                  CornerRadius="24"
                  Padding="3">
            <Border Width="42"
                    Height="42"
                    Background="{DynamicResource ByhSurfaceBrush}"
                    BorderBrush="{DynamicResource ByhHairlineBrush}"
                    BorderThickness="1"
                    CornerRadius="21"
                    ClipToBounds="True">
              <Image Source="avares://SelectionAssistant.UI/Assets/Theme/ivory-jade-emblem.jpg"
                     Width="60"
                     Height="60"
                     Stretch="UniformToFill"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />
            </Border>
          </Border>
          <TextBlock Text="BYH"
                     Classes="DisplayTitle"
                     FontSize="21"
                     HorizontalAlignment="Center" />
          <TextBlock Text="By Your Hand"
                     Classes="Secondary"
                     FontSize="10"
                     HorizontalAlignment="Center" />
          <Border Width="32"
                  Height="2"
                  HorizontalAlignment="Center"
                  Background="{DynamicResource ByhGoldBrush}"
                  CornerRadius="1" />
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="3" VerticalAlignment="Top">

          <Button x:Name="GeneralNavButton"
                  Classes="SettingsNav Active"
                  Padding="12,8"
                  AutomationProperties.AutomationId="BYH.Settings.Nav.General"
                  Click="OnShowGeneralClick">
            <Grid ColumnDefinitions="22,*" ColumnSpacing="9">
              <Path Classes="NavIcon"
                    Data="M3,10 L12,3 L21,10 M5,9 L5,20 L19,20 L19,9 M9,20 L9,14 L15,14 L15,20" />
              <TextBlock Grid.Column="1" Text="General" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
            </Grid>
          </Button>

          <Button x:Name="ProviderNavButton"
                  Classes="SettingsNav"
                  Padding="12,8"
                  AutomationProperties.AutomationId="BYH.Settings.Nav.Translation"
                  Click="OnShowProviderClick">
            <Grid ColumnDefinitions="22,*" ColumnSpacing="9">
              <Path Classes="NavIcon"
                    Data="M4,5 L20,5 L20,19 L4,19 Z M8,9 L16,9 M8,13 L16,13 M8,17 L13,17" />
              <TextBlock Grid.Column="1" Text="Translation" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
            </Grid>
          </Button>

          <Button x:Name="FunctionsNavButton"
                  Classes="SettingsNav"
                  Padding="12,8"
                  AutomationProperties.AutomationId="BYH.Settings.Nav.Actions"
                  Click="OnShowFunctionsClick">
            <Grid ColumnDefinitions="22,*" ColumnSpacing="9">
              <Path Classes="NavIcon"
                    Data="M12,3 L14.7,8.3 L20.5,9.2 L16.3,13.3 L17.3,19 L12,16.3 L6.7,19 L7.7,13.3 L3.5,9.2 L9.3,8.3 Z" />
              <TextBlock Grid.Column="1" Text="Actions" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
            </Grid>
          </Button>

          <Button x:Name="VisionNavButton"
                  Classes="SettingsNav"
                  Padding="12,8"
                  AutomationProperties.AutomationId="BYH.Settings.Nav.Vision"
                  Click="OnShowVisionClick">
            <Grid ColumnDefinitions="22,*" ColumnSpacing="9">
              <Path Classes="NavIcon"
                    Data="M2,12 C5.2,6.8 8.5,5 12,5 C15.5,5 18.8,6.8 22,12 C18.8,17.2 15.5,19 12,19 C8.5,19 5.2,17.2 2,12 Z M12,9 A3,3 0 1 0 12,15 A3,3 0 1 0 12,9" />
              <TextBlock Grid.Column="1" Text="Vision" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
            </Grid>
          </Button>

          <Button x:Name="LauncherNavButton"
                  Classes="SettingsNav"
                  Padding="12,8"
                  AutomationProperties.AutomationId="BYH.Settings.Nav.Launcher"
                  Click="OnShowLauncherClick">
            <Grid ColumnDefinitions="22,*" ColumnSpacing="9">
              <Path Classes="NavIcon"
                    Data="M13,2 L4,13 L11,13 L10,22 L20,10 L13,10 Z" />
              <TextBlock Grid.Column="1" Text="Launcher" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
            </Grid>
          </Button>

          <Button x:Name="ClipboardHistoryNavButton"
                  Classes="SettingsNav"
                  Padding="12,8"
                  AutomationProperties.AutomationId="BYH.Settings.Nav.Clipboard"
                  Click="OnShowClipboardHistoryClick">
            <Grid ColumnDefinitions="22,*" ColumnSpacing="9">
              <Path Classes="NavIcon"
                    Data="M4,2 L20,2 A2,2 0 0 1 22,4 L22,16 A2,2 0 0 1 20,18 L8,18 L4,22 Z" />
              <TextBlock Grid.Column="1" Text="Clipboard" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
            </Grid>
          </Button>
        </StackPanel>

        <!-- Reference nav card carries a gem ornament at both ends; this is
             the smaller foot gem mirroring the emblem above the brand. -->
        <Border Grid.Row="2"
                Width="22"
                Height="22"
                CornerRadius="11"
                Background="{DynamicResource ByhGemGlowBrush}"
                Padding="2"
                HorizontalAlignment="Center"
                Margin="0,4,0,0">
          <Border Width="18"
                  Height="18"
                  CornerRadius="9"
                  Background="{DynamicResource ByhSurfaceBrush}"
                  BorderBrush="{DynamicResource ByhHairlineBrush}"
                  BorderThickness="1"
                  ClipToBounds="True">
            <Image Source="avares://SelectionAssistant.UI/Assets/Theme/ivory-jade-emblem.jpg"
                   Width="26"
                   Height="26"
                   Stretch="UniformToFill"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />
          </Border>
        </Border>

          </Grid>
        </Grid>
      </Border>
    </Border>


    <!-- Main work pane: the selected settings category remains independently scrollable. -->
    <Border Grid.Column="2"
            Grid.Row="0"
            Classes="MetallicFrame Thin">
      <Border Classes="MacroClip">
        <Grid RowDefinitions="Auto,*">
      <!-- The single SurfacePanel background is intentionally plain so the
           reference's clean, continuous card surface is not broken by texture. -->
      <Grid Grid.Row="0"
            ColumnDefinitions="*,Auto"
            RowDefinitions="Auto,Auto"
            ColumnSpacing="24"
            RowSpacing="12"
            Margin="28,16,26,12">
          <StackPanel Spacing="3">
            <TextBlock Text="WELCOME BACK" Classes="Kicker" />
            <StackPanel Orientation="Horizontal" Spacing="9">
              <TextBlock x:Name="PageTitleText"
                         Text="General"
                         Classes="DisplayTitle"
                         AutomationProperties.AutomationId="BYH.Settings.PageTitle"
                         FontSize="25" />
              <TextBlock Text="✦"
                         Foreground="{DynamicResource ByhGoldBrush}"
                         FontSize="18"
                         VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="PageSubtitleText"
                       Text="Hotkeys, capture behavior, and runtime status."
                       Classes="Secondary"
                       FontSize="10" />
          </StackPanel>
          <Border Grid.Column="1"
                  Classes="ThemePill"
                  VerticalAlignment="Center"
                  Padding="6,5">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Border Width="22" Height="22" CornerRadius="11" Background="{DynamicResource ByhGemGlowBrush}" Padding="2">
                <Border Width="18" Height="18" CornerRadius="9" ClipToBounds="True">
                  <Image Source="avares://SelectionAssistant.UI/Assets/Theme/ivory-jade-emblem.jpg"
                         Width="24"
                         Height="24"
                         Stretch="UniformToFill"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
                </Border>
              </Border>
              <TextBlock Text="IVORY JADE"
                         Classes="Accent"
                         FontSize="9"
                         FontWeight="SemiBold"
                         VerticalAlignment="Center" />
            </StackPanel>
          </Border>
          <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8">
            <Border Classes="HeroPill" Padding="8,4">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <Border Width="5" Height="5" CornerRadius="2.5"
                        Background="{DynamicResource ByhSuccessBrush}"
                        VerticalAlignment="Center" />
                <TextBlock Text="LOCAL FIRST" Classes="Accent" FontSize="8" FontWeight="SemiBold" />
              </StackPanel>
            </Border>
            <Border Classes="HeroPill" Padding="8,4">
              <TextBlock Text="INSTANT CAPTURE" Classes="Secondary" FontSize="8" FontWeight="SemiBold" />
            </Border>
            <Border Classes="HeroPill" Padding="8,4">
              <TextBlock Text="WINDOWS NATIVEAOT" Classes="Secondary" FontSize="8" FontWeight="SemiBold" />
            </Border>
          </StackPanel>
      </Grid>

      <ScrollViewer x:Name="SettingsContentScroll"
                    Grid.Row="1"
                    Padding="0"
                    AutomationProperties.AutomationId="BYH.Settings.ContentScroll"
                    VerticalScrollBarVisibility="Hidden"
                    HorizontalScrollBarVisibility="Disabled">
        <!-- Keep one shared bottom safe area inside the scroll extent.  The
             continuous-surface redesign removed the old 28 px ScrollViewer
             padding, which left most pages ending directly under the rounded
             clip even though their offset had technically reached 100%. -->
        <Grid Margin="0,0,0,24">

        <!-- General -->
        <StackPanel x:Name="GeneralSection" Spacing="0">
          <StackPanel Spacing="10" Margin="24,14,24,0">
            <TextBlock Text="Personal Greeting"
                       Classes="CardTitle"
                       FontSize="15"
                       FontWeight="SemiBold" />
            <Border Classes="InnerCard" Padding="12">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Spacing="4">
                  <TextBlock Text="Display name"
                             Classes="Secondary"
                             FontSize="10"
                             FontWeight="SemiBold" />
                  <TextBox x:Name="ProfileDisplayNameInput"
                           MaxLength="32"
                           FontSize="11"
                           PlaceholderText="Windows username"
                           AutomationProperties.AutomationId="BYH.Settings.Profile.DisplayName" />
                </StackPanel>
                <Button Grid.Column="1"
                        Content="Save"
                        Classes="Primary"
                        VerticalAlignment="Bottom"
                        Click="OnSaveUserProfileClick"
                        AutomationProperties.AutomationId="BYH.Settings.Profile.Save" />
              </Grid>
            </Border>
            <TextBlock x:Name="ProfileStatusText"
                       Classes="Muted"
                       FontSize="9"
                       Text="Used in the phone greeting."
                       AutomationProperties.AutomationId="BYH.Settings.Profile.Status" />
          </StackPanel>

          <Border Height="1" Background="{DynamicResource ByhHairlineBrush}" Margin="24,16" />

          <!-- Section: Ocean Eyes Trigger sits directly on the surface. -->
          <StackPanel Spacing="12" Margin="24,0,24,0">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Spacing="3">
                  <TextBlock Text="Ocean Eyes Trigger"
                             Classes="CardTitle"
                             FontSize="15"
                             FontWeight="SemiBold" />
                  <TextBlock Text="F Translate · J Explain · Z Summarize · R Prompt · C Copy · Enter Save · Esc Close"
                             Classes="Muted"
                             FontSize="10"
                             TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch x:Name="KeyboardShortcutToggle"
                              Grid.Column="1"
                              OnContent="On"
                              OffContent="Off"
                              IsChecked="True"
                              VerticalAlignment="Center" />
              </Grid>

              <Border Classes="InnerCard" Padding="12">
                <StackPanel Spacing="8">
                  <TextBlock Text="Hotkey"
                             Classes="Secondary"
                             FontSize="11"
                             FontWeight="SemiBold" />
                  <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,120" ColumnSpacing="10">
                    <CheckBox Grid.Column="0" x:Name="CtrlModifierCheckBox" Content="Ctrl" IsChecked="True" />
                    <CheckBox Grid.Column="1" x:Name="AltModifierCheckBox" Content="Alt" IsChecked="True" />
                    <CheckBox Grid.Column="2" x:Name="ShiftModifierCheckBox" Content="Shift" />
                    <CheckBox Grid.Column="3" x:Name="WinModifierCheckBox" Content="Win" />
                    <ComboBox Grid.Column="5" x:Name="ShortcutKeyComboBox" SelectedIndex="16" />
                  </Grid>
                </StackPanel>
              </Border>

              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Button Content="Save Hotkey"
                        Classes="Primary"
                        Click="OnSaveOceanEyesTriggerClick" />
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                  <TextBlock x:Name="ShortcutStatusText"
                             Text="Current: Ctrl+Alt+Q"
                             FontSize="11" />
                </StackPanel>
              </Grid>

              <Border BorderBrush="{DynamicResource ByhBorderSubtleBrush}"
                      BorderThickness="0,1,0,0"
                      Padding="0,12,0,0">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                  <StackPanel Spacing="3">
                    <TextBlock Text="Legacy Mouse Chord"
                               FontSize="11"
                               FontWeight="SemiBold" />
                    <TextBlock Text="May conflict with application context menus."
                               Classes="Muted"
                               FontSize="9"
                               TextWrapping="Wrap" />
                  </StackPanel>
                  <ToggleSwitch x:Name="MouseChordToggle"
                                Grid.Column="1"
                                OnContent="On"
                                OffContent="Off"
                                IsChecked="False"
                                VerticalAlignment="Center" />
                </Grid>
              </Border>
          </StackPanel>

          <Border Height="1" Background="{DynamicResource ByhHairlineBrush}" Margin="24,16" />

          <!-- Section: Toolbar Shortcuts sits directly on the surface. -->
          <StackPanel Spacing="12" Margin="24,0,24,0">
              <StackPanel Spacing="12">
                <TextBlock Text="Toolbar Shortcuts"
                           Classes="CardTitle"
                           FontSize="15"
                           FontWeight="SemiBold" />
                <Border Classes="InnerCard" Padding="12">
                  <Grid ColumnDefinitions="Auto,60,*" RowDefinitions="Auto,Auto"
                        RowSpacing="8" ColumnSpacing="12">
                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="Prompt"
                               Classes="Secondary"
                               FontSize="11"
                               VerticalAlignment="Center" />
                    <TextBox  Grid.Row="0" Grid.Column="1"
                              x:Name="PromptShortcutInput"
                              MaxLength="1"
                              FontSize="13"
                              HorizontalAlignment="Stretch"
                              PlaceholderText="None" />
                    <TextBlock Grid.Row="0" Grid.Column="2"
                               Text="Open prompt window"
                               Classes="Muted"
                               FontSize="10"
                               VerticalAlignment="Center" />

                    <TextBlock Grid.Row="1" Grid.Column="0"
                               Text="Copy"
                               Classes="Secondary"
                               FontSize="11"
                               VerticalAlignment="Center" />
                    <TextBox  Grid.Row="1" Grid.Column="1"
                              x:Name="CopyShortcutInput"
                              MaxLength="1"
                              FontSize="13"
                              HorizontalAlignment="Stretch"
                              PlaceholderText="None" />
                    <TextBlock Grid.Row="1" Grid.Column="2"
                               Text="Copy selected text"
                               Classes="Muted"
                               FontSize="10"
                               VerticalAlignment="Center" />
                  </Grid>
                </Border>

                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                  <Button Content="Save Shortcuts"
                          Classes="Primary"
                          Click="OnSaveToolbarShortcutsClick" />
                  <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock x:Name="ToolbarShortcutsStatusText"
                               Text="Current: Prompt R · Copy C"
                               FontSize="11" />
                  </StackPanel>
                </Grid>
              </StackPanel>
          </StackPanel>

          <Border Height="1" Background="{DynamicResource ByhHairlineBrush}" Margin="24,16" />

          <!-- Section: Ocean Eyes Capture sits directly on the surface. -->
          <StackPanel Spacing="12" Margin="24,0,24,0">
                <TextBlock Text="Ocean Eyes Capture"
                           Classes="CardTitle"
                           FontSize="15"
                           FontWeight="SemiBold" />
                <Border Classes="InnerCard" Padding="12">
                  <StackPanel Spacing="6">
                    <TextBlock Text="Save Location"
                               Classes="Secondary"
                               FontSize="11"
                               FontWeight="SemiBold" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                      <TextBox x:Name="OceanEyesSavePathTextBox"
                               Grid.Column="0"
                               PlaceholderText="%USERPROFILE%\Pictures\Ocean Eyes"
                               FontSize="11" />
                      <Button Grid.Column="1"
                              Content="Browse…"
                              Classes="Ghost"
                              Click="OnBrowseOceanEyesSavePathClick" />
                    </Grid>
                  </StackPanel>
                </Border>

                <!-- Phone-reference summary row: three compact toggle cards in
                     one row, like the "Projects / Tasks / Completed" blocks. -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                  <Border Classes="InnerCard" Padding="10">
                    <StackPanel Spacing="2">
                      <TextBlock Text="Auto-save" Classes="Muted" FontSize="9" FontWeight="SemiBold" />
                      <ToggleSwitch x:Name="OceanEyesAutoSaveToggle"
                                    OnContent="On"
                                    OffContent="Off"
                                    IsChecked="True"
                                    FontSize="10" />
                    </StackPanel>
                  </Border>
                  <Border Classes="InnerCard" Padding="10">
                    <StackPanel Spacing="2">
                      <TextBlock Text="Clipboard" Classes="Muted" FontSize="9" FontWeight="SemiBold" />
                      <ToggleSwitch x:Name="OceanEyesClipboardToggle"
                                    OnContent="On"
                                    OffContent="Off"
                                    IsChecked="True"
                                    FontSize="10" />
                    </StackPanel>
                  </Border>
                  <Border Classes="InnerCard" Padding="10">
                    <StackPanel Spacing="2">
                      <TextBlock Text="UIA Snap" Classes="Muted" FontSize="9" FontWeight="SemiBold" />
                      <ToggleSwitch x:Name="OceanEyesUiaAssistToggle"
                                    OnContent="On"
                                    OffContent="Off"
                                    IsChecked="True"
                                    FontSize="10" />
                    </StackPanel>
                  </Border>
                </Grid>

                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                  <Button Content="Save Capture Settings"
                          Classes="Primary"
                          Click="OnSaveOceanEyesCaptureClick" />
                  <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock x:Name="OceanEyesCaptureStatusText"
                               Text="Current: Default location"
                               FontSize="11" />
                  </StackPanel>
                </Grid>
              </StackPanel>

        </StackPanel>

        <!-- Translation providers -->
        <StackPanel x:Name="ProviderSection" IsVisible="False" Spacing="0">
          <StackPanel x:Name="EditFormBorder" Spacing="16" Margin="24,14,24,0">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Spacing="4">
                  <TextBlock Text="Provider Profiles"
                             Classes="CardTitle"
                             FontSize="15"
                             FontWeight="SemiBold" />
                </StackPanel>
                <Button Grid.Column="1"
                        Content="＋ Add Provider"
                        Click="OnAddProviderClick" />
              </Grid>

              <StackPanel Spacing="6">
                <TextBlock Text="Editing"
                           Classes="Secondary"
                           FontSize="10"
                           FontWeight="SemiBold" />
                <Border Classes="InnerCard" Padding="12">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <ComboBox x:Name="ProviderComboBox"
                              HorizontalAlignment="Stretch"
                              SelectionChanged="OnProviderSelectionChanged">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="views:ProviderOption">
                          <TextBlock Text="{Binding DisplayLabel}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock x:Name="EditingProviderNameHint"
                               Grid.Column="1"
                               Classes="Muted"
                               FontSize="10"
                               VerticalAlignment="Center" />
                  </Grid>
                </Border>
              </StackPanel>

              <Border Classes="InnerCard" Padding="14">
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="14" RowSpacing="12">
                  <StackPanel Grid.Row="0" Grid.Column="0" Spacing="6">
                    <TextBlock Text="Name" Classes="Muted" FontSize="10" />
                    <TextBox x:Name="NameInput" />
                  </StackPanel>
                  <StackPanel Grid.Row="0" Grid.Column="1" Spacing="6">
                    <TextBlock Text="Model" Classes="Muted" FontSize="10" />
                    <TextBox x:Name="ModelInput" />
                  </StackPanel>
                  <StackPanel Grid.Row="1" Grid.Column="0" Spacing="6">
                    <TextBlock Text="Base URL" Classes="Muted" FontSize="10" />
                    <TextBox x:Name="BaseUrlInput" />
                  </StackPanel>
                  <StackPanel Grid.Row="1" Grid.Column="1" Spacing="6">
                    <TextBlock Text="Chat Path" Classes="Muted" FontSize="10" />
                    <TextBox x:Name="ChatPathInput" PlaceholderText="chat/completions" />
                  </StackPanel>
                </Grid>
              </Border>

              <StackPanel Spacing="6">
                <TextBlock Text="System Prompt (blank uses the built-in translation prompt)"
                           Classes="Muted"
                           FontSize="10" />
                <Border Classes="InnerCard" Padding="12">
                  <TextBox x:Name="SystemPromptInput"
                           AcceptsReturn="True"
                           TextWrapping="Wrap"
                           Height="78" />
                </Border>
              </StackPanel>

              <Border Classes="InnerCard" Padding="14">
                <StackPanel Spacing="7">
                  <TextBlock Text="API Key"
                             FontSize="11"
                             FontWeight="SemiBold" />
                  <TextBlock Text="Encrypted with Windows DPAPI."
                             Classes="Muted"
                             FontSize="9" />
                  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <TextBox x:Name="ApiKeyInput"
                             PlaceholderText="sk-..."
                             PasswordChar="•" />
                    <Button Grid.Column="1" Content="Show" Click="OnToggleVisibilityClick" />
                    <Button Grid.Column="2" Content="Save Key" Classes="Primary" Click="OnSaveKeyClick" />
                  </Grid>
                  <TextBlock x:Name="ApiKeyStatusText"
                             Classes="Muted"
                             Text="Not set"
                             FontSize="10" />
                </StackPanel>
              </Border>

              <Grid ColumnDefinitions="150,*" ColumnSpacing="16">
                <StackPanel Spacing="6">
                  <TextBlock Text="Timeout (seconds)" Classes="Muted" FontSize="10" />
                  <Border Classes="InnerCard" Padding="6,4">
                    <NumericUpDown x:Name="TimeoutInput"
                                   Minimum="10"
                                   Maximum="300"
                                   Value="60" />
                  </Border>
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Spacing="8">
                  <Button Content="Delete"
                          Classes="DangerQuiet"
                          Click="OnDeleteProviderClick" />
                  <Button Content="Set Active" Click="OnSetActiveClick" />
                  <Button Content="Save Profile"
                          Classes="Primary"
                          Click="OnSaveProviderClick" />
                </StackPanel>
              </Grid>

            </StackPanel>
          </StackPanel>

        <!-- Prompt functions -->
        <StackPanel x:Name="FunctionsSection" IsVisible="False" Spacing="0">
          <StackPanel x:Name="PromptTemplatesCard" Spacing="16" Margin="24,14,24,0">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Spacing="3">
                  <TextBlock Text="Actions &amp; Prompts"
                             Classes="CardTitle"
                             FontSize="15"
                             FontWeight="SemiBold" />
                </StackPanel>
                <Button Grid.Column="1"
                        Content="＋ Add Action"
                        Classes="Primary"
                        Click="OnAddFunctionClick" />
              </Grid>

              <Border Classes="InnerCard" Padding="12">
                <ItemsControl x:Name="FunctionsList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="views:PromptFunctionRow">
                      <Grid ColumnDefinitions="*,Auto,Auto"
                            ColumnSpacing="10"
                            Margin="0,5">
                        <TextBlock Grid.Column="0"
                                   Text="{Binding Name}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="1"
                                Content="Edit"
                                Classes="Ghost"
                                Padding="10,4"
                                FontSize="10"
                                Command="{Binding EditCommand}" />
                        <Button Grid.Column="2"
                                Content="Delete"
                                Classes="DangerQuiet"
                                Padding="10,4"
                                FontSize="10"
                                Command="{Binding DeleteCommand}"
                                IsVisible="{Binding !IsBuiltIn}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>
            </StackPanel>
          </StackPanel>

        <!-- Vision OCR -->
        <StackPanel x:Name="VisionSection" IsVisible="False" Spacing="0">
          <StackPanel Spacing="16" Margin="24,14,24,0">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
              <StackPanel Spacing="4">
                <TextBlock Text="Vision Recognition"
                           Classes="CardTitle"
                           FontSize="15"
                           FontWeight="SemiBold" />
              </StackPanel>
              <ToggleSwitch x:Name="VisionEnabledToggle"
                            Grid.Column="1"
                            OnContent="On"
                            OffContent="Off"
                            IsChecked="True"
                            VerticalAlignment="Center" />
            </Grid>

            <Border Height="1" Background="{DynamicResource ByhHairlineBrush}" />

            <StackPanel Spacing="14">
              <StackPanel Spacing="6">
                <TextBlock Text="OCR Model"
                           Classes="CardTitle"
                           FontSize="13"
                           FontWeight="SemiBold" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                  <StackPanel Grid.Column="0" Spacing="6">
                    <TextBlock Text="Provider" Classes="Muted" FontSize="10" />
                    <Border Classes="InnerCard" Padding="6,4">
                      <ComboBox x:Name="VisionProviderComboBox"
                                HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                          <DataTemplate x:DataType="views:ProviderOption">
                            <TextBlock Text="{Binding DisplayLabel}" />
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                    </Border>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="6">
                    <TextBlock Text="Model" Classes="Muted" FontSize="10" />
                    <Border Classes="InnerCard" Padding="6,4">
                      <ComboBox x:Name="VisionModelComboBox"
                                HorizontalAlignment="Stretch"
                                IsEditable="True" />
                    </Border>
                  </StackPanel>
                </Grid>
                <StackPanel Spacing="6">
                  <TextBlock Text="Prompt" Classes="Muted" FontSize="10" />
                  <Border Classes="InnerCard" Padding="12">
                    <TextBox x:Name="VisionPromptInput"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Height="68"
                             PlaceholderText="Free OCR. (DeepSeek-OCR default)" />
                  </Border>
                </StackPanel>
              </StackPanel>

              <Border Height="1" Background="{DynamicResource ByhHairlineBrush}" />

              <StackPanel Spacing="16">
                <TextBlock Text="Recognition Strategy"
                           Classes="CardTitle"
                           FontSize="13"
                           FontWeight="SemiBold" />

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                  <StackPanel Spacing="3">
                    <TextBlock Text="UI Automation Prefill (Experimental)"
                               FontSize="11"
                               FontWeight="SemiBold" />
                  </StackPanel>
                  <ToggleSwitch x:Name="VisionUiaPrefillToggle"
                                Grid.Column="1"
                                OnContent="On"
                                OffContent="Off"
                                IsChecked="False"
                                VerticalAlignment="Center" />
                </Grid>

                <Border BorderBrush="{DynamicResource ByhBorderSubtleBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="0,14,0,0">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                    <StackPanel Spacing="3">
                      <TextBlock Text="Disable Model Thinking"
                                 FontSize="11"
                                 FontWeight="SemiBold" />
                      <TextBlock Text="Recommended for Qwen 3.x."
                                 Classes="Muted"
                                 FontSize="9"
                                 TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch x:Name="VisionDisableThinkingToggle"
                                  Grid.Column="1"
                                  OnContent="Disabled"
                                  OffContent="Allowed"
                                  IsChecked="False"
                                  VerticalAlignment="Center" />
                  </Grid>
                </Border>
              </StackPanel>
            </StackPanel>

          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Save Vision Settings"
                    Classes="Primary"
                    Click="OnSaveVisionClick" />
          </StackPanel>
        </StackPanel>
        </StackPanel>

        <!-- Launcher -->
        <StackPanel x:Name="LauncherSection" IsVisible="False" Spacing="0">
          <StackPanel Spacing="16" Margin="24,14,24,0">
              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                <StackPanel Spacing="3">
                  <TextBlock Text="Launcher"
                             Classes="CardTitle"
                             FontSize="15"
                             FontWeight="SemiBold" />
                  <TextBlock x:Name="LauncherScanStatusText"
                             Text=""
                             Classes="Secondary"
                             FontSize="9" />
                </StackPanel>
                <Button Grid.Column="1"
                        Content="🔍 扫描已安装应用"
                        Classes="Ghost"
                        Click="OnScanInstalledAppsClick" />
                <Button Grid.Column="2"
                        Content="＋ Add Launcher"
                        Classes="Primary"
                        Click="OnAddLauncherClick" />
              </Grid>

              <Border Classes="InnerCard" Padding="12">
                <ItemsControl x:Name="LauncherList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="views:LauncherEntryRow">
                      <Grid ColumnDefinitions="32,*,Auto,Auto,Auto,Auto"
                            ColumnSpacing="10"
                            Margin="0,5">
                        <Border Grid.Column="0"
                                Width="24" Height="24"
                                CornerRadius="4"
                                ClipToBounds="True">
                          <Image Source="{Binding Icon}"
                                 Width="24" Height="24" />
                        </Border>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Name}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="2"
                                Content="↑"
                                Classes="Ghost"
                                Padding="8,4"
                                FontSize="10"
                                Command="{Binding MoveUpCommand}" />
                        <Button Grid.Column="3"
                                Content="↓"
                                Classes="Ghost"
                                Padding="8,4"
                                FontSize="10"
                                Command="{Binding MoveDownCommand}" />
                        <Button Grid.Column="4"
                                Content="Edit"
                                Classes="Ghost"
                                Padding="10,4"
                                FontSize="10"
                                Command="{Binding EditCommand}" />
                        <Button Grid.Column="5"
                                Content="Delete"
                                Classes="DangerQuiet"
                                Padding="10,4"
                                FontSize="10"
                                Command="{Binding DeleteCommand}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>
            </StackPanel>

            <Border Height="1" Background="{DynamicResource ByhHairlineBrush}" />

            <!-- R32 Spotlight launcher-search shortcut card -->
            <StackPanel Spacing="14">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Spacing="3">
                  <TextBlock Text="Spotlight Hotkey"
                             Classes="CardTitle"
                             FontSize="15"
                             FontWeight="SemiBold" />
                </StackPanel>
                <ToggleSwitch x:Name="SpotlightKeyboardShortcutToggle"
                              Grid.Column="1"
                              OnContent="On"
                              OffContent="Off"
                              IsChecked="True"
                              VerticalAlignment="Center" />
              </Grid>

              <Border Classes="InnerCard" Padding="14">
                <StackPanel Spacing="10">
                  <TextBlock Text="Hotkey"
                             Classes="Secondary"
                             FontSize="11"
                             FontWeight="SemiBold" />
                  <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,120" ColumnSpacing="10">
                    <CheckBox Grid.Column="0" x:Name="SpotlightCtrlModifierCheckBox" Content="Ctrl" IsChecked="True" />
                    <CheckBox Grid.Column="1" x:Name="SpotlightAltModifierCheckBox" Content="Alt" IsChecked="True" />
                    <CheckBox Grid.Column="2" x:Name="SpotlightShiftModifierCheckBox" Content="Shift" />
                    <CheckBox Grid.Column="3" x:Name="SpotlightWinModifierCheckBox" Content="Win" />
                    <ComboBox Grid.Column="5" x:Name="SpotlightShortcutKeyComboBox" />
                  </Grid>
                </StackPanel>
              </Border>

              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Button Content="Save Hotkey"
                        Classes="Primary"
                        Click="OnSaveSpotlightTriggerClick" />
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                  <TextBlock x:Name="SpotlightShortcutStatusText"
                             Text="Current: Ctrl+Alt+Space"
                             FontSize="11" />
                </StackPanel>
              </Grid>
            </StackPanel>
          </StackPanel>


        <!-- Clipboard history follows the same continuous-surface rhythm as
             the five existing pages: one editorial header, then quiet inset
             groups instead of stacked standalone cards. -->
        <StackPanel x:Name="ClipboardHistorySection" IsVisible="False" Spacing="0">
          <StackPanel Spacing="16" Margin="24,14,24,0">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
              <StackPanel Spacing="3">
                <TextBlock Text="Clipboard History"
                           Classes="CardTitle"
                           FontSize="15"
                           FontWeight="SemiBold" />
                <TextBlock Text="Recall recent text without leaving the keyboard."
                           Classes="Muted"
                           FontSize="9" />
              </StackPanel>
              <ToggleSwitch x:Name="ClipboardHistoryEnabledToggle"
                            Grid.Column="1"
                            OnContent="Recording"
                            OffContent="Paused"
                            IsChecked="True"
                            VerticalAlignment="Center" />
            </Grid>

            <Border Classes="InnerCard" Padding="14">
              <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                  <TextBlock Text="Global Hotkey"
                             Classes="CardTitle"
                             FontSize="13"
                             FontWeight="SemiBold"
                             VerticalAlignment="Center" />
                  <ToggleSwitch x:Name="ClipboardHistoryKeyboardShortcutToggle"
                                Grid.Column="1"
                                OnContent="On"
                                OffContent="Off"
                                IsChecked="True"
                                VerticalAlignment="Center" />
                </Grid>

                <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,112" ColumnSpacing="10">
                  <CheckBox Grid.Column="0" x:Name="ClipboardHistoryCtrlModifierCheckBox" Content="Ctrl" IsChecked="True" />
                  <CheckBox Grid.Column="1" x:Name="ClipboardHistoryAltModifierCheckBox" Content="Alt" IsChecked="True" />
                  <CheckBox Grid.Column="2" x:Name="ClipboardHistoryShiftModifierCheckBox" Content="Shift" />
                  <CheckBox Grid.Column="3" x:Name="ClipboardHistoryWinModifierCheckBox" Content="Win" />
                  <ComboBox Grid.Column="5" x:Name="ClipboardHistoryShortcutKeyComboBox" />
                </Grid>

                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                  <Button Content="Save Hotkey"
                          Classes="Primary"
                          Click="OnSaveClipboardHistoryTriggerClick" />
                  <TextBlock x:Name="ClipboardHistoryShortcutStatusText"
                             Grid.Column="1"
                             Text="Current: Ctrl+Alt+V"
                             FontSize="11"
                             VerticalAlignment="Center" />
                </Grid>
              </StackPanel>
            </Border>

            <Border Height="1" Background="{DynamicResource ByhHairlineBrush}" />

            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
              <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="Behavior &amp; Privacy"
                           Classes="CardTitle"
                           FontSize="13"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="ClipboardHistorySettingsStatusText"
                           Text=""
                           FontSize="9" />
              </StackPanel>
              <Button Grid.Column="1"
                      Content="Save Settings"
                      Classes="Primary"
                      Click="OnSaveClipboardHistorySettingsClick" />
              <Button Grid.Column="2"
                      Content="Clear History"
                      Classes="Ghost"
                      Click="OnClearClipboardHistoryClick" />
            </Grid>

            <Grid ColumnDefinitions="0.9*,1.1*" ColumnSpacing="14">
              <Border Grid.Column="0" Classes="InnerCard" Padding="12">
                  <StackPanel Spacing="8">
                    <ToggleSwitch x:Name="ClipboardHistoryAutoPasteToggle"
                                  OnContent="Auto-paste"
                                  OffContent="Copy only"
                                  IsChecked="False" />
                    <ToggleSwitch x:Name="ClipboardHistoryMaskSensitiveToggle"
                                  OnContent="Mask sensitive"
                                  OffContent="Show plain"
                                  IsChecked="True" />
                    <Grid ColumnDefinitions="*,82" ColumnSpacing="10">
                      <TextBlock Text="Max entries"
                                 Classes="Secondary"
                                 FontSize="11"
                                 VerticalAlignment="Center" />
                      <TextBox Grid.Column="1"
                               x:Name="ClipboardHistoryMaxEntriesInput"
                               Text="1000"
                               FontSize="12" />
                    </Grid>
                    <ToggleSwitch x:Name="ClipboardHistoryCaptureImagesToggle"
                                  OnContent="Capture images"
                                  OffContent="Text only"
                                  IsChecked="True" />
                    <Grid ColumnDefinitions="*,82" ColumnSpacing="10">
                      <TextBlock Text="Max image entries"
                                 Classes="Secondary"
                                 FontSize="11"
                                 VerticalAlignment="Center" />
                      <TextBox Grid.Column="1"
                               x:Name="ClipboardHistoryMaxImageEntriesInput"
                               Text="50"
                               FontSize="12" />
                    </Grid>
                  </StackPanel>
              </Border>

              <Border Grid.Column="1" Classes="InnerCard" Padding="12">
                  <StackPanel Spacing="9">
                    <TextBlock Text="Excluded applications"
                               Classes="Secondary"
                               FontSize="11" />
                    <TextBox x:Name="ClipboardHistoryExcludeAppsInput"
                             Text="1password, keepass, authy, bitwarden"
                             FontSize="12"
                             MinHeight="54"
                             AcceptsReturn="True"
                             TextWrapping="Wrap" />
                  </StackPanel>
              </Border>
            </Grid>
          </StackPanel>
        </StackPanel>
        </Grid>
      </ScrollViewer>

        </Grid>
      </Border>
    </Border>

    <!-- Reference-style theme specimen: four calm editorial sections on one
         continuous square sheet. The rail remains decorative and read-only. -->
    <Border Grid.Column="0"
            Grid.RowSpan="2"
            Classes="FlatRail"
            CornerRadius="0">
      <Grid RowDefinitions="0.95*,1.55*,0.9*,1.0*">
        <Border Grid.Row="0"
                ClipToBounds="True"
                IsHitTestVisible="False">
          <!-- Reuse the ornament's lower gemstone as the concept focal point.
               The tall image is bottom-aligned inside this clipped first row,
               so the former lower-rail gem moves here without a new asset. -->
          <Image Source="avares://SelectionAssistant.UI/Assets/Theme/ivory-jade-ornament.jpg"
                 Width="170"
                 Height="340"
                 Margin="0,0,-32,-8"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Bottom"
                 Stretch="Fill"
                 Opacity="0.26" />
        </Border>
        <Border BorderBrush="{DynamicResource ByhRailRuleBrush}"
                BorderThickness="0,0,0,1"
                Padding="22,14,18,12">
          <StackPanel Spacing="7" VerticalAlignment="Center">
            <TextBlock Text="THEME CONCEPT" Classes="RailSectionTitle" />
            <TextBlock Text="Soft · Elegant · Natural · Quiet"
                       Classes="Secondary"
                       FontSize="8.5" />
            <TextBlock Text="A warm, creamy palette inspired by ivory, jade and polished gold. Soft structure keeps everyday tools calm and within reach."
                       Classes="RailBody"
                       MaxWidth="112"
                       HorizontalAlignment="Left"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border Grid.Row="1"
                BorderBrush="{DynamicResource ByhRailRuleBrush}"
                BorderThickness="0,0,0,1"
                Padding="22,16,18,14">
          <StackPanel Spacing="10" VerticalAlignment="Center">
            <TextBlock Text="COLOR PALETTE" Classes="RailSectionTitle" />
            <Grid ColumnDefinitions="48,*"
                  RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                  ColumnSpacing="9" RowSpacing="5">
              <Border Grid.Row="0" Width="40" Height="18" CornerRadius="6"
                      Background="#E8C89A" BorderBrush="#80D5A86A" BorderThickness="1" />
              <StackPanel Grid.Row="0" Grid.Column="1" Spacing="0" VerticalAlignment="Center">
                <TextBlock Text="Primary" FontSize="8.5" FontWeight="SemiBold" />
                <TextBlock Text="#E8C89A" Classes="Muted" FontSize="7" />
              </StackPanel>
              <Border Grid.Row="1" Width="40" Height="18" CornerRadius="6"
                      Background="#D5A86A" BorderBrush="#70B77934" BorderThickness="1" />
              <StackPanel Grid.Row="1" Grid.Column="1" Spacing="0" VerticalAlignment="Center">
                <TextBlock Text="Secondary" FontSize="8.5" FontWeight="SemiBold" />
                <TextBlock Text="#D5A86A" Classes="Muted" FontSize="7" />
              </StackPanel>
              <Border Grid.Row="2" Width="40" Height="18" CornerRadius="6"
                      Background="#8FAE5A" BorderBrush="#70667731" BorderThickness="1" />
              <StackPanel Grid.Row="2" Grid.Column="1" Spacing="0" VerticalAlignment="Center">
                <TextBlock Text="Accent" FontSize="8.5" FontWeight="SemiBold" />
                <TextBlock Text="#8FAE5A" Classes="Muted" FontSize="7" />
              </StackPanel>
              <Border Grid.Row="3" Width="40" Height="18" CornerRadius="6"
                      Background="#6B4B2A" BorderBrush="#70513822" BorderThickness="1" />
              <StackPanel Grid.Row="3" Grid.Column="1" Spacing="0" VerticalAlignment="Center">
                <TextBlock Text="Deep Brown" FontSize="8.5" FontWeight="SemiBold" />
                <TextBlock Text="#6B4B2A" Classes="Muted" FontSize="7" />
              </StackPanel>
              <Border Grid.Row="4" Width="40" Height="18" CornerRadius="6"
                      Background="#FFF7EE" BorderBrush="#90E8C89A" BorderThickness="1" />
              <StackPanel Grid.Row="4" Grid.Column="1" Spacing="0" VerticalAlignment="Center">
                <TextBlock Text="Cream" FontSize="8.5" FontWeight="SemiBold" />
                <TextBlock Text="#FFF7EE" Classes="Muted" FontSize="7" />
              </StackPanel>
              <Border Grid.Row="5" Width="40" Height="18" CornerRadius="6"
                      Background="#F6F1E6" BorderBrush="#90EAD8B8" BorderThickness="1" />
              <StackPanel Grid.Row="5" Grid.Column="1" Spacing="0" VerticalAlignment="Center">
                <TextBlock Text="Ivory" FontSize="8.5" FontWeight="SemiBold" />
                <TextBlock Text="#F6F1E6" Classes="Muted" FontSize="7" />
              </StackPanel>
              <Border Grid.Row="6" Width="40" Height="18" CornerRadius="6"
                      Background="#EAD8B8" BorderBrush="#90D5A86A" BorderThickness="1" />
              <StackPanel Grid.Row="6" Grid.Column="1" Spacing="0" VerticalAlignment="Center">
                <TextBlock Text="Border" FontSize="8.5" FontWeight="SemiBold" />
                <TextBlock Text="#EAD8B8" Classes="Muted" FontSize="7" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <Border Grid.Row="2"
                BorderBrush="{DynamicResource ByhRailRuleBrush}"
                BorderThickness="0,0,0,1"
                Padding="22,14,18,12">
          <StackPanel Spacing="8" VerticalAlignment="Center">
            <TextBlock Text="TYPOGRAPHY" Classes="RailSectionTitle" />
            <Grid ColumnDefinitions="42,*" ColumnSpacing="8">
              <TextBlock Text="Aa" FontFamily="Georgia" FontSize="24" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                <TextBlock Text="Heading Font" FontSize="8.5" FontWeight="SemiBold" />
                <TextBlock Text="Georgia" Classes="Muted" FontSize="7" />
              </StackPanel>
            </Grid>
            <Grid ColumnDefinitions="42,*" ColumnSpacing="8">
              <TextBlock Text="Aa" FontFamily="Segoe UI" FontSize="21" FontWeight="Light" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                <TextBlock Text="Body Font" FontSize="8.5" FontWeight="SemiBold" />
                <TextBlock Text="Segoe UI" Classes="Muted" FontSize="7" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <Border Grid.Row="3" Padding="22,14,18,14">
          <StackPanel Spacing="11" VerticalAlignment="Center">
            <TextBlock Text="ICON STYLE" Classes="RailSectionTitle" />
            <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="8">
              <Path Grid.Column="0" Classes="RailSampleIcon"
                    Data="M3,10 L12,3 L21,10 M5,9 L5,20 L19,20 L19,9 M9,20 L9,14 L15,14 L15,20" />
              <Path Grid.Column="1" Classes="RailSampleIcon"
                    Data="M12,3 L19,8 L16,18 L8,18 L5,8 Z M5,8 L19,8 M8,18 L12,8 L16,18" />
              <Path Grid.Column="2" Classes="RailSampleIcon"
                    Data="M12,21 C12,14 7,12 4,7 C10,7 12,10 12,14 M12,21 C12,13 17,10 20,5 C14,5 12,9 12,14" />
              <Path Grid.Column="3" Classes="RailSampleIcon"
                    Data="M3,6 L21,6 L21,18 L3,18 Z M3,7 L12,14 L21,7" />
              <Path Grid.Column="4" Classes="RailSampleIcon"
                    Data="M12,8 A4,4 0 1 0 12,16 A4,4 0 1 0 12,8 M12,2 L13,5 M12,19 L12,22 M2,12 L5,12 M19,12 L22,12 M5,5 L7,7 M17,17 L19,19 M19,5 L17,7 M7,17 L5,19" />
            </Grid>
            <TextBlock Text="Soft line icons with rounded corners and warm tones."
                       Classes="RailBody"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <!-- Portrait-led welcome card plus real runtime summary. The character art
         is the actual BYH app icon supplied by the user, not decorative mock data. -->
    <Border Grid.Column="3"
             Grid.Row="0"
             Classes="MetallicFrame Thin PhoneFrame"
            Margin="0,14,0,12"
            VerticalAlignment="Stretch"
            Background="{DynamicResource ByhPanelIvoryBrush}">
      <Border Classes="MacroClip PhoneClip"
              Background="{DynamicResource ByhPanelIvoryBrush}">
        <Grid RowDefinitions="122,*,Auto">
        <Image Grid.RowSpan="3"
               Source="avares://SelectionAssistant.UI/Assets/Theme/ivory-jade-ornament.jpg"
               Stretch="UniformToFill"
               Opacity="0.28"
               IsHitTestVisible="False" />

        <Border ClipToBounds="True">
          <Grid>
            <Border Width="144"
                    Height="144"
                    CornerRadius="72"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,-24,-22,0"
                    Background="{DynamicResource ByhGemGlowBrush}" />
            <StackPanel Margin="18,21,102,12" Spacing="3">
              <StackPanel Orientation="Horizontal" Spacing="3">
                <TextBlock Text="Hi!" Classes="Kicker" />
                <TextBlock x:Name="GreetingUserNameText"
                           Text="there"
                           Classes="Kicker"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="90"
                           AutomationProperties.AutomationId="BYH.Settings.Phone.GreetingName" />
              </StackPanel>
              <Image Source="avares://SelectionAssistant.UI/Assets/Theme/byh-wordmark.png"
                     Width="94"
                     Height="30"
                     Margin="-2,0,0,0"
                     HorizontalAlignment="Left"
                     Stretch="Uniform" />
              <TextBlock Text="Quiet, quick, within reach."
                         Classes="Secondary"
                         FontSize="8"
                         TextWrapping="Wrap" />
            </StackPanel>
            <Border Classes="GemPortrait"
                    Width="112"
                    Height="112"
                    Padding="3"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,6,3">
              <Image Source="avares://BYH/Assets/app-icon.png"
                     Stretch="Uniform" />
            </Border>
            <Border Classes="Badge"
                    Padding="7,3"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Margin="18,0,0,12">
              <TextBlock Text="IVORY JADE" Classes="Accent" FontSize="8" FontWeight="SemiBold" />
            </Border>
          </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Disabled">
          <Grid Margin="12,5,12,5">
            <!-- The handset owns a separate five-page information space. None
                 of these views change the central settings page or its scroll. -->
            <StackPanel x:Name="PhoneOverviewView"
                        Spacing="6">
              <TextBlock Text="Current setup"
                         Classes="DisplayTitle"
                         FontSize="14"
                         Margin="4,0,0,2"
                         AutomationProperties.AutomationId="BYH.Settings.PhoneView.Overview" />
              <Border Classes="PorcelainCard" Padding="10,8">
                <StackPanel Spacing="7">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                    <Border Classes="PhoneSummaryIcon Accent">
                      <Path Classes="MiniIcon"
                            Stroke="{DynamicResource ByhAccentHoverBrush}"
                            Data="M12,3 A9,9 0 1 0 12,21 A9,9 0 1 0 12,3 M3,12 L21,12 M12,3 C15,7 15,17 12,21 C9,17 9,7 12,3" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                      <TextBlock Text="TRANSLATION PROVIDER" Classes="Muted" FontSize="7" FontWeight="SemiBold" />
                      <TextBlock x:Name="SummaryProviderText" Text="Loading…" Classes="PhoneSummaryValue" />
                    </StackPanel>
                  </Grid>
                  <Border Classes="PhoneSummaryDivider" />
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                    <Border Classes="PhoneSummaryIcon Warning">
                      <Path Classes="MiniIcon"
                            Stroke="{DynamicResource ByhWarningBrush}"
                            Data="M3,7 L21,7 L21,17 L3,17 Z M7,10.5 L9,10.5 M11,10.5 L13,10.5 M15,10.5 L17,10.5 M7,14 L17,14" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                      <TextBlock Text="OCEAN EYES HOTKEY" Classes="Muted" FontSize="7" FontWeight="SemiBold" />
                      <TextBlock x:Name="SummaryShortcutText" Text="Loading…" Classes="PhoneSummaryValue" />
                    </StackPanel>
                  </Grid>
                  <Border Classes="PhoneSummaryDivider" />
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                    <Border Classes="PhoneSummaryIcon Success">
                      <Path Classes="MiniIcon"
                            Stroke="{DynamicResource ByhPrimaryBrush}"
                            Data="M2,12 C5.2,6.8 8.5,5 12,5 C15.5,5 18.8,6.8 22,12 C18.8,17.2 15.5,19 12,19 C8.5,19 5.2,17.2 2,12 Z M12,9 A3,3 0 1 0 12,15 A3,3 0 1 0 12,9" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                      <TextBlock Text="VISION OCR" Classes="Muted" FontSize="7" FontWeight="SemiBold" />
                      <TextBlock x:Name="SummaryVisionText" Text="Loading…" Classes="PhoneSummaryValue" />
                    </StackPanel>
                  </Grid>
                  <Border Classes="PhoneSummaryDivider" />
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                    <Border Classes="PhoneSummaryIcon Accent">
                      <Path Classes="MiniIcon"
                            Stroke="{DynamicResource ByhAccentBrush}"
                            Data="M5,3 L19,3 A2,2 0 0 1 21,5 L21,17 A2,2 0 0 1 19,19 L9,19 L5,22 Z M9,7 L17,7 M9,11 L17,11 M9,15 L14,15" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                      <TextBlock Text="CLIPBOARD HOTKEY" Classes="Muted" FontSize="7" FontWeight="SemiBold" />
                      <TextBlock x:Name="SummaryClipboardText" Text="Loading…" Classes="PhoneSummaryValue" />
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </Border>
            </StackPanel>

            <StackPanel x:Name="PhoneTranslationView"
                        IsVisible="False"
                        Spacing="8">
              <StackPanel Margin="4,0,0,1" Spacing="2">
                <TextBlock Text="Translation"
                           Classes="DisplayTitle"
                           FontSize="14"
                           AutomationProperties.AutomationId="BYH.Settings.PhoneView.Translation" />
                <TextBlock Text="Your active language service" Classes="Secondary" FontSize="8" />
              </StackPanel>
              <Border Classes="PorcelainCard" Padding="12">
                <StackPanel Spacing="10">
                  <Border Classes="PhoneFeatureEmblem Accent">
                    <Path Classes="MiniIcon" Stroke="{DynamicResource ByhAccentHoverBrush}"
                          Data="M12,3 A9,9 0 1 0 12,21 A9,9 0 1 0 12,3 M3,12 L21,12 M12,3 C15,7 15,17 12,21 C9,17 9,7 12,3" />
                  </Border>
                  <StackPanel Spacing="3">
                    <TextBlock Text="ACTIVE PROVIDER" Classes="Muted" FontSize="7" FontWeight="SemiBold" />
                    <TextBlock x:Name="PhoneProviderNameText" Text="Loading…" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="PhoneProviderModelText" Text="Loading…" Classes="Secondary" FontSize="9" TextWrapping="Wrap" />
                  </StackPanel>
                  <Border Classes="PhoneSummaryDivider" />
                  <TextBlock x:Name="PhoneProviderCountText" Text="Loading…" Classes="PhoneStatusPill" />
                </StackPanel>
              </Border>
              <TextBlock Text="Manage providers and keys from the Translation page."
                         Classes="Muted" FontSize="8" TextWrapping="Wrap" Margin="4,0" />
            </StackPanel>

            <StackPanel x:Name="PhoneVisionView"
                        IsVisible="False"
                        Spacing="8">
              <StackPanel Margin="4,0,0,1" Spacing="2">
                <TextBlock Text="Ocean Eyes"
                           Classes="DisplayTitle"
                           FontSize="14"
                           AutomationProperties.AutomationId="BYH.Settings.PhoneView.Vision" />
                <TextBlock x:Name="PhoneVisionStatusText" Text="Loading…" Classes="Secondary" FontSize="8" />
              </StackPanel>
              <Border Classes="PorcelainCard" Padding="12">
                <StackPanel Spacing="9">
                  <Border Classes="PhoneFeatureEmblem Success">
                    <Path Classes="MiniIcon" Stroke="{DynamicResource ByhPrimaryBrush}"
                          Data="M2,12 C5.2,6.8 8.5,5 12,5 C15.5,5 18.8,6.8 22,12 C18.8,17.2 15.5,19 12,19 C8.5,19 5.2,17.2 2,12 Z M12,9 A3,3 0 1 0 12,15 A3,3 0 1 0 12,9" />
                  </Border>
                  <StackPanel Spacing="3">
                    <TextBlock Text="OCR PROVIDER" Classes="Muted" FontSize="7" FontWeight="SemiBold" />
                    <TextBlock x:Name="PhoneVisionProviderText" Text="Loading…" FontSize="12" FontWeight="SemiBold" />
                    <TextBlock x:Name="PhoneVisionModelText" Text="Loading…" Classes="Secondary" FontSize="9" TextWrapping="Wrap" />
                  </StackPanel>
                  <Border Classes="PhoneSummaryDivider" />
                  <TextBlock x:Name="PhoneVisionAssistText" Text="Loading…" Classes="PhoneStatusPill" />
                </StackPanel>
              </Border>
            </StackPanel>

            <StackPanel x:Name="PhoneClipboardView"
                        IsVisible="False"
                        Spacing="8">
              <StackPanel Margin="4,0,0,1" Spacing="2">
                <TextBlock Text="Clipboard"
                           Classes="DisplayTitle"
                           FontSize="14"
                           AutomationProperties.AutomationId="BYH.Settings.PhoneView.Clipboard" />
                <TextBlock x:Name="PhoneClipboardStatusText" Text="Loading…" Classes="Secondary" FontSize="8" />
              </StackPanel>
              <Border Classes="PorcelainCard" Padding="12">
                <StackPanel Spacing="10">
                  <Border Classes="PhoneFeatureEmblem Accent">
                    <Path Classes="MiniIcon" Stroke="{DynamicResource ByhAccentBrush}"
                          Data="M5,3 L19,3 A2,2 0 0 1 21,5 L21,17 A2,2 0 0 1 19,19 L9,19 L5,22 Z M9,7 L17,7 M9,11 L17,11 M9,15 L14,15" />
                  </Border>
                  <StackPanel Spacing="3">
                    <TextBlock Text="HISTORY HOTKEY" Classes="Muted" FontSize="7" FontWeight="SemiBold" />
                    <TextBlock x:Name="PhoneClipboardHotkeyText" Text="Loading…" FontSize="12" FontWeight="SemiBold" />
                  </StackPanel>
                  <Border Classes="PhoneSummaryDivider" />
                  <StackPanel Spacing="3">
                    <TextBlock Text="LOCAL RETENTION" Classes="Muted" FontSize="7" FontWeight="SemiBold" />
                    <TextBlock x:Name="PhoneClipboardRetentionText" Text="Loading…" Classes="Secondary" FontSize="9" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </StackPanel>

            <StackPanel x:Name="PhoneLauncherView"
                        IsVisible="False"
                        Spacing="8">
              <StackPanel Margin="4,0,0,1" Spacing="2">
                <TextBlock Text="Launcher"
                           Classes="DisplayTitle"
                           FontSize="14"
                           AutomationProperties.AutomationId="BYH.Settings.PhoneView.Launcher" />
                <TextBlock Text="Quick destinations within reach" Classes="Secondary" FontSize="8" />
              </StackPanel>
              <Border Classes="PorcelainCard" Padding="12">
                <StackPanel Spacing="9">
                  <Border Classes="PhoneFeatureEmblem Warning">
                    <Path Classes="MiniIcon" Stroke="{DynamicResource ByhWarningBrush}"
                          Data="M12,8 A4,4 0 1 0 12,16 A4,4 0 1 0 12,8 M12,2 L13,5 M12,19 L12,22 M2,12 L5,12 M19,12 L22,12 M5,5 L7,7 M17,17 L19,19 M19,5 L17,7 M7,17 L5,19" />
                  </Border>
                  <StackPanel Spacing="3">
                    <TextBlock Text="SPOTLIGHT HOTKEY" Classes="Muted" FontSize="7" FontWeight="SemiBold" />
                    <TextBlock x:Name="PhoneLauncherHotkeyText" Text="Loading…" FontSize="12" FontWeight="SemiBold" />
                  </StackPanel>
                  <Border Classes="PhoneSummaryDivider" />
                  <TextBlock x:Name="PhoneLauncherCountText" Text="Loading…" Classes="PhoneStatusPill" />
                  <TextBlock x:Name="PhoneLauncherPreviewText" Text="Loading…" Classes="Secondary" FontSize="8" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>
        </ScrollViewer>

        <!-- Phone-style bottom dock. Its state and content are intentionally
             independent from the central settings navigation. -->
        <Border Grid.Row="2" Margin="10,4,10,10" Classes="PhoneDock">
          <Grid ColumnDefinitions="*,*,*,*,*" Height="42">
            <Button x:Name="PhoneGeneralButton"
                    Grid.Column="0"
                    Classes="PhoneDockButton Active"
                    ToolTip.Tip="Overview"
                    AutomationProperties.Name="Phone overview"
                    AutomationProperties.AutomationId="BYH.Settings.PhoneNav.General"
                    Click="OnShowPhoneOverviewClick">
              <Border Classes="PhoneDockItem">
                <Path Classes="PhoneDockIcon"
                      Data="M3,10 L12,3 L21,10 M5,9 L5,20 L19,20 L19,9 M9,20 L9,14 L15,14 L15,20" />
              </Border>
            </Button>
            <Button x:Name="PhoneProviderButton"
                    Grid.Column="1"
                    Classes="PhoneDockButton"
                    ToolTip.Tip="Translation"
                    AutomationProperties.Name="Phone translation summary"
                    AutomationProperties.AutomationId="BYH.Settings.PhoneNav.Translation"
                    Click="OnShowPhoneTranslationClick">
              <Border Classes="PhoneDockItem">
                <Path Classes="PhoneDockIcon"
                      Data="M12,3 L19,8 L16,18 L8,18 L5,8 Z M5,8 L19,8 M8,18 L12,8 L16,18" />
              </Border>
            </Button>
            <Button x:Name="PhoneVisionButton"
                    Grid.Column="2"
                    Classes="PhoneDockButton Center"
                    ToolTip.Tip="Vision"
                    AutomationProperties.Name="Phone vision summary"
                    AutomationProperties.AutomationId="BYH.Settings.PhoneNav.Vision"
                    Click="OnShowPhoneVisionClick">
              <Border Classes="PhoneDockItem Center">
                <Path Classes="PhoneDockIcon"
                      Data="M12,21 C12,14 7,12 4,7 C10,7 12,10 12,14 M12,21 C12,13 17,10 20,5 C14,5 12,9 12,14" />
              </Border>
            </Button>
            <Button x:Name="PhoneClipboardButton"
                    Grid.Column="3"
                    Classes="PhoneDockButton"
                    ToolTip.Tip="Clipboard"
                    AutomationProperties.Name="Phone clipboard summary"
                    AutomationProperties.AutomationId="BYH.Settings.PhoneNav.Clipboard"
                    Click="OnShowPhoneClipboardClick">
              <Border Classes="PhoneDockItem">
                <Path Classes="PhoneDockIcon"
                      Data="M3,6 L21,6 L21,18 L3,18 Z M3,7 L12,14 L21,7" />
              </Border>
            </Button>
            <Button x:Name="PhoneLauncherButton"
                    Grid.Column="4"
                    Classes="PhoneDockButton"
                    ToolTip.Tip="Launcher"
                    AutomationProperties.Name="Phone launcher summary"
                    AutomationProperties.AutomationId="BYH.Settings.PhoneNav.Launcher"
                    Click="OnShowPhoneLauncherClick">
              <Border Classes="PhoneDockItem">
                <Path Classes="PhoneDockIcon"
                      Data="M12,8 A4,4 0 1 0 12,16 A4,4 0 1 0 12,8 M12,2 L13,5 M12,19 L12,22 M2,12 L5,12 M19,12 L22,12 M5,5 L7,7 M17,17 L19,19 M19,5 L17,7 M7,17 L5,19" />
              </Border>
            </Button>
          </Grid>
        </Border>
        </Grid>
      </Border>
    </Border>

    <!-- Reference bottom strip: useful, real controls instead of invented metrics. -->
    <Border Grid.Column="1"
            Grid.ColumnSpan="2"
            Grid.Row="1"
            MinHeight="220"
            Classes="MetallicFrame Thin"
            Background="{DynamicResource ByhPanelIvoryBrush}">
      <Border Classes="MacroClip">
      <!-- R30 follow-up: the reference composition treats the lower area as one coherent
           pane: a quiet title band above grouped content.  Keep the three real
           modules, but remove the nested card-per-module rhythm. -->
      <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0"
                Background="Transparent"
                BorderThickness="0"
                Padding="18,10,16,4">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <StackPanel Spacing="2">
              <TextBlock Text="SYSTEM OVERVIEW"
                         FontFamily="Georgia"
                         FontSize="12" />
            </StackPanel>
            <TextBlock Grid.Column="1"
                       Text="BYH · LOCAL FIRST"
                       Classes="Kicker"
                       FontSize="8"
                       VerticalAlignment="Center" />
          </Grid>
        </Border>


        <Border Grid.Row="1"
                Background="Transparent"
                Padding="16,6,16,13">
          <Grid ColumnDefinitions="0.72*,1,0.8*,1,1.18*">
            <StackPanel Grid.Column="0" Spacing="9" Margin="2,0,14,0">
              <TextBlock Text="Runtime" FontFamily="Georgia" FontSize="13" />
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                <Border Width="28" Height="28" CornerRadius="14"
                        Background="{DynamicResource ByhSuccessSoftBrush}"
                        BorderBrush="#40D9C28A"
                        BorderThickness="1"
                        BoxShadow="0 2 6 0 #109F5E30"
                        VerticalAlignment="Center">
                  <Border Width="10" Height="10" CornerRadius="5"
                          Background="{DynamicResource ByhSuccessBrush}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                  <TextBlock Text="Background capture active" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" />
                </StackPanel>
              </Grid>
            </StackPanel>

            <Border Grid.Column="1"
                    Width="1"
                    Background="{DynamicResource ByhHairlineBrush}"
                    HorizontalAlignment="Center" />

            <StackPanel Grid.Column="2" Spacing="7" Margin="16,0">
              <TextBlock Text="Theme" FontFamily="Georgia" FontSize="13" />
              <TextBlock Text="Ivory Jade" FontSize="11" FontWeight="SemiBold" />
              <StackPanel Orientation="Horizontal" Spacing="5">
                <Border Width="16" Height="16" CornerRadius="5"
                        Background="{DynamicResource ByhSurfaceBrush}"
                        BorderBrush="{DynamicResource ByhBorderBrush}"
                        BorderThickness="1"
                        BoxShadow="0 1 3 0 #0D4A2B19" />
                <Border Width="16" Height="16" CornerRadius="5"
                        Background="{DynamicResource ByhPrimaryBrush}"
                        BoxShadow="0 1 3 0 #0D4A2B19" />
                <Border Width="16" Height="16" CornerRadius="5"
                        Background="{DynamicResource ByhGoldBrush}"
                        BoxShadow="0 1 3 0 #0D4A2B19" />
                <Border Width="16" Height="16" CornerRadius="5"
                        Background="{DynamicResource ByhAccentBrush}"
                        BoxShadow="0 1 3 0 #0D4A2B19" />
              </StackPanel>
            </StackPanel>

            <Border Grid.Column="3"
                    Width="1"
                    Background="{DynamicResource ByhHairlineBrush}"
                    HorizontalAlignment="Center" />

            <Grid Grid.Column="4"
                  RowDefinitions="Auto,*,Auto"
                  Margin="16,0,2,0">
              <TextBlock Text="Diagnostics" FontFamily="Georgia" FontSize="13" />
              <TextBlock x:Name="PolicyPathText"
                         Grid.Row="1"
                         Margin="0,7,0,5"
                         Classes="Muted"
                         FontSize="9"
                         TextWrapping="Wrap"
                         TextTrimming="CharacterEllipsis"
                         MaxLines="2" />
              <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                <Button Content="Config Folder" Click="OnOpenConfigDirectoryClick" />
                <Button Content="Log Folder" Click="OnOpenLogDirectoryClick" />
              </StackPanel>
            </Grid>
          </Grid>
        </Border>
      </Grid>
      </Border>
    </Border>

    <Border Grid.Column="3"
            Grid.Row="1"
            Classes="MetallicFrame Thin"
            Background="{DynamicResource ByhPanelIvoryBrush}">
      <Border Classes="MacroClip"
              Background="{DynamicResource ByhPanelIvoryBrush}"
              Padding="16">
        <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Spacing="3">
          <TextBlock Text="Window controls" FontFamily="Georgia" FontSize="13" />
          <TextBlock Text="v0.1 · Windows NativeAOT" Classes="Muted" FontSize="9" />
        </StackPanel>
        <TextBlock Grid.Row="1"
                   Text="Hide keeps BYH running. Exit stops all background services."
                   Classes="Secondary"
                   FontSize="9"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center" />
        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="8">
          <Button Content="Hide" Classes="Ghost" Click="OnHideClick" />
          <Button Grid.Column="1" Content="Exit BYH" Classes="DangerQuiet" Click="OnExitClick" />
        </Grid>
        </Grid>
      </Border>
    </Border>
  </Grid>
</Window>
