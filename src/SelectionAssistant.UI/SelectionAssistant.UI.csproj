<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\Theme\*.jpg" />
    <!-- R39: transparent wordmark PNG shown in the toolbar status slot. -->
    <AvaloniaResource Include="Assets\Theme\byh-wordmark.png" />
    <!-- R42: Ocean Eyes signature image shown in toolbar. -->
    <AvaloniaResource Include="Assets\Theme\ocean-eyes-signature.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- UI 依赖 Core (viewmodels/services 接口) 和 Infrastructure (日志) -->
    <ProjectReference Include="..\SelectionAssistant.Core\SelectionAssistant.Core.csproj" />
    <ProjectReference Include="..\SelectionAssistant.Infrastructure\SelectionAssistant.Infrastructure.csproj" />
  </ItemGroup>

</Project>
