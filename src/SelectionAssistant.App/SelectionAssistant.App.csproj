<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- App 是组合根:Windows 专用 TFM 以便引用 Platform.Windows -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app-icon.ico</ApplicationIcon>
    <!-- R36: 用户可见品牌统一为 BYH。AssemblyName 决定 exe 文件名和任务管理器
         进程名；与 Mutex 名、配置目录、HTTP UA、托盘 tooltip、所有窗口标题保持
         一致。namespace 仍为 SelectionAssistant.*（技术标识符，不改）。
         注意：avares:// URI 用 AssemblyName 解析，avares://SelectionAssistant.App/*
         必须改成 avares://BYH/*（见 App.axaml.cs 和 SettingsWindow.axaml）。 -->
    <AssemblyName>BYH</AssemblyName>
    <AssemblyTitle>BYH</AssemblyTitle>
    <Product>BYH</Product>
    <Company>By Your Hand</Company>
    <Description>BYH — By Your Hand. Context-aware selection assistant for Windows.</Description>
    <!-- Release identity. Version/FileVersion/AssemblyVersion follow the
         Major.Minor.Build convention. InformationalVersion is the full
         semver string shown in the exe Properties → Details tab.
         AssemblyVersion bumps only on breaking runtime/API changes;
         FileVersion bumps every release; Version drives NuGet if ever packed.
         Keep in sync with git tag v<major.minor.build> and CHANGELOG.md. -->
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <InformationalVersion>0.1.0</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Icon assets (embedded).
         - app-icon.ico: drives the exe icon (Windows Explorer / taskbar) AND
           the TrayIcon. Loaded at runtime as a full ICO container so Win32
           CreateIconFromResource preserves the alpha channel (a raw PNG passed
           to WindowIcon loses transparency in the tray on Windows).
         - app-icon.png: fallback / used where a bitmap is required. -->
    <AvaloniaResource Include="Assets\app-icon.ico" />
    <AvaloniaResource Include="Assets\app-icon.png" />
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishAot>true</PublishAot>
    <TrimMode>full</TrimMode>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <DynamicLoading>false</DynamicLoading>
    <!-- Keep native PDB symbols so WER minidumps from field crashes can be
         resolved to function names + offsets in WinDbg/cdb. The 2026-08-03
         0xc0000409 crash couldn't be symbolicated because symbols were stripped
         (StripSymbols=true). PDBs stay beside the exe (~10-20 MB) and do NOT
         bloat BYH.exe itself; the deliberate-delete target below is disabled
         while we diagnose the capture/clipboard crash family. Revert to
         StripSymbols=true once the crash is resolved. -->
    <StripSymbols>false</StripSymbols>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.0" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- 组合根:引用所有需要在此装配的项目 -->
    <ProjectReference Include="..\SelectionAssistant.Core\SelectionAssistant.Core.csproj" />
    <ProjectReference Include="..\SelectionAssistant.Platform.Windows\SelectionAssistant.Platform.Windows.csproj" />
    <ProjectReference Include="..\SelectionAssistant.Providers\SelectionAssistant.Providers.csproj" />
    <ProjectReference Include="..\SelectionAssistant.UI\SelectionAssistant.UI.csproj" />
    <ProjectReference Include="..\SelectionAssistant.Infrastructure\SelectionAssistant.Infrastructure.csproj" />
  </ItemGroup>

  <!-- Disabled while StripSymbols=false so native PDBs reach the publish dir
       for crash dump symbolication. Re-enable (flip condition to true) once the
       capture/clipboard crash family is resolved. -->
  <Target Name="RemovePublishedDebugSymbols"
          AfterTargets="Publish"
          Condition="'$(Configuration)' == 'Release' AND '$(StripSymbols)' == 'true'">
    <ItemGroup>
      <PublishedDebugSymbols Include="$(PublishDir)**\*.pdb" />
    </ItemGroup>
    <Delete Files="@(PublishedDebugSymbols)" />
  </Target>

</Project>
