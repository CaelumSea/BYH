<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Providers 依赖 Core 取翻译契约（TranslationRequest/TranslationDelta/异常类型） -->
    <ProjectReference Include="..\SelectionAssistant.Core\SelectionAssistant.Core.csproj" />
    <!-- 依赖平台抽象取 ISecretStore（解析 secret:// 密钥引用） -->
    <ProjectReference Include="..\SelectionAssistant.Platform.Abstractions\SelectionAssistant.Platform.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- SSE 帧解析器是 internal 实现细节，测试项目需要可见性来覆盖 7 种 case。 -->
    <InternalsVisibleTo Include="SelectionAssistant.Providers.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- R45 / REQ-010: 二维码识别。ZXing.Net 0.16.11（micjahn 维护，纯托管，MIT）。
         仅由 QrDecoder 静态封装内部调用 BarcodeReader<GameObject>；其他位置不直接
         使用，把 AOT/trim 风险集中在 QrDecoder 里管理。PossibleFormats 显式限定
         QR_CODE / DATA_MATRIX / CODE_128 以缩小反射检测面。-->
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
  </ItemGroup>

</Project>
