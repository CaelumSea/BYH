{
  "schemaVersion": 1,
  "rules": [
    {
      "match": {
        "processName": "ExampleTerminal.exe"
      },
      "detectionEnabled": true,
      "accessibilityCapture": true,
      "simulatedCopyMode": "CtrlInsertOnly",
      "clipboardStabilizationMs": 0,
      "preserveCapturedClipboard": false,
      "manualFallback": true
    },
    {
      "match": {
        "exactPath": "C:\\Apps\\ExampleReader.exe"
      },
      "detectionEnabled": true,
      "accessibilityCapture": true,
      "simulatedCopyMode": "CtrlInsertThenCtrlC",
      "clipboardStabilizationMs": 150,
      "preserveCapturedClipboard": false,
      "manualFallback": true
    }
  ]
}
